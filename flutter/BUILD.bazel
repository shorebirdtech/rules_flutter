load("@bazel_skylib//:bzl_library.bzl", "bzl_library")
load("@bazel_skylib//rules:common_settings.bzl", "bool_flag", "int_flag", "string_flag")
load("//flutter/private:flutter_material_icons.bzl", "flutter_material_icons")

# This is the target rule authors should put in their "toolchains"
# attribute in order to get a runtime for the correct platform.
# See https://docs.bazel.build/versions/main/toolchains.html#writing-rules-that-use-toolchains
toolchain_type(
    name = "toolchain_type",
    visibility = ["//visibility:public"],
)

# The Flutter tools whose output does not depend on the target platform
# (kernel compiles, shaders, asset bundles, web compiles, flutter_tester),
# for whichever execution platform an action is placed on. Its toolchains
# constrain only the execution platform, so an action that resolves it can run
# on any host the SDK ships for. Actions that use it run in the `portable`
# execution group; see flutter/private/exec_groups.bzl.
toolchain_type(
    name = "exec_tools_toolchain_type",
    visibility = ["//visibility:public"],
)

# Where a `flutter_tester_binary` runs: on a host of its target's OS and CPU,
# which is where `bazel run` or the action using it as a tool starts it. Only
# those two constraints, not the whole target platform: an app's platform may
# carry others (Apple's, say) that no execution platform has. Its toolchains,
# one per host Flutter ships flutter_tester for, are `@flutter_toolchains`'s.
toolchain_type(
    name = "run_host_toolchain_type",
    visibility = ["//visibility:public"],
)

# Flutter's profile mode: AOT like release, with the Dart VM service kept so
# DevTools can attach. Applies with `-c opt` only:
#
#   bazel build -c opt --@rules_flutter//flutter:profile //app
#
# `flutter_bazel run --profile` sets both.
bool_flag(
    name = "profile",
    build_setting_default = False,
    # It describes the app, and no build tool reads it: `scope = "target"`
    # keeps it out of the exec configuration, so setting it rebuilds no tool.
    scope = "target",
    visibility = ["//visibility:public"],
)

# Obfuscates the Dart names of every AOT-compiled app in the build, as
# `flutter build --obfuscate` does. It needs rules_dart's split debug info, whose
# `.symbols` file is what reads an obfuscated stack trace back:
#
#   bazel build -c opt --@rules_flutter//flutter:obfuscate \
#       --@rules_dart//dart:split_debug_info --output_groups=+debug_info //app
bool_flag(
    name = "obfuscate",
    build_setting_default = False,
    # It describes the app, and no build tool reads it.
    scope = "target",
    visibility = ["//visibility:public"],
)

# The Flutter SDK a build uses: the name of one `flutter.toolchain()` the root
# module declares. The default is the stock release, `flutter`.
#
#   bazel build --@rules_flutter//flutter:sdk=local //app
#
# A name that no `flutter.toolchain()` declares resolves no toolchain, and the
# build fails saying so.
string_flag(
    name = "sdk",
    build_setting_default = "flutter",
    # No `scope = "target"`: the SDK decides how every Flutter compile is
    # done, a build tool's in the exec configuration included.
    visibility = ["//visibility:public"],
)

# Lets a `flutter_android_app` link jars that define one class with different
# bytes, which otherwise fails its build. Two such jars can be harmless: two
# copies of one interface either of which works, or a class an app shadows on
# purpose. The app's deploy jar keeps the first copy of each class.
#
#   bazel build --@rules_flutter//flutter:allow_duplicate_classes //app
#
# The Android Gradle plugin's own check has the same switch,
# `android.enableDuplicateClassesCheck=false`.
bool_flag(
    name = "allow_duplicate_classes",
    build_setting_default = False,
    visibility = ["//visibility:public"],
)

# Lets an Android app package native libraries for arm64-v8a and x86_64 that
# are not aligned for 16 KB memory pages, which otherwise fails its build. An
# app for a fleet of 4 KB-page devices does not need them, and Android 16 runs
# a 4 KB-aligned app on a 16 KB device in page size compatibility mode, which
# the manifest's `android:pageSizeCompat` turns on. Google Play requires 16 KB
# support of apps that target Android 15 and later.
#
#   bazel build --@rules_flutter//flutter:allow_4kb_aligned_native_libraries //app
#
# The Android Gradle plugin does not fail on such a library; lint and the APK
# Analyzer warn.
bool_flag(
    name = "allow_4kb_aligned_native_libraries",
    build_setting_default = False,
    visibility = ["//visibility:public"],
)

# Release mode: `-c opt` without the profile flag. Used by select() in macros.
config_setting(
    name = "release",
    flag_values = {":profile": "false"},
    values = {"compilation_mode": "opt"},
    visibility = ["//visibility:public"],
)

# The release R8 configuration of `flutter_android_app` (the Android Gradle
# plugin's proguard-android-optimize.txt and Flutter's own rules), and the
# bundletool BundleConfig of its App Bundle (AGP's defaults: split by ABI,
# density and language; native libraries and dex stored uncompressed, the
# libraries 16 KB-aligned). Public for an `android_binary` or
# `android_application` assembled from the Tier 2 rules.
exports_files(
    [
        "android_bundle_config.pb.json",
        "android_proguard_rules.pro",
    ],
    visibility = ["//visibility:public"],
)

# The CPUs an optimizing dart2wasm (`-O1` and up) reserves, and the threads
# its Binaryen wasm-opt may use. Fewer lets more compiles run at once on a
# machine where CPUs are scarce; more makes a single compile finish sooner:
#   bazel build //app --@rules_flutter//flutter:wasm_opt_cpus=2
int_flag(
    name = "wasm_opt_cpus",
    build_setting_default = 4,
    # It describes the app, and no build tool reads it: `scope = "target"`
    # keeps it out of the exec configuration, so setting it rebuilds no tool.
    scope = "target",
    visibility = ["//visibility:public"],
)

# Apps that use Material widgets list this in their flutter_application(
# deps = [...]) to bundle MaterialIcons-Regular.otf into flutter_assets/.
# Backed by the active flutter toolchain — the file ships with every
# flutter_engine_artifacts repo, but the file label is platform-specific,
# so a small custom rule resolves it via ctx.toolchains[...] instead of
# requiring callers to select() on the host platform.
flutter_material_icons(
    name = "material_icons",
    visibility = ["//visibility:public"],
)

