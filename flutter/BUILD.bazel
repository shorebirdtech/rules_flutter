# Every .bzl in this package, for //tools/download_guard, which reads them for
# download calls that could fetch unverified bytes.
filegroup(
    name = "bzl_sources",
    srcs = glob(["*.bzl"]),
    visibility = ["//tools/download_guard:__pkg__"],
)
