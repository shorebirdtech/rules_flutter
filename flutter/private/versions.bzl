def require_supported_flutter_version(flutter_version):
    """Fails, naming the supported releases, unless the release is one.

    Args:
        flutter_version: A Flutter release tag the user asked for.
    """
    if flutter_version not in FLUTTER_VERSIONS:
        fail((
            "Flutter {v} is not supported. Supported versions: {supported}.\n" +
            "Set flutter.toolchain(flutter_version = ...) to one of them."
        ).format(v = flutter_version, supported = ", ".join(FLUTTER_VERSIONS.keys())))

def flutter_sdk_exact_pins(flutter_version):
    """Returns the exact pins of a release's SDK packages.

    Args:
        flutter_version: Flutter release tag (e.g. "3.47.9"). Must be a key of
            FLUTTER_VERSIONS.

    Returns:
        A dict of SDK package name to a dict of the packages it depends on
        exactly and the versions it pins.
    """
    pins = FLUTTER_SDK_EXACT_PINS.get(flutter_version)
    if pins == None:
        fail((
            "No exact SDK pins recorded for Flutter {v}.\n" +
            "Add its entry to FLUTTER_SDK_EXACT_PINS in " +
            "//flutter/private:versions.bzl; " +
            "`bazel run //tools/update_flutter_version -- {v}` prints it."
        ).format(v = flutter_version))
    return pins

def flutter_source_sha256(flutter_version):
    """Returns the recorded sha256 of a release's GitHub source tarball.

    Read through this accessor rather than off the struct directly, so that an
    entry added without a checksum fails at extension evaluation — naming the
    omission — instead of silently producing an unverified download. The check
    is eager because the source tarball is on the critical path of any build
    that uses a Flutter SDK package, which is nearly all of them.

    Args:
        flutter_version: Flutter release tag (e.g. "3.47.5"). Must be a key of
            FLUTTER_VERSIONS.

    Returns:
        The 64-character hex sha256 string.
    """
    meta = FLUTTER_VERSIONS[flutter_version]
    sha256 = getattr(meta, "source_sha256", "")
    if not sha256:
        fail((
            "No source tarball checksum recorded for Flutter {v}, so its " +
            "framework source cannot be fetched safely.\n" +
            "Add `source_sha256` to the {v} entry in " +
            "//flutter/private:versions.bzl. It is the sha256 of\n" +
            "  {url}\n" +
            "which `bazel run //tools/update_flutter_version -- {v}` prints " +
            "along with the rest of the entry."
        ).format(
            v = flutter_version,
            url = flutter_source_tarball_url(flutter_version),
        ))
    return sha256

