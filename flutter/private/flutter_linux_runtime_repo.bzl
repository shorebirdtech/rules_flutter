"""Repository rule for the Linux runtime integration tests run in, from pinned Debian packages.

One repository per architecture (`flutter_linux_runtime_amd64`,
`flutter_linux_runtime_arm64`), each holding the closure of packages
`//tools/update_linux_runtime` pinned: an X server of the test's own, GTK and
Mesa's software OpenGL for a desktop app, and what Chrome's headless shell links.
They are unpacked as they are into `root/`; nothing of the host's but its C and
C++ runtime is used, and the build checks that every file asks no more of those
than the oldest supported host has.

The `flutter` extension declares both. A repository is fetched only when
something references it: the Linux desktop and Chrome runners of
`//flutter/integration_test` select the host's own.
"""

load("//flutter/private:pinned.bzl", "pinned")

# Two places a pinned package is fetched from, tried in order, both checked
# against the one digest: Debian's own mirror network, quick but holding only a
# release's current packages, and snapshot.debian.org, which keeps every package
# it has seen at the address the pins name, and is slow to answer at times.
_DEBIAN = "https://deb.debian.org/debian/"
_SNAPSHOT = "https://snapshot.debian.org/archive/debian/{snapshot}/"

def debian_package_urls(snapshot, path):
    """The addresses of the package at `path` under the archive.

    Args:
        snapshot: The snapshot.debian.org timestamp the pins are of.
        path: The package's path under the archive (`pool/main/...`).

    Returns:
        The URLs to try, in order.
    """
    return [_DEBIAN + path, _SNAPSHOT.format(snapshot = snapshot) + path]

# The parts of the packages a test uses. The rest (documentation, translations,
# configuration for a system that boots, links to the host's `/etc`) stays out
# of the build.
_BUILD_TEMPLATE = """# Generated by flutter_linux_runtime_repo.bzl

load("@rules_flutter//flutter/private:flutter_linux_runtime.bzl", "flutter_linux_runtime")

flutter_linux_runtime(
    name = "runtime",
    srcs = glob([
        "root/usr/lib/{triple}/**",
        "root/usr/share/X11/xkb/**",
        "root/usr/share/X11/locale/**",
        "root/usr/share/fonts/**",
        "root/usr/share/glvnd/**",
        "root/usr/share/drirc.d/**",
        "root/usr/bin/xkbcomp",
    ]),
    fonts_conf = "fonts.conf",
    floor = {floor},
    triple = "{triple}",
    xkbcomp = "root/usr/bin/xkbcomp",
    xvfb = "root/usr/bin/Xvfb",
    visibility = ["//visibility:public"],
)
"""

# Fonts are the runtime's and no others, so a test draws text the same on
# every host. The cache is the runner's to place (`XDG_CACHE_HOME`).
_FONTS_CONF = """<?xml version="1.0"?>
<!DOCTYPE fontconfig SYSTEM "urn:fontconfig:fonts.dtd">
<fontconfig>
  <dir prefix="relative">root/usr/share/fonts</dir>
  <cachedir prefix="xdg">fontconfig</cachedir>
</fontconfig>
"""

_TRIPLES = {
    "amd64": "x86_64-linux-gnu",
    "arm64": "aarch64-linux-gnu",
}

def _flutter_linux_runtime_repo_impl(repository_ctx):
    arch = repository_ctx.attr.arch
    snapshot = repository_ctx.attr.snapshot
    debs = sorted(repository_ctx.attr.debs.items())

    # Fetched at once, unpacked one at a time.
    pending = []
    for path, sha256 in debs:
        name = path.rsplit("/", 1)[-1]
        pending.append(repository_ctx.download(
            url = debian_package_urls(snapshot, path),
            output = "debs/" + name,
            sha256 = pinned(name, sha256),
            block = False,
        ))
    for download in pending:
        download.wait()

    for path, _ in debs:
        name = path.rsplit("/", 1)[-1]
        unpacked = "debs/" + name[:-len(".deb")]
        repository_ctx.extract(archive = "debs/" + name, output = unpacked, type = "deb")
        data = [
            entry.basename
            for entry in repository_ctx.path(unpacked).readdir()
            if entry.basename.startswith("data.tar")
        ]
        if len(data) != 1:
            fail("{} has no single data archive, but {}".format(name, data))
        repository_ctx.extract(archive = unpacked + "/" + data[0], output = "root")
    repository_ctx.delete("debs")

    repository_ctx.file("fonts.conf", _FONTS_CONF)
    repository_ctx.file("BUILD.bazel", _BUILD_TEMPLATE.format(
        triple = _TRIPLES[arch],
        floor = repr(repository_ctx.attr.floor),
    ))

    # Pinned downloads and files written from the attributes alone, so Bazel
    # keeps one copy in its repository contents cache for every output base.
    return repository_ctx.repo_metadata(reproducible = True)

flutter_linux_runtime_repo = repository_rule(
    _flutter_linux_runtime_repo_impl,
    doc = "Downloads and unpacks the pinned Debian packages of the Linux integration-test runtime for one architecture.",
    attrs = {
        "arch": attr.string(
            doc = "Debian's name for the architecture.",
            mandatory = True,
            values = ["amd64", "arm64"],
        ),
        "snapshot": attr.string(
            doc = "The snapshot.debian.org timestamp the packages are pinned at.",
            mandatory = True,
        ),
        "debs": attr.string_dict(
            doc = "Each package's path under the archive, to the sha256 of the `.deb`.",
            mandatory = True,
        ),
        "floor": attr.string_dict(
            doc = "The newest symbol version of each host library a file may ask for.",
            mandatory = True,
        ),
    },
)
