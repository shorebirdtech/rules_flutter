load("@rules_dart//dart:defs.bzl", "dart_binary", "dart_library", "dart_package_metadata", "dart_test")
load("//flutter/private:flutter_sdk_record.bzl", "flutter_sdk_record")
load(":sdk_record_mode.bzl", "record_in_mode")

# The scripts build actions run directly, handed to those actions as raw
# sources — a rule's `_tool` attr resolves the file label and passes its path to
# `dart run`, so none of them is a Bazel target of its own.
#
# That leaves them owned by no target of their own, and the analysis aspect
# checks only files a target owns. Their analysis rides on their unit tests
# below instead: each one is a `srcs` entry of the `dart_test` that covers it,
# and a `dart_test`'s own files are `[main] + srcs`, so checking the test
# checks the script. **A script exported here without a test below is checked
# by nothing** — the test is what carries it, not this list.
exports_files(
    [
        "android_aar.dart",
        "android_maven_repo.dart",
        "android_release.dart",
        "apple_frameworks.dart",
        "apple_xcframeworks_codesign.dart",
        "assemble_directory.dart",
        "generate_asset_manifest.dart",
        "bundle_app.dart",
        "check_android_classes.dart",
        "check_apple_version_keys.dart",
        "collect_notices.dart",
        "compile_shader.dart",
        "libraries_spec.dart",
        "linux_runtime.dart",
        "maven_repo.dart",
        "merge_android_manifests.dart",
        "merge_plists.dart",
        "plist_binary.dart",
        "sdk_check.dart",
        "strip_native_libs.dart",
        "swiftpm_app_settings.dart",
        "validate_android_elf.dart",
        "web_template.dart",
        "zip_archive.dart",
        # Exported for its unit test's `srcs`, not for a build action: unlike
        # its neighbours this one is a `dart_binary` main (below), and rules
        # reach it through that target rather than by file label.
        "flutter_test_runner.dart",
    ],
    visibility = ["//flutter:__subpackages__"],
)

# The `main` of the `dart_binary` that `flutter_android_maven_artifacts`
# declares in the user's package, so it is visible to every package.
exports_files(
    ["maven_artifacts.dart"],
    visibility = ["//visibility:public"],
)

# The program behind `flutter_android_release`: signs an App Bundle with the
# user's key at run time, so the key never enters the build graph.
dart_binary(
    name = "android_release",
    compile_mode = "exe",
    main = "android_release.dart",
    visibility = ["//flutter:__subpackages__"],
    deps = ["@rules_dart//dart/runfiles"],
)

# The program behind `bazel run` of `flutter_ios_xcframeworks` and
# `flutter_macos_xcframeworks`: writes the build's xcframeworks where
# `flutter build ios-framework` writes them.
dart_binary(
    name = "apple_xcframeworks_export",
    srcs = [
        "apple_frameworks.dart",
        "assemble_directory.dart",
    ],
    compile_mode = "exe",
    main = "apple_xcframeworks_export.dart",

# The program behind `bazel run` of `flutter_android_aar`: writes the module's
# Maven repository where `flutter build aar` does and prints the host's steps.
dart_binary(
    name = "android_aar_install",
    srcs = ["maven_repo.dart"],
    compile_mode = "exe",
    main = "android_aar_install.dart",
    visibility = ["//flutter:__subpackages__"],
    deps = ["@rules_dart//dart/runfiles"],
)

dart_test(
    name = "apple_xcframeworks_codesign_test",
    srcs = [
        "apple_frameworks.dart",
        "apple_xcframeworks_codesign.dart",
        "assemble_directory.dart",
    ],
    main = "test/apple_xcframeworks_codesign_test.dart",
    deps = ["@dev_tool_deps//:test"],
)

dart_test(
    name = "apple_xcframeworks_export_test",
    srcs = [
        "apple_frameworks.dart",
        "apple_xcframeworks_export.dart",
        "assemble_directory.dart",
    ],
    main = "test/apple_xcframeworks_export_test.dart",
    deps = [
        "@dev_tool_deps//:test",
        "@rules_dart//dart/runfiles",
    ],
)

# The program behind `bazel run` of `flutter_android_app`'s App Bundle:
# installs it on a device with bundletool.
dart_binary(
    name = "android_bundle_install",
    compile_mode = "exe",
    main = "android_bundle_install.dart",
    visibility = ["//flutter:__subpackages__"],
    deps = ["@rules_dart//dart/runfiles"],
)

# The pub runner: `dart compile exe` builds it from these two files, which
# import only the Dart libraries, so that it depends on no pub repository (a
# lock conflict there must not stop the command that fixes the lock). They are
# files, not a library, because the runner must not depend on a Dart target; the
# test below owns them for analysis and formatting.
exports_files(
    [
        "pub.dart",
        "pub_runfiles.dart",
        "swift_resolve.dart",
    ],
    visibility = ["//flutter:__subpackages__"],
)

dart_test(
    name = "pub_runfiles_test",
    srcs = [
        "pub.dart",
        "pub_runfiles.dart",
        "swift_resolve.dart",
    ],
    main = "test/pub_runfiles_test.dart",
    deps = ["@dev_tool_deps//:test"],
)

# `assemble_directory.dart` as a program, for the test fixtures that build a
# directory (the production actions run the script with the toolchain's `dart`).
dart_binary(
    name = "assemble_directory",
    compile_mode = "exe",
    main = "assemble_directory.dart",
    visibility = ["//flutter/tests:__pkg__"],
)

dart_package_metadata(
    name = "pubspec-metadata",
    package_name = "flutter_rule_tools",
)

# The host half of `package:test`'s `RemoteListener` protocol, and Bazel's test
# protocol (`--test_filter`, sharding, JUnit) it applies. `flutter_test_runner`
# carries it over a WebSocket; the integration test runner carries it over an
# app's VM service. A library rather than a `srcs` entry because the two live in
# different packages. It is a Dart package of its own, `flutter_rule_tools`,
# which this directory's pubspec names, so `lib/` is where its files must sit.
dart_library(
    name = "remote_suite",
    srcs = glob(["lib/**/*.dart"]),
    package = ":pubspec-metadata",
    # Public because `flutter_pub.from_lock(resolve = ...)` in MODULE.bazel maps
    # the dev tool's lock entry for this package to it, and the hub's repository
    # forwards to it from outside this repository's packages.
    visibility = ["//visibility:public"],
    deps = [
        "@dev_tool_deps//:boolean_selector",
        "@dev_tool_deps//:test_api",
        "@dev_tool_deps//:test_core",
    ],
)

dart_binary(
    name = "flutter_test_runner",
    compile_mode = "exe",
    main = "flutter_test_runner.dart",
    visibility = ["//flutter:__subpackages__"],
    deps = [
        ":remote_suite",
        "@rules_dart//dart/kernel_list",
        "@rules_dart//dart/runfiles",
    ],
)

# Unit tests for the tools above.
#
# Each test imports its tool by relative path (`../merge_plists.dart`), so the
# tool is a `srcs` entry rather than a dep: these tools are plain scripts with
# no pub dependencies, deliberately, since a build action runs them straight
# from the toolchain's Dart. The exceptions are the runner, which is a compiled
# binary and takes `:remote_suite` as a dep, and `:remote_suite`'s own tests,
# which have no tool file at all (they import the package).
#
# A new test file needs an entry here, or nothing runs it.
#
# `@dev_tool_deps//:test` is `package:test` from the one pub hub this workspace
# declares (MODULE.bazel `flutter_pub.from_lock(name = "dev_tool_deps")`),
# resolved with every other tool of this repository by the root pub workspace.
#
# The value is the tool (or a list of it and the scripts it imports) plus what
# it imports beyond `package:test`.
_UNIT_TESTS = {
    "assemble_directory_test": (
        "assemble_directory.dart",
        ["@dev_tool_deps//:path"],
    ),
    "android_bundle_install_test": (
        "android_bundle_install.dart",
        ["@rules_dart//dart/runfiles"],
    ),
    "android_aar_test": (
        [
            "android_aar.dart",
            "zip_archive.dart",
        ],
        [],
    ),
    "android_aar_install_test": (
        [
            "android_aar_install.dart",
            "maven_repo.dart",
        ],
        ["@rules_dart//dart/runfiles"],
    ),
    "android_maven_repo_test": (
        [
            "android_maven_repo.dart",
            "maven_repo.dart",
        ],
        [],
    ),
    "android_release_test": (
        "android_release.dart",
        ["@rules_dart//dart/runfiles"],
    ),
    "validate_android_elf_test": ("validate_android_elf.dart", []),
    "check_android_classes_test": ("check_android_classes.dart", []),
    "maven_artifacts_test": (
        "maven_artifacts.dart",
        ["@rules_dart//dart/runfiles"],
    ),
    "bundle_app_test": ("bundle_app.dart", []),
    "collect_notices_test": ("collect_notices.dart", []),
    "libraries_spec_test": ("libraries_spec.dart", []),
    "linux_runtime_test": ("linux_runtime.dart", []),
    "generate_asset_manifest_test": ("generate_asset_manifest.dart", []),
    "merge_android_manifests_test": ("merge_android_manifests.dart", []),
    "sdk_check_test": ("sdk_check.dart", []),
    "strip_native_libs_test": ("strip_native_libs.dart", []),
    "swiftpm_app_settings_test": ("swiftpm_app_settings.dart", []),
    "web_template_test": ("web_template.dart", []),
    "flutter_test_runner_test": (
        "flutter_test_runner.dart",
        [
            ":remote_suite",
            "@rules_dart//dart/kernel_list",
            "@rules_dart//dart/runfiles",
        ],
    ),
    "bazel_test_protocol_test": (
        None,
        [":remote_suite"],
    ),
    "suite_annotations_test": (
        None,
        [":remote_suite"],
    ),
    "remote_suite_test": (
        None,
        [
            ":remote_suite",
            "@dev_tool_deps//:fake_async",
        ],
    ),
}

[dart_test(
    name = name,
    srcs = (tool if type(tool) == "list" else [tool]) if tool else [],
    main = "test/%s.dart" % name,
    deps = ["@dev_tool_deps//:test"] + extra_deps,
) for name, (tool, extra_deps) in _UNIT_TESTS.items()]

