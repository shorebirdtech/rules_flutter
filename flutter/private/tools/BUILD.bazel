# Stand-in for the engine's `font-subset`, which the tree-shaking tests below
# make `generate_asset_manifest.dart` run. A compiled executable, since the tool
# starts it as a program and a Dart script cannot be started.
dart_binary(
    name = "fake_font_subset",
    testonly = True,
    srcs = [],
    compile_mode = "exe",
    main = "test/fake_font_subset.dart",
)

# The tool's icon tree shaking, run as the build action runs it (a `dart`
# process over a config file) against the stand-ins for `const_finder` and
# `font-subset`.
[dart_test(
    name = "generate_asset_manifest_tree_shaking" + suffix + "_test",
    srcs = ["test/tree_shaking_harness.dart"],
    data = [
        "generate_asset_manifest.dart",
        ":fake_font_subset",
    ],
    main = "test/generate_asset_manifest_tree_shaking%s_test.dart" % suffix,
    deps = [
        "@dev_tool_deps//:test",
        "@rules_dart//dart/runfiles",
    ],
) for suffix in [""]]

# The check over the stock artifacts, in each build mode: the pinned release
# passes it, with the hash its Dart has. The host's own engine, and the iOS and
# Android engines a Mac cross-compiles for (macOS only: the engine slice of the
# host is the host's own, and the cross toolchains of a Mac are the ones built
# for these platforms).
_STOCK_RECORD_PLATFORMS = {
    "host": "",
    "ios": "//flutter/platforms:ios_arm64",
    "android_arm64": "@rules_android//:arm64-v8a",
    "android_x64": "@rules_android//:x86_64",
}

_STOCK_RECORD_MODES = [
    "debug",
    "profile",
    "release",
]

[flutter_sdk_record(
    name = "stock_record_%s_%s_check" % (platform, mode) if platform != "host" else "stock_record_%s_check" % mode,
    always = True,
    mode = mode,
    tags = ["manual"],
) for platform in _STOCK_RECORD_PLATFORMS for mode in _STOCK_RECORD_MODES]

[record_in_mode(
    name = "stock_record_%s_%s" % (platform, mode) if platform != "host" else "stock_record_%s" % mode,
    mode = mode,
    platform = _STOCK_RECORD_PLATFORMS[platform],
    record = ":stock_record_%s_%s_check" % (platform, mode) if platform != "host" else ":stock_record_%s_check" % mode,
    tags = ["manual"],
) for platform in _STOCK_RECORD_PLATFORMS for mode in _STOCK_RECORD_MODES]

dart_test(
    name = "sdk_record_stock_test",
    data = [
        ":stock_record_%s" % mode if platform == "host" else ":stock_record_%s_%s" % (platform, mode)
        for platform in _STOCK_RECORD_PLATFORMS
        for mode in _STOCK_RECORD_MODES
    ],
    main = "test/sdk_record_stock_test.dart",
    target_compatible_with = ["@platforms//os:macos"],
    deps = [
        "@dev_tool_deps//:test",
        "@rules_dart//dart/runfiles",
    ],
)
