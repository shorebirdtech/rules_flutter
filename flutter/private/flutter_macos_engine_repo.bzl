"""Repository rule for the macOS Flutter engine face.

Creates a lightweight repo with one target per mode (`engine_release_library`,
`engine_debug_library`, `engine_profile_library`) and `engine_library`, which
is the engine of the build mode (`-c dbg`, `-c opt` with `//flutter:profile`,
`-c opt`): the FlutterMacOS.framework of the engine source's `macos/<mode>`
slice. The labels users and rules_flutter name stay `@flutter_macos_engine//:...`
whichever engine source a build uses.
"""

def _flutter_macos_engine_repo_impl(repository_ctx):
    repository_ctx.file("BUILD.bazel", _BUILD_TEMPLATE.format(
        engine = "@{}_stock_engine".format(repository_ctx.attr.user_repository_name),
    ))

_BUILD_TEMPLATE = """# Generated by flutter_macos_engine_repo.bzl
# The FlutterMacOS.framework engine of the engine source's macOS slices.

# The engine of the build mode.
alias(
    name = "engine_library",
    actual = select({{
        "@rules_flutter//flutter/private:dbg": ":engine_debug_library",
        "@rules_flutter//flutter/private:profile": ":engine_profile_library",
        "//conditions:default": ":engine_release_library",
    }}),
    visibility = ["//visibility:public"],
)

alias(
    name = "engine_release_library",
    actual = "{engine}//macos/release:engine",
    visibility = ["//visibility:public"],
)

alias(
    name = "engine_debug_library",
    actual = "{engine}//macos/debug:engine",
    visibility = ["//visibility:public"],
)

alias(
    name = "engine_profile_library",
    actual = "{engine}//macos/profile:engine",
    visibility = ["//visibility:public"],
)
"""

flutter_macos_engine_repo = repository_rule(
    _flutter_macos_engine_repo_impl,
    doc = "Creates the face repo for the macOS Flutter engine (FlutterMacOS.framework).",
    attrs = {
        "user_repository_name": attr.string(
            doc = "Base name for Flutter repos (e.g. 'flutter').",
            mandatory = True,
        ),
    },
)
