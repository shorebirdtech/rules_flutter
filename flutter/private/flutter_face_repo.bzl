"""A repository of aliases that follow the SDK a build selects.

rules_flutter's own code, and users, name a few repositories by a fixed name
(`@flutter_macos_engine`, `@flutter_dev_root`, `@flutter_gen_l10n`). Each is a
face: targets that are aliases chosen by `--@rules_flutter//flutter:sdk`, into
the repository of the SDK's own source. A name the flag does not declare
fails at the first `select()`, listing the declared names.
"""

def face_build_content(sdks, targets, extra = ""):
    """The BUILD file of a face.

    Args:
        sdks: A dict from each declared SDK to the label prefix of its source
            (`@repo`).
        targets: A dict from a target of the face to its label in a source, in
            which `{prefix}` stands for the SDK's label prefix.
        extra: BUILD text added after the aliases.

    Returns:
        The BUILD.bazel text.
    """
    content = "# Generated by flutter_face_repo.bzl\n"
    declared = ", ".join(sorted(sdks.keys()))
    for name, template in sorted(targets.items()):
        branches = "".join([
            '            "@flutter_toolchains//:sdk_{sdk}": "{label}",\n'.format(
                sdk = sdk,
                label = template.format(prefix = prefix),
            )
            for sdk, prefix in sorted(sdks.items())
        ])
        content += """
alias(
    name = "{name}",
    actual = select(
        {{
{branches}        }},
        no_match_error = "No Flutter SDK is declared for --@rules_flutter//flutter:sdk. Declared: {declared}.",
    ),
    visibility = ["//visibility:public"],
)
""".format(name = name, branches = branches, declared = declared)
    return content + extra

def _flutter_face_repo_impl(repository_ctx):
    repository_ctx.file("BUILD.bazel", face_build_content(
        repository_ctx.attr.sdks,
        repository_ctx.attr.targets,
        repository_ctx.attr.extra,
    ))

flutter_face_repo = repository_rule(
    _flutter_face_repo_impl,
    doc = "A repository of aliases that follow the selected Flutter SDK.",
    attrs = {
        "sdks": attr.string_dict(doc = "Each declared SDK to the label prefix of its source repository.", mandatory = True),
        "targets": attr.string_dict(doc = "Each target to its label in a source; `{prefix}` is the SDK's prefix.", mandatory = True),
        "extra": attr.string(doc = "BUILD text added after the aliases."),
    },
)

# The macOS engine of the build mode. `engine_library` is what rules_apple
# imports as FlutterMacOS.framework, so it follows the mode itself.
MACOS_ENGINE_TARGETS = {
    "engine_debug_library": "{prefix}//macos/debug:engine",
    "engine_profile_library": "{prefix}//macos/profile:engine",
    "engine_release_library": "{prefix}//macos/release:engine",
    "xcframework_debug": "{prefix}//macos/debug:xcframework",
    "xcframework_profile": "{prefix}//macos/profile:xcframework",
    "xcframework_release": "{prefix}//macos/release:xcframework",
}

MACOS_ENGINE_EXTRA = """
# The engine of the build mode.
alias(
    name = "engine_library",
    actual = select({
        "@rules_flutter//flutter/private:dbg": ":engine_debug_library",
        "@rules_flutter//flutter/private:profile": ":engine_profile_library",
        "//conditions:default": ":engine_release_library",
    }),
    visibility = ["//visibility:public"],
)

# Flutter's signed FlutterMacOS.xcframework of the build mode, for macOS
# add-to-app.
alias(
    name = "xcframework",
    actual = select({
        "@rules_flutter//flutter/private:dbg": ":xcframework_debug",
        "@rules_flutter//flutter/private:profile": ":xcframework_profile",
        "//conditions:default": ":xcframework_release",
    }),
    visibility = ["//visibility:public"],
)
"""

# The web SDK of the selected SDK: `web_sdk` is its tree, `sdk` its slice, and
# each file a web application names is where the release's web SDK
# repository had it.
WEB_SDK_TARGETS = {
    "web_sdk": "{prefix}//web:files",
    "sdk": "{prefix}//web:sdk",
    "web-sdk/kernel/dart2wasm_platform.dill": "{prefix}//web:dart2wasm_platform.dill",
    "web-sdk/kernel/dart2js_platform.dill": "{prefix}//web:dart2js_platform.dill",
    "web-sdk/kernel/ddc_outline.dill": "{prefix}//web:ddc_outline.dill",
    "web-sdk/libraries.json": "{prefix}//web:libraries.json",
    "web-sdk/kernel/ddcLibraryBundle-canvaskit/dart_sdk.js": "{prefix}//web:ddc_dart_sdk.js",
    "dart-sdk/lib/dev_compiler/ddc/ddc_module_loader.js": "{prefix}//web:ddc_module_loader.js",
    "dart-sdk/lib/dev_compiler/web/dart_stack_trace_mapper.js": "{prefix}//web:dart_stack_trace_mapper.js",
}

# The iOS engine of each build mode. `Flutter_xcframework` is what rules_apple
# imports as Flutter.xcframework, so it follows the mode itself: the simulator
# engine under `-c dbg`, the device engines otherwise.
IOS_ENGINE_TARGETS = {
    "Flutter_xcframework_debug": "{prefix}//ios/debug:engine",
    "Flutter_xcframework_profile": "{prefix}//ios/profile:engine",
    "Flutter_xcframework_release": "{prefix}//ios/release:engine",
}

IOS_ENGINE_EXTRA = """
# The engine of the build mode.
alias(
    name = "Flutter_xcframework",
    actual = select({
        "@rules_flutter//flutter/private:dbg": ":Flutter_xcframework_debug",
        "@rules_flutter//flutter/private:profile": ":Flutter_xcframework_profile",
        "//conditions:default": ":Flutter_xcframework_release",
    }),
    visibility = ["//visibility:public"],
)
"""

def android_engine_face_extra(sdks, arch, abi):
    """The BUILD text of the Android engine face of one CPU.

    `stripped` is the engine jar of the selected SDK and the build mode with
    its native libraries stripped and set apart, as a Gradle build strips
    them. The stripping is made once per SDK and mode, not in each
    `flutter_android_engine` target, which every pub plugin has one of.

    Args:
        sdks: A dict from each declared SDK to the label prefix of its engine
            source (`@repo`).
        arch: The CPU part of the target (`arm64`, `x64`).
        abi: The Android ABI of that CPU (`arm64-v8a`).

    Returns:
        BUILD text, for `flutter_face_repo(extra = ...)`.
    """
    content = 'load("@rules_flutter//flutter/private:flutter_android_engine_jar.bzl", "flutter_android_engine_jar")\n'
    declared = ", ".join(sorted(sdks.keys()))
    for sdk, prefix in sorted(sdks.items()):
        for mode in ["debug", "profile", "release"]:
            content += """
flutter_android_engine_jar(
    name = "{sdk}_{mode}_stripped",
    jar = "{prefix}//android-{arch}/{mode}:engine",
    android_abi = "{abi}",
)
""".format(sdk = sdk, mode = mode, prefix = prefix, arch = arch, abi = abi)
        content += """
# The stripped engine of `{sdk}` in the build mode.
alias(
    name = "{sdk}_stripped",
    actual = select({{
        "@rules_flutter//flutter/private:dbg": ":{sdk}_debug_stripped",
        "@rules_flutter//flutter/private:profile": ":{sdk}_profile_stripped",
        "//conditions:default": ":{sdk}_release_stripped",
    }}),
)
""".format(sdk = sdk)
    branches = "".join([
        '            "@flutter_toolchains//:sdk_{sdk}": ":{sdk}_stripped",\n'.format(sdk = sdk)
        for sdk in sorted(sdks.keys())
    ])
    return content + """
# The engine of the selected SDK and the build mode, stripped: debug under
# `-c dbg`, profile under `-c opt` with `//flutter:profile`, release otherwise.
alias(
    name = "stripped",
    actual = select(
        {{
{branches}        }},
        no_match_error = "No Flutter SDK is declared for --@rules_flutter//flutter:sdk. Declared: {declared}.",
    ),
    visibility = ["//visibility:public"],
)
""".format(branches = branches, declared = declared)
