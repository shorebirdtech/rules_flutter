"""Repository rule for the iOS Flutter engine of one build mode.

Downloads the release (AOT, device) or the debug (JIT, simulator) iOS engine
(Flutter.xcframework) into a repository of its own, so a build fetches only the
engine of the mode it builds: a simulator build never downloads the release
engine, nor a release build the debug one. The profile engine lives in its own
repository too. The stock engine source's `ios/<mode>:engine` slices are over
these files; `@flutter_ios_engine//:Flutter_xcframework` follows the build mode
and the selected SDK, and is generated beside the SDKs (flutter_face_repo.bzl).
"""

load("//flutter/private:pinned.bzl", "pinned")
load(":artifact_urls.bzl", "engine_artifact_url", "ios_engine_artifact_path")

def _flutter_ios_engine_repo_impl(repository_ctx):
    # The release archive also carries the iOS gen_snapshot that the
    # macOS-to-iOS cross-compile toolchain uses.
    path = ios_engine_artifact_path(repository_ctx.attr.mode)
    repository_ctx.download_and_extract(
        url = engine_artifact_url(repository_ctx.attr.engine_revision, path),
        sha256 = pinned(path, repository_ctx.attr.sha256),
    )
    repository_ctx.file("BUILD.bazel", _BUILD)

    # Pinned downloads and files written from the attributes alone, so Bazel
    # keeps one copy in its repository contents cache for every output base.
    return repository_ctx.repo_metadata(reproducible = True)

_BUILD = """# Generated by flutter_ios_engine_repo.bzl

filegroup(
    name = "Flutter_xcframework",
    srcs = glob(["Flutter.xcframework/**"]),
    visibility = ["//visibility:public"],
)

exports_files(
    glob(["**"]),
    visibility = ["//visibility:public"],
)
"""

flutter_ios_engine_repo = repository_rule(
    _flutter_ios_engine_repo_impl,
    doc = "Downloads the iOS Flutter engine (Flutter.xcframework) of one build mode.",
    attrs = {
        "engine_revision": attr.string(mandatory = True),
        "mode": attr.string(
            mandatory = True,
            values = ["debug", "release"],
            doc = "The engine's build mode: `debug` (JIT, simulator) or `release` (AOT, device).",
        ),
        "sha256": attr.string(doc = "Expected SHA-256 of the archive."),
    },
)
