"""The toolchain implementations of one SDK.

A repository per SDK holding, for every host, cross pair and desktop cross
pair, the `flutter_toolchain` and `flutter_exec_tools` targets the registry's
`toolchain()` entries point at. They are written against the engine contract's
labels (`engine_labels.bzl`) in the SDK's engine repository, so the stock
release and any other engine source are wired the same way. Nothing here
downloads: the slices an analysed toolchain names are the files fetched.
"""

load("//flutter/private:engine_helpers.bzl", "platform_to_arch", "platform_to_os")
load("//flutter/private:engine_labels.bzl", "engine_label", "gen_snapshot_label", "host_tools_label", "kernel_label", "mode_select", "native_target")
load("//flutter/private:toolchains_repo.bzl", "CROSS_COMPILATION_PAIRS", "DESKTOP_CROSS_PAIRS", "HOST_PLATFORMS")

def _release_kernel(engine):
    return """select({{
        "@rules_flutter//flutter/private:dbg": None,
        "//conditions:default": "{}",
    }})""".format(kernel_label(engine, True))

def _gen_snapshot(engine, target, host):
    return mode_select({
        "profile": gen_snapshot_label(engine, target, "profile", host),
        "release": gen_snapshot_label(engine, target, "release", host),
    })

def _engine(engine, platform):
    return mode_select(
        {mode: engine_label(engine, platform, mode) for mode in ["profile", "release"]},
        debug = engine_label(engine, platform, "debug"),
    )

def _common(engine, host, sdk, version, engine_revision):
    return """    sdk = "{sdk}",
    version = "{version}",
    engine_revision = "{engine_revision}",
    host_tools = "{host_tools}",
    platform_kernel_debug = "{kernel_debug}",
    platform_kernel_release = {kernel_release},
""".format(
        sdk = sdk,
        version = version,
        engine_revision = engine_revision,
        host_tools = host_tools_label(engine, host),
        kernel_debug = kernel_label(engine, False),
        kernel_release = _release_kernel(engine),
    )

def sdk_toolchains_build_content(engine, sdk, version, engine_revision, material_fonts, sysroot_prefix, framework_json = ""):
    """The BUILD file of one SDK's toolchain implementations.

    Args:
        engine: The SDK's engine repository, as a label prefix (`@repo`).
        sdk: The SDK's name.
        version: The Flutter version it reports.
        engine_revision: The engine revision it reports.
        material_fonts: The label of the Material icons font, with `{host}`
            standing for the host platform where the font is per host.
        sysroot_prefix: The prefix of the Linux sysroot repositories
            (`<prefix>_linux_sysroot_<arch>`).
        framework_json: The label of the SDK's `flutter_framework.json` when
            its framework is not the release's.

    Returns:
        The BUILD.bazel text.
    """
    content = """# Generated by flutter_sdk_toolchains_repo.bzl
load("@rules_flutter//flutter:toolchain.bzl", "flutter_exec_tools", "flutter_toolchain")
"""

    framework = '    framework_json = "{}",\n'.format(framework_json) if framework_json else ""

    def sysroot(arch):
        return '    linux_sysroot = "@{}_linux_sysroot_{}//:sysroot_files",\n'.format(sysroot_prefix, arch)

    for host, meta in HOST_PLATFORMS.items():
        common = _common(engine, host, sdk, version, engine_revision)
        content += """
flutter_exec_tools(
    name = "{host}_exec_tools_toolchain",
{common})

flutter_toolchain(
    name = "{host}_toolchain",
{common}    gen_snapshot = {gen_snapshot},
    engine = {engine},
    material_icons_font = "{fonts}",
{framework}{sysroot})
""".format(
            framework = framework,
            host = host,
            common = common,
            gen_snapshot = _gen_snapshot(engine, native_target(host), host),
            engine = _engine(engine, host),
            fonts = material_fonts.format(host = host),
            sysroot = sysroot(meta.arch) if meta.os == "linux" else "",
        )

    # Cross-compilation: the host's tools with the target's gen_snapshot.
    for host, targets in CROSS_COMPILATION_PAIRS.items():
        for target in targets:
            content += """
flutter_toolchain(
    name = "{host}_to_{target}_toolchain",
{common}    gen_snapshot = {gen_snapshot},
    material_icons_font = "{fonts}",
    target_os = "{target_os}",
    target_arch = "{target_arch}",
{framework})
""".format(
                framework = framework,
                host = host,
                target = target,
                common = _common(engine, host, sdk, version, engine_revision),
                gen_snapshot = _gen_snapshot(engine, target, host),
                fonts = material_fonts.format(host = host),
                target_os = platform_to_os(target),
                target_arch = platform_to_arch(target),
            )

    # Desktop cross-compilation: debug bundles only, since no gen_snapshot
    # cross-compiles AOT between desktop OSes.
    for host, targets in DESKTOP_CROSS_PAIRS.items():
        for target in targets:
            content += """
flutter_toolchain(
    name = "{host}_to_{target}_desktop_toolchain",
{common}    engine = {engine},
    material_icons_font = "{fonts}",
    target_os = "{target_os}",
    target_arch = "{target_arch}",
{framework}{sysroot})
""".format(
                framework = framework,
                host = host,
                target = target,
                common = _common(engine, host, sdk, version, engine_revision),
                engine = _engine(engine, target),
                fonts = material_fonts.format(host = host),
                target_os = platform_to_os(target),
                target_arch = platform_to_arch(target),
                sysroot = sysroot(platform_to_arch(target)) if target.startswith("linux") else "",
            )
    return content

def _flutter_sdk_toolchains_repo_impl(repository_ctx):
    repository_ctx.file("BUILD.bazel", sdk_toolchains_build_content(
        engine = repository_ctx.attr.engine,
        sdk = repository_ctx.attr.sdk,
        version = repository_ctx.attr.version,
        engine_revision = repository_ctx.attr.engine_revision,
        material_fonts = repository_ctx.attr.material_fonts,
        sysroot_prefix = repository_ctx.attr.sysroot_prefix,
        framework_json = repository_ctx.attr.framework_json,
    ))

flutter_sdk_toolchains_repo = repository_rule(
    _flutter_sdk_toolchains_repo_impl,
    doc = "The toolchain implementations of one SDK, written against its engine source's slices.",
    attrs = {
        "engine": attr.string(doc = "The SDK's engine repository, as a label prefix: `@repo`.", mandatory = True),
        "sdk": attr.string(mandatory = True),
        "version": attr.string(doc = "The Flutter version the SDK reports."),
        "engine_revision": attr.string(doc = "The engine revision the SDK reports."),
        "material_fonts": attr.string(doc = "Label of the Material icons font; `{host}` stands for the host platform.", mandatory = True),
        "sysroot_prefix": attr.string(doc = "Prefix of the Linux sysroot repositories.", mandatory = True),
        "framework_json": attr.string(doc = "The label of the SDK's `flutter_framework.json`, when its framework is not the release's."),
    },
)
