"""Repository rule for the Android gen_snapshot of one cross-compilation pair.

Downloads the cross-compiling release gen_snapshot that runs on one host and
compiles for one Android ABI. The stock engine source (`flutter_stock_engine_repo.bzl`)
makes it the `gen_snapshot` slice of the target.

(The iOS gen_snapshot is bundled in the iOS engine artifact, so iOS has no repo
of its own.)
"""

load("//flutter/private:pinned.bzl", "pinned")
load(":artifact_urls.bzl", "engine_artifact_url", "gen_snapshot_cross_artifact_path")
load(":engine_helpers.bzl", "gen_snapshot_binary_name", "gen_snapshot_host_platform")

def _flutter_cross_compilation_repo_impl(repository_ctx):
    host_platform = repository_ctx.attr.host_platform
    target_platform = repository_ctx.attr.target_platform

    gen_snapshot_bin = gen_snapshot_binary_name(host_platform)
    artifact_path = gen_snapshot_cross_artifact_path(target_platform, "release", gen_snapshot_host_platform(host_platform))
    repository_ctx.download_and_extract(
        url = engine_artifact_url(repository_ctx.attr.engine_revision, artifact_path),
        sha256 = pinned(artifact_path, repository_ctx.attr.gen_snapshot_sha256),
    )

    # exports_files does not check that the file exists, so a name that
    # misses the download would only fail the first AOT compile.
    if not repository_ctx.path(gen_snapshot_bin).exists:
        fail("{} has no {}".format(artifact_path, gen_snapshot_bin))

    repository_ctx.file(
        "BUILD.bazel",
        '# Generated by flutter_cross_repo.bzl\nexports_files(["{}"], visibility = ["//visibility:public"])\n'.format(gen_snapshot_bin),
    )

flutter_cross_compilation_repo = repository_rule(
    _flutter_cross_compilation_repo_impl,
    doc = "Downloads the cross-compiling release gen_snapshot of one host and Android target.",
    attrs = {
        "engine_revision": attr.string(mandatory = True),
        "host_platform": attr.string(mandatory = True),
        "target_platform": attr.string(mandatory = True),
        "gen_snapshot_sha256": attr.string(doc = "SHA-256 of the gen_snapshot archive."),
    },
)
