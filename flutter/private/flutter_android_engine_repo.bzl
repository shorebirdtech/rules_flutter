"""Repository rule for Android Flutter engine artifacts.

Downloads the Android engine (flutter.jar) which contains the Java
embedding classes (FlutterActivity, FlutterEngine, etc.) and the
native libflutter.so for the target ABI. The release (AOT) and debug (JIT)
jars for an ABI live in one repo, and the profile jar in a repo of its own that
is fetched only by a profile build. Each jar is a target named for its mode
(`release_stripped`, `debug_stripped`, `profile_stripped`), and `stripped` is
the one of the build mode, so consumers reference a single
`flutter_android_engine_<abi>` repo and the `flutter_android_engine` macro
needs no select() — mirroring the macOS and iOS engine repos.

This is lazy — only fetched when an Android build target is used.
"""

load(":artifact_urls.bzl", "android_engine_artifact_path", "engine_artifact_url")
load(":constants.bzl", "ANDROID_ABI_FOR_ARCH")

def _flutter_android_engine_repo_impl(repository_ctx):
    engine_revision = repository_ctx.attr.engine_revision
    android_arch = repository_ctx.attr.android_arch

    # Release engine (AOT) at the repo root.
    repository_ctx.download_and_extract(
        url = engine_artifact_url(engine_revision, android_engine_artifact_path(android_arch, "release")),
        sha256 = repository_ctx.attr.release_sha256,
    )

    # Debug engine (JIT) under debug/ — its flutter.jar would otherwise collide
    # with the release one at the repo root.
    repository_ctx.download_and_extract(
        url = engine_artifact_url(engine_revision, android_engine_artifact_path(android_arch, "debug")),
        sha256 = repository_ctx.attr.debug_sha256,
        output = "debug",
    )

    repository_ctx.file("BUILD.bazel", android_engine_build_file(
        ANDROID_ABI_FOR_ARCH[android_arch],
        repository_ctx.attr.profile_repo_name,
    ))

def android_engine_build_file(abi, profile_repo):
    """The BUILD file of an Android engine repo.

    Args:
        abi: The Android ABI of the engine (e.g. "arm64-v8a").
        profile_repo: Name of the repo holding the profile engine's
            `profile_stripped` target.

    Returns:
        The BUILD file text.
    """
    return _BUILD_TEMPLATE.format(abi = abi, profile_repo = profile_repo)

_BUILD_TEMPLATE = """# Generated by flutter_android_engine_repo.bzl
#
# flutter.jar is a fat jar containing:
# - Java embedding classes (FlutterActivity, FlutterEngine, etc.)
# - Native libflutter.so for the target ABI at lib/<abi>/libflutter.so
#
# Release (AOT) is `flutter.jar`; debug (JIT) is `debug/flutter.jar`; profile
# (AOT) is in the lazily fetched profile repo. Their stripped copies are made
# once per engine, rather than in each flutter_android_engine target, which
# every pub plugin has one of.

load("@rules_flutter//flutter/private:flutter_android_engine_jar.bzl", "flutter_android_engine_jar")

exports_files(
    ["flutter.jar", "debug/flutter.jar"],
    visibility = ["//visibility:public"],
)

# The engine of the build mode, stripped: debug under `-c dbg`, profile under
# `-c opt` with `//flutter:profile`, release otherwise.
alias(
    name = "stripped",
    actual = select({{
        "@rules_flutter//flutter/private:dbg": ":debug_stripped",
        "@rules_flutter//flutter/private:profile": ":profile_stripped",
        "//conditions:default": ":release_stripped",
    }}),
    visibility = ["//visibility:public"],
)

flutter_android_engine_jar(
    name = "release_stripped",
    jar = "flutter.jar",
    android_abi = "{abi}",
    visibility = ["//visibility:public"],
)

flutter_android_engine_jar(
    name = "debug_stripped",
    jar = "debug/flutter.jar",
    android_abi = "{abi}",
    visibility = ["//visibility:public"],
)

alias(
    name = "profile_stripped",
    actual = "@{profile_repo}//:profile_stripped",
    visibility = ["//visibility:public"],
)
"""

flutter_android_engine_repo = repository_rule(
    _flutter_android_engine_repo_impl,
    doc = "Downloads the Android Flutter engine (flutter.jar) for a specific ABI, both release and debug, and aliases the profile engine.",
    attrs = {
        "engine_revision": attr.string(mandatory = True),
        "android_arch": attr.string(
            mandatory = True,
            doc = "Android architecture (arm64, x64, arm, x86, riscv64).",
        ),
        "release_sha256": attr.string(doc = "Expected SHA-256 of the release archive."),
        "debug_sha256": attr.string(doc = "Expected SHA-256 of the debug archive."),
        "profile_repo_name": attr.string(
            doc = "The lazily fetched repo holding the profile engine's profile_stripped target.",
            mandatory = True,
        ),
    },
)
