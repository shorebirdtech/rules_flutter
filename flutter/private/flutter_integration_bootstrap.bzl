"""`flutter_integration_bootstrap`: the program an integration test file runs as."""

load("//flutter/private:app_entrypoint.bzl", "app_scheme_location")

def make_integration_bootstrap_content(test_import, support_import, test_config_import = None):
    """The bootstrap's Dart source.

    Args:
        test_import: The URI of the test file, which the bootstrap imports as
            `test` and runs.
        support_import: The path of the staged `integration_suite.dart`, from
            the bootstrap.
        test_config_import: The URI of the suite's `flutter_test_config.dart`,
            or None. Its `testExecutable` is handed the suite's main and runs
            it, as `flutter test` runs it.

    Returns:
        Dart source.
    """
    imports = ["import '%s' as test;" % test_import]
    run_args = "test.main"
    if test_config_import:
        imports.append("import '%s' as test_config;" % test_config_import)
        run_args += ", testExecutable: test_config.testExecutable"
    imports.append("import '%s';" % support_import)
    return "\n".join([
        "// GENERATED by flutter_integration_bootstrap: do not edit.",
        "//",
        "// The program an integration test runs as: the test file's `main` as a",
        "// suite the host drives, as `flutter test integration_test/x_test.dart",
        "// -d <device>` runs it.",
    ] + imports + [
        "",
        "Future<void> main() => runIntegrationSuite(%s);" % run_args,
        "",
    ])

def _flutter_integration_bootstrap_impl(ctx):
    bootstrap = ctx.outputs.main
    support_dir = ctx.label.name + "_support"

    # The support library is staged beside the bootstrap rather than named by
    # label, because it imports packages of the user's pub hub and cannot be a
    # library of its own: the program compiles it as one of its own files.
    support = []
    for source in ctx.files._support:
        staged = ctx.actions.declare_file("%s/%s" % (support_dir, source.basename))
        ctx.actions.symlink(output = staged, target_file = source)
        support.append(staged)

    config = ctx.file.test_config
    ctx.actions.write(bootstrap, make_integration_bootstrap_content(
        app_scheme_location(ctx.file.src).uri,
        "%s/integration_suite.dart" % support_dir,
        test_config_import = app_scheme_location(config).uri if config else None,
    ))
    return [DefaultInfo(files = depset([bootstrap] + support))]

flutter_integration_bootstrap = rule(
    implementation = _flutter_integration_bootstrap_impl,
    attrs = {
        "src": attr.label(
            doc = "The integration test file, whose `main` declares the tests. " +
                  "It is imported by its workspace path, so it needs no `package:` URI and may sit outside `lib/`.",
            mandatory = True,
            allow_single_file = [".dart"],
        ),
        "test_config": attr.label(
            doc = "The suite's `flutter_test_config.dart`, whose `testExecutable` runs the test's main.",
            allow_single_file = [".dart"],
        ),
        "_support": attr.label_list(
            default = [
                Label("//flutter/private/integration_test/support:integration_suite.dart"),
                Label("//flutter/private/integration_test/support:_channel.dart"),
                Label("//flutter/private/integration_test/support:_channel_io.dart"),
            ],
            allow_files = [".dart"],
        ),
    },
    outputs = {"main": "%{name}.dart"},
    doc = """Generates the program an integration test file runs as, `<name>.dart`.

The program imports the test file by its workspace path and calls
`runIntegrationSuite` (a support library this rule stages beside it, in
`<name>_support/`) on its `main`. That registers the file's tests as a suite
the host drives over the app's VM service, with the same
`IntegrationTestWidgetsFlutterBinding` set-up, golden comparator and
`flutter_test_config.dart` `flutter test` gives it. The `DefaultInfo` carries
the bootstrap and the staged support files.

It is the `main` of a `flutter_application_variant`, whose `srcs` hold the test
file, the files it imports and this target (for the support files). The packages
the support library imports, `integration_test` and `flutter_test`, must come
from that variant's `deps`.""",
)
