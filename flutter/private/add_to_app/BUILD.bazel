# The LLDB files `flutter build ios-framework` writes beside a debug build,
# upstream's templates (flutter_tools' xcode_project.dart) as they are: a
# debug Flutter app on an iOS 26 or later device needs LLDB to touch the pages
# the Dart VM's JIT maps, and the host's scheme names `flutter_lldbinit` as
# its LLDB init file.
exports_files(
    [
        "flutter_lldb_helper.py",
        "flutter_lldbinit",
    ],
    visibility = ["//visibility:public"],
)
