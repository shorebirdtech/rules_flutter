"""Repository rule for Flutter's signed FlutterMacOS.xcframework of one mode.

`flutter build macos-framework` copies the engine cache's
`darwin-x64[-<mode>]/framework.zip`, a `FlutterMacOS.xcframework` that Flutter
signed, and keeps that signature. The macOS apps rules_flutter builds use the
bare `FlutterMacOS.framework.zip` instead, so this archive is a repository of
its own, fetched only by a macOS add-to-app build of its mode. The release one
is 165 MB, most of it the engine's dSYM, which upstream ships too.
"""

load("//flutter/private:pinned.bzl", "pinned")
load(":artifact_urls.bzl", "engine_artifact_url", "macos_xcframework_artifact_path")

def _flutter_macos_xcframework_repo_impl(repository_ctx):
    artifact_path = macos_xcframework_artifact_path(repository_ctx.attr.mode)
    repository_ctx.download_and_extract(
        url = engine_artifact_url(repository_ctx.attr.engine_revision, artifact_path),
        sha256 = pinned(artifact_path, repository_ctx.attr.sha256),
    )
    repository_ctx.file("BUILD.bazel", """# Generated by flutter_macos_xcframework_repo.bzl
filegroup(
    name = "xcframework",
    srcs = glob(["FlutterMacOS.xcframework/**"]),
    visibility = ["//visibility:public"],
)

exports_files(
    ["FlutterMacOS.xcframework/macos-arm64_x86_64/FlutterMacOS.framework/Versions/A/FlutterMacOS"],
    visibility = ["//visibility:public"],
)
""")

flutter_macos_xcframework_repo = repository_rule(
    _flutter_macos_xcframework_repo_impl,
    doc = "Downloads Flutter's signed FlutterMacOS.xcframework (`framework.zip`) of one build mode.",
    attrs = {
        "engine_revision": attr.string(mandatory = True),
        "mode": attr.string(mandatory = True, values = ["debug", "profile", "release"]),
        "sha256": attr.string(doc = "Expected SHA-256 of `framework.zip`."),
    },
)
