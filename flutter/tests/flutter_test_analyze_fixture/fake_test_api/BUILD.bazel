load("@rules_dart//dart:defs.bzl", "dart_library")
load("//flutter:defs.bzl", "dart_package_metadata")

dart_package_metadata(
    name = "pubspec-metadata",
    package_name = "test_api",
)

# Its own Bazel package, not a target beside the fixture, because its
# `package_root` is its Bazel package: declared next to the fixture it would
# claim the same `rootUri` as the fixture's own package, and two packages
# cannot share one in a `package_config.json`.
dart_library(
    name = "fake_test_api",
    srcs = ["lib/backend.dart"],
    package = ":pubspec-metadata",
    # Also the `language_version` suite's `flutter_test` fixture: the rule
    # refuses deps exposing neither `package:flutter_test` nor
    # `package:test_api`, and this is the root workspace's only stand-in.
    visibility = ["//flutter/tests:__subpackages__"],
)
