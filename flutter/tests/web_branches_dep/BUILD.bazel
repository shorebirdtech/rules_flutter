load("@rules_dart//dart:defs.bzl", "dart_library")

# A package a web fixture in `web_test.bzl` depends on, so the tests there can
# see how often each compile's package config names it. In a directory of its
# own because a dependency may not declare a different package at the app's
# root.
dart_library(
    name = "web_branches_dep",
    package_name = "web_branches_dep",
    srcs = ["lib/web_branches_dep.dart"],
    visibility = ["//flutter/tests:__pkg__"],
)
