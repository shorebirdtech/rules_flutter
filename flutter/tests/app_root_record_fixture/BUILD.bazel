# A `flutter_library` at the root of an app's own directory, with a code asset
# and a licence, an app at that root naming the same `dart_package_metadata`,
# and one naming another. See `//flutter/tests:app_root_record_test.bzl`.

load("@rules_dart//dart:defs.bzl", "dart_package_metadata")
load("//flutter:defs.bzl", "flutter_library")
load("//flutter/tests:app_root_record_test.bzl", "app_record_probe")
load("//flutter/tests/code_asset_fixture:stand_in_code_asset.bzl", "stand_in_code_asset")

package(default_visibility = ["//flutter/tests:__pkg__"])

stand_in_code_asset(
    name = "system_asset",
    asset_id = "package:app_root_record/system",
    link_mode = "dynamic_loading_system",
    system_uri = "libapp_root_record.so",
)

dart_package_metadata(
    name = "pubspec",
    package_name = "app_root_record",
    code_assets = [":system_asset"],
    language_version = "3.5",
    license_file = "LICENSE",
)

flutter_library(
    name = "root_library",
    srcs = ["lib/root_record.dart"],
    package = ":pubspec",
)

app_record_probe(
    name = "app",
    package = ":pubspec",
    deps = [":root_library"],
)

# The same package declared a second time, at another language version.
dart_package_metadata(
    name = "other_pubspec",
    package_name = "app_root_record",
    language_version = "3.6",
)

# Fails analysis: only the analysistest that expects it builds it.
app_record_probe(
    name = "app_other_declaration",
    package = ":other_pubspec",
    tags = ["manual"],
    deps = [":root_library"],
)
