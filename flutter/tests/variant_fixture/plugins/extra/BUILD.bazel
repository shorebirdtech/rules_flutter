load("//flutter:defs.bzl", "dart_package_metadata", "flutter_plugin", "flutter_plugin_platform")

dart_package_metadata(
    name = "pubspec-metadata",
    package_name = "variant_extra_plugin",
)

# A plugin only a variant depends on.
flutter_plugin(
    name = "extra_plugin",
    srcs = ["lib/extra_plugin.dart"],
    package = ":pubspec-metadata",
    platforms = [":macos"],
    tags = ["manual"],
    visibility = ["//flutter/tests:__subpackages__"],
)

flutter_plugin_platform(
    name = "macos",
    platform = "macos",
    plugin_class = "ExtraPlugin",
    tags = ["manual"],
)
