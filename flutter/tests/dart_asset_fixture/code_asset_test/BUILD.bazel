load("//flutter:defs.bzl", "dart_package_metadata", "flutter_test")

dart_package_metadata(
    name = "pubspec-metadata",
    package_name = "code_asset_test",
)

# A test that loads native code assets both ways. The analysis tests build it
# for this host and for another platform, and check which configuration its
# libraries come from. In a package of its own because a test cannot share its
# package root with a dep's. Left `manual`; only the analysistests build it.
flutter_test(
    name = "code_asset_flutter_test",
    main = "main.dart",
    package = ":pubspec-metadata",
    tags = ["manual"],
    visibility = ["//flutter/tests:__pkg__"],
    deps = [
        "//flutter/tests/dart_asset_fixture:asset_fixture",
        "//flutter/tests/dart_asset_fixture/plugin_asset:plugin_asset_fixture",
        "//flutter/tests/flutter_test_analyze_fixture/fake_test_api",
    ],
)
