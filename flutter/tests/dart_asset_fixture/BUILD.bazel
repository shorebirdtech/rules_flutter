load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_shared_library.bzl", "cc_shared_library")
load("@rules_dart//dart:defs.bzl", "dart_code_asset", "dart_library")
load("//flutter:defs.bzl", "dart_package_metadata")
load("//flutter/tests:native_assets_test.bzl", "hook_check_probe")

# A pub-package-shaped `dart_library` that owns a native code asset, exactly as
# `pub.from_lock()` generates for a package with a curated `//dart/ext` entry.
# Nothing here mentions Flutter — the point is that rules_flutter picks the
# asset up off the Dart package graph. The other packages of the fixture are the directories below this one.

cc_library(
    name = "empty",
    srcs = ["empty.cc"],
    visibility = ["//flutter/tests/dart_asset_fixture/plugin_asset:__pkg__"],
)

cc_shared_library(
    name = "asset_fixture_shared",
    shared_lib_name = select({
        "@platforms//os:ios": "libasset_fixture.dylib",
        "@platforms//os:macos": "libasset_fixture.dylib",
        "@platforms//os:windows": "asset_fixture.dll",
        "//conditions:default": "libasset_fixture.so",
    }),
    deps = [":empty"],
)

# The library the manifest-layout probes in `native_assets_test.bzl` stage,
# under one name on every host so the paths they expect are fixed.
cc_shared_library(
    name = "layout_probe_shared",
    shared_lib_name = "liblayout_probe.dylib",
    visibility = ["//flutter/tests:__pkg__"],
    deps = [":empty"],
)

dart_code_asset(
    name = "code_asset",
    asset_id = "package:asset_fixture/src/ffi/asset_fixture.g.dart",
    file = ":asset_fixture_shared",
    visibility = ["//flutter/tests/dart_asset_fixture/not_owner:__pkg__"],
)

dart_package_metadata(
    name = "pubspec-metadata",
    package_name = "asset_fixture",
    code_assets = [":code_asset"],
)

dart_library(
    name = "asset_fixture",
    srcs = ["lib/fixture.dart"],
    package = ":pubspec-metadata",
    visibility = [
        "//flutter/tests:__pkg__",
        "//flutter/tests/dart_asset_fixture/code_asset_test:__pkg__",
        "//flutter/tests/shared_code_asset_fixture/test:__pkg__",
    ],
)

# The check over a package with no build hook and one with an unreplaced
# one, so a check that reported nothing, or everything, fails one of them.
hook_check_probe(
    name = "plain_package_is_no_offender",
    deps = ["//flutter/tests/flutter_test_analyze_fixture/fake_test_api"],
)

hook_check_probe(
    name = "hook_fixture_is_an_offender",
    expect_offender = True,
    deps = ["//flutter/tests/dart_asset_fixture/hook_fixture"],
)

build_test(
    name = "hook_check_test",
    targets = [
        ":hook_fixture_is_an_offender",
        ":plain_package_is_no_offender",
    ],
)
