load("@rules_dart//dart:defs.bzl", "dart_package_metadata")
load("//flutter:defs.bzl", "flutter_plugin")
load("//flutter:native_assets.bzl", "flutter_native_asset")

# The other way a code asset reaches a test: declared with
# `flutter_native_asset` and propagated on `FlutterInfo` by a plugin.
flutter_native_asset(
    name = "plugin_asset",
    asset_id = "package:plugin_asset_fixture/plugin_asset.dart",
    bundle_filename = "libplugin_asset_fixture.dylib",
    library = "//flutter/tests/dart_asset_fixture:asset_fixture_shared",
    link_mode = "dynamic_loading_bundle",
)

dart_package_metadata(
    name = "pubspec-metadata",
    package_name = "plugin_asset_fixture",
)

flutter_plugin(
    name = "plugin_asset_fixture",
    srcs = ["lib/fixture.dart"],
    native_assets = [":plugin_asset"],
    package = ":pubspec-metadata",
    visibility = ["//flutter/tests/dart_asset_fixture/code_asset_test:__pkg__"],
)
