"""Three plugins with Android libraries, and applications that use some of them.

`plugin_a`, `plugin_b` and `plugin_ok`, each in a package of its own, export an
Android library (a plain `java_library`, which is all the link rule needs of one). The Maven
requirements say `plugin_a` and `plugin_b` declare an artifact nobody
installed, and `plugin_ok` one that is. `plugin_native`'s library brings
prebuilt native libraries, as an AAR's do.
"""

load("//flutter:android.bzl", "flutter_android_plugin_libs")
load("//flutter:defs.bzl", "dart_package_metadata", "flutter_application")
load("//flutter/private:flutter_android_plugin_libs.bzl", "flutter_android_maven_report", "flutter_android_maven_requirements")

package(default_visibility = ["//flutter/tests:__subpackages__"])

# The applications are four programs of one package, which differ in the
# plugin each uses.
dart_package_metadata(
    name = "pubspec-metadata",
    package_name = "android_plugin_libs_fixture",
)

[
    [
        flutter_application(
            name = "app_uses_" + n,
            main = "main.dart",
            package = ":pubspec-metadata",
            tags = ["manual"],
            deps = ["//flutter/tests/android_plugin_libs_fixture/%s:plugin_%s" % (n, n)],
        ),
        flutter_android_plugin_libs(
            name = "libs_of_" + n,
            tags = ["manual"],
            deps = ":app_uses_" + n,
        ),
        flutter_android_plugin_libs(
            name = "checked_libs_of_" + n,
            maven = ":maven",
            report = "//app:%s_maven_artifacts" % n,
            tags = ["manual"],
            deps = ":app_uses_" + n,
        ),
        flutter_android_maven_report(
            name = "report_of_" + n,
            app_label = "//app:" + n,
            application = ":app_uses_" + n,
            maven = ":maven",
            tags = ["manual"],
        ),
    ]
    for n in [
        "a",
        "b",
        "ok",
    ]
]

flutter_application(
    name = "app_uses_native",
    main = "main.dart",
    package = ":pubspec-metadata",
    tags = ["manual"],
    deps = ["//flutter/tests/android_plugin_libs_fixture/native:plugin_native"],
)

flutter_android_plugin_libs(
    name = "libs_of_native",
    tags = ["manual"],
    deps = ":app_uses_native",
)

flutter_android_maven_requirements(
    name = "maven",
    data = json.encode({
        "repositories": ["https://maven.google.com"],
        "resolved": {"g:installed": "1.0"},
        "packages": [
            {
                "package": "plugin_a",
                "version": "1.0",
                "deps": [{
                    "kind": "deps",
                    "coordinate": "g:needed_by_a",
                    "version": "2.0",
                    "line": "",
                    "checked": True,
                }],
                "script": "android/build.gradle",
                "unread": [],
            },
            {
                "package": "plugin_b",
                "version": "1.0",
                "deps": [{
                    "kind": "deps",
                    "coordinate": "g:needed_by_b",
                    "version": "2.0",
                    "line": "",
                    "checked": True,
                }],
                "script": "android/build.gradle",
                "unread": [],
            },
            {
                "package": "plugin_ok",
                "version": "1.0",
                "deps": [{
                    "kind": "deps",
                    "coordinate": "g:installed",
                    "version": "1.0",
                    "line": "",
                    "checked": True,
                }],
                "script": "android/build.gradle",
                "unread": [],
            },
        ],
    }),
)
