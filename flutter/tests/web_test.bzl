def _html_title_escaping_test_impl(ctx):
    """Test that HTML special characters in titles are properly escaped."""
    env = unittest.begin(ctx)

    test_cases = [
        ("My App", "My App"),
        ("App & Co", "App &amp; Co"),
        ("<script>", "&lt;script&gt;"),
        ('He said "hi"', "He said &quot;hi&quot;"),
        ("Normal Title", "Normal Title"),
    ]

    for title, expected in test_cases:
        asserts.equals(env, expected, escape_html(title), "Escaping '%s'" % title)

    return unittest.end(env)

def _web_compiler_renderer_validation_test_impl(ctx):
    """Test that invalid compiler+renderer combos are rejected."""
    env = unittest.begin(ctx)

    # Valid combinations.
    asserts.true(env, is_valid_web_compiler_renderer("dart2wasm", "skwasm"), "dart2wasm+skwasm should be valid")
    asserts.true(env, is_valid_web_compiler_renderer("dart2wasm", "canvaskit"), "dart2wasm+canvaskit should be valid")
    asserts.true(env, is_valid_web_compiler_renderer("dart2js", "canvaskit"), "dart2js+canvaskit should be valid")

    # Invalid: dart2js cannot use skwasm (skwasm requires wasm).
    asserts.false(env, is_valid_web_compiler_renderer("dart2js", "skwasm"), "dart2js+skwasm should be invalid")

    return unittest.end(env)

def _web_renderer_default_test_impl(ctx):
    """An unset renderer follows the compiler; a named one is kept."""
    env = unittest.begin(ctx)
    asserts.equals(env, "skwasm", web_renderer("dart2wasm", ""))
    asserts.equals(env, "canvaskit", web_renderer("dart2js", ""))
    asserts.equals(env, "canvaskit", web_renderer("dart2wasm", "canvaskit"))

    # Named and wrong is still refused, by the validation above.
    asserts.equals(env, "skwasm", web_renderer("dart2js", "skwasm"))
    return unittest.end(env)

def _service_worker_tears_down_test_impl(ctx):
    """The shipped worker must remove itself, and must not cache."""
    env = unittest.begin(ctx)

    asserts.true(
        env,
        "self.registration.unregister()" in SERVICE_WORKER_JS,
        "The worker must unregister itself — tearing down a previously " +
        "installed caching worker is the only reason it ships.",
    )
    asserts.true(
        env,
        "self.skipWaiting()" in SERVICE_WORKER_JS,
        "Without skipWaiting the teardown waits for every tab to close.",
    )
    asserts.true(
        env,
        "client.navigate(client.url)" in SERVICE_WORKER_JS,
        "Controlled clients must be reloaded, or they keep reading the " +
        "old worker's cache for the rest of the session.",
    )

    # A cache-first worker whose script never changes pins a visitor to the
    # build they first loaded, with no way to push a fix. Nothing that touches
    # the Cache API belongs in a worker generated by these rules.
    for banned in ["caches.open", "caches.match", "cache.addAll", "CACHE_NAME"]:
        asserts.false(
            env,
            banned in SERVICE_WORKER_JS,
            "The generated worker must not cache (found `%s`)." % banned,
        )

    return unittest.end(env)

def _service_worker_load_args_test_impl(ctx):
    """`_flutter.loader.load` gets the version, and only the version."""
    env = unittest.begin(ctx)

    args = service_worker_load_args(pwa = True)
    asserts.true(
        env,
        "serviceWorkerSettings" in args,
        "The loader needs serviceWorkerSettings to register at all.",
    )

    # The version arrives through the templating pass, as the same
    # `{{flutter_service_worker_version}}` built-in a user-supplied bootstrap
    # would reference — so the default template exercises the path a copied
    # upstream bootstrap takes, instead of a private shortcut around it.
    asserts.true(
        env,
        "{{flutter_service_worker_version}}" in args,
        "The version must reach the bootstrap through the built-in, got %r" % args,
    )

    # flutter.js registers unconditionally when handed a serviceWorkerUrl,
    # which would install a worker for first-time visitors who have nothing to
    # tear down, and logs a deprecation warning to their console besides.
    asserts.false(
        env,
        "serviceWorkerUrl" in args,
        "serviceWorkerUrl defeats the existing-registration gate.",
    )

    asserts.equals(
        env,
        "",
        service_worker_load_args(pwa = False),
        "pwa = False must produce a bare `load()` with no worker settings.",
    )

    return unittest.end(env)

def _wasm_allow_list_test_impl(ctx):
    """`wasm_browsers` becomes an exact `wasmAllowList`, and only when set."""
    env = unittest.begin(ctx)
    asserts.equals(env, "", wasm_allow_list_property([]), "unset is Flutter's own default")

    # Every engine is stated, so one left out is refused rather than left to
    # Flutter's default (which allows `blink`).
    asserts.equals(
        env,
        "config: {\n        wasmAllowList: " +
        "{\"blink\":false,\"gecko\":true,\"unknown\":false,\"webkit\":true}\n      }",
        wasm_allow_list_property(["gecko", "webkit"]),
    )

    # The property joins the worker's in one argument, and stands alone when
    # there is no worker.
    both = service_worker_load_args(True, extra_properties = [wasm_allow_list_property(["blink"])])
    asserts.true(env, "serviceWorkerSettings" in both and "wasmAllowList" in both, both)
    asserts.true(env, both.index("serviceWorkerSettings") < both.index("config:"), both)
    alone = service_worker_load_args(False, extra_properties = [wasm_allow_list_property(["blink"])])
    asserts.true(env, "wasmAllowList" in alone and "serviceWorker" not in alone, alone)
    asserts.equals(env, "", service_worker_load_args(False, extra_properties = [""]))
    return unittest.end(env)

_t6_test = unittest.make(_wasm_allow_list_test_impl)

def _renderer_file_filter_test_impl(ctx):
    """Each renderer's files are kept for it, and only for it."""
    env = unittest.begin(ctx)
    skwasm_files = ["skwasm.js", "skwasm.wasm", "skwasm.js.symbols", "skwasm_heavy.wasm", "wimp.js", "wimp.wasm"]
    canvaskit_files = ["canvaskit.js", "canvaskit.wasm", "chromium/canvaskit.wasm", "webparagraph/canvaskit.js"]
    for f in skwasm_files:
        asserts.true(env, renderer_file_needed(f, ["skwasm"]), f)
        asserts.false(env, renderer_file_needed(f, ["canvaskit"]), f)
    for f in canvaskit_files:
        asserts.true(env, renderer_file_needed(f, ["canvaskit"]), f)
        asserts.false(env, renderer_file_needed(f, ["skwasm"]), f)
    for f in skwasm_files + canvaskit_files:
        asserts.true(env, renderer_file_needed(f, ["skwasm", "canvaskit"]), f)

    # A file this does not know is kept: an extra one costs bytes, a missing one a blank page.
    asserts.true(env, renderer_file_needed("something_new.wasm", ["skwasm"]))
    asserts.true(env, renderer_file_needed("something_new.wasm", ["canvaskit"]))
    return unittest.end(env)

_t7_test = unittest.make(_renderer_file_filter_test_impl)

def _service_worker_version_test_impl(ctx):
    """The version has to survive flutter.js's `endsWith` comparison."""
    env = unittest.begin(ctx)

    # flutter.js decides whether the active worker is current with
    # `registration.active.scriptURL.endsWith(version)`. A version containing
    # URL-significant characters would be mangled between the two sides.
    for banned in ["?", "&", "=", "/", " ", "#"]:
        asserts.false(
            env,
            banned in SERVICE_WORKER_VERSION,
            "Version must be a suffix-safe literal (found `%s`)." % banned,
        )
    asserts.true(
        env,
        len(SERVICE_WORKER_VERSION) > 0,
        "An empty version makes every scriptURL compare equal.",
    )

    # The version is derived from the worker source rather than written down,
    # so that editing the worker cannot leave a stale version behind. Asserting
    # it *moves* is the whole point: a derivation that ignored its input would
    # satisfy every other check in this test.
    asserts.equals(
        env,
        SERVICE_WORKER_VERSION,
        service_worker_version_for(SERVICE_WORKER_JS),
        "The shipped version must be the one derived from the shipped worker.",
    )
    asserts.false(
        env,
        SERVICE_WORKER_VERSION == service_worker_version_for(
            SERVICE_WORKER_JS + "\n// a change to the worker\n",
        ),
        "A changed worker must produce a changed version.",
    )

    # The fixed prefix is what keeps two versions from comparing equal under
    # `endsWith`: without it, "123" is a suffix of "4123" and flutter.js would
    # read a stale worker as current.
    asserts.true(
        env,
        SERVICE_WORKER_VERSION.startswith("rules_flutter_"),
        "Version must carry the fixed prefix, got %r" % SERVICE_WORKER_VERSION,
    )

    return unittest.end(env)

_t0_test = unittest.make(_html_title_escaping_test_impl)
_t1_test = unittest.make(_web_compiler_renderer_validation_test_impl)
_t2_test = unittest.make(_service_worker_tears_down_test_impl)
_t3_test = unittest.make(_service_worker_load_args_test_impl)
_t4_test = unittest.make(_service_worker_version_test_impl)
