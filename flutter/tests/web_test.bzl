# -- Analysis tests over the flutter_web_bundle rule -------------------------
#
# These read the actual dart2wasm/dart2js command lines and declared outputs
# of fixture targets, in a pinned compilation mode, so that the defines a web
# build carries per mode — and the `-c dbg` dev-loop contract (dev config +
# DDC side-files) — are asserted where they live rather than inferred.

def _action(env, mnemonic):
    """The single action with `mnemonic` on the target under test."""
    found = [a for a in analysistest.target_actions(env) if a.mnemonic == mnemonic]
    asserts.equals(env, 1, len(found), "expected exactly one %s action" % mnemonic)
    return found[0] if found else None

def _assert_argv(env, action, present = [], absent_substrings = []):
    """Assert exact args present and substrings absent on an action's argv."""
    if action == None:
        return
    argv = action.argv
    for arg in present:
        asserts.true(env, arg in argv, "%r missing from %s argv: %s" % (arg, action.mnemonic, argv))
    for sub in absent_substrings:
        matches = [a for a in argv if sub in a]
        asserts.equals(env, [], matches, "%r must not appear in %s argv" % (sub, action.mnemonic))

def _assert_dart2js(env, js_fallback, present = [], absent_substrings = [], level = None):
    """Assert the dart2js compile a fixture should (not) run.

    A fixture with the fallback runs exactly one, and its argv is checked; one
    with `js_fallback = False` runs none at all, which is the point of a
    WASM-only bundle.

    Args:
        env: The analysistest env.
        js_fallback: Whether the fixture asked for the fallback.
        present: Args that must be on the dart2js argv.
        absent_substrings: Substrings that must not be.
        level: The expected `-O` level, or None to leave it unchecked.
    """
    if not js_fallback:
        asserts.equals(
            env,
            [],
            [a.mnemonic for a in analysistest.target_actions(env) if a.mnemonic == "FlutterDart2JS"],
            "a WASM-only bundle must run no dart2js compile",
        )
        return
    action = _action(env, "FlutterDart2JS")
    _assert_argv(env, action, present = present, absent_substrings = absent_substrings)
    if level != None:
        _assert_optimization_level(env, action, level)

def _assert_optimization_level(env, action, expected):
    """Assert the action states exactly one `-O`, and that it is `expected`.

    Asserted as "exactly one" rather than "contains": both compilers default
    to `-O1` when the flag is absent, so a level that fails to reach the
    command line is not a neutral outcome, and a second `-O` would silently
    win over the first.

    Args:
        env: The analysistest env.
        action: The action to read, from `_action`.
        expected: The level as an int.
    """
    if action == None:
        return
    levels = [a for a in action.argv if a.startswith("-O")]
    asserts.equals(
        env,
        ["-O%d" % expected],
        levels,
        "%s must state exactly one optimization level" % action.mnemonic,
    )

def _default_basenames(env):
    target = analysistest.target_under_test(env)
    return [f.basename for f in target[DefaultInfo].files.to_list()]

def _assert_bundle_agent(env, expected):
    """Assert whether the bundle compiles in the agent extensions and bridge.

    A debug bundle carries them, because dart2wasm and dart2js leave no VM
    service to reach the extensions through and the dev tool calls them over
    the browser's DevTools protocol instead. Every other mode leaves them out:
    they are debug-only, as on native.

    Args:
        env: The analysistest env.
        expected: Whether this mode's bundle should carry them.
    """
    wrappers = [
        a
        for a in analysistest.target_actions(env)
        if a.mnemonic == "FileWrite" and a.outputs.to_list()[0].basename.endswith("_wrapper_main.dart")
    ]
    asserts.equals(env, 1, len(wrappers), "expected exactly one wrapper main write")
    if wrappers:
        installs = "installRulesFlutterAgentBridge(" in wrappers[0].content
        asserts.equals(env, expected, installs, "wrapper main installing the agent bridge")
    compiles = [
        a
        for a in analysistest.target_actions(env)
        if a.mnemonic in ("FlutterDart2Wasm", "FlutterDart2JS")
    ]
    asserts.true(env, len(compiles) > 0, "expected a web compile action")
    for action in compiles:
        mnemonic = action.mnemonic
        staged = [
            f.basename
            for f in action.inputs.to_list()
            if f.basename.endswith(".agent_extensions.dart") or f.basename.endswith(".agent_web_bridge.dart")
        ]
        asserts.equals(env, 2 if expected else 0, len(staged), "%s agent inputs: %s" % (mnemonic, staged))

def _dbg_web_defines_test_impl(ctx):
    """A `-c dbg` web build is a debug build: no product define, asserts on.

    Both compilers are checked where the fixture asks for the fallback — it
    ships in the same bundle, and a fallback silently compiled as release would
    be the same bug reappearing on WASM-less browsers. A fixture without one is
    checked for running no dart2js at all.
    """
    env = analysistest.begin(ctx)
    js_fallback = ctx.attr.js_fallback
    _assert_argv(
        env,
        _action(env, "FlutterDart2Wasm"),
        present = [
            "--extra-compiler-option=--enable-asserts",
            "--no-minify",
            # Debug shipped stripped until `strip_wasm` was gated on release.
            # A stripped debug WASM is a stack trace with no names in it.
            "--no-strip-wasm",
        ],
        # `toString()` bodies have to survive a debug build: dropping them is
        # what makes `'$widget'` stop naming the type, and debug is where that
        # output is read.
        absent_substrings = ["dart.vm.product", "dart.vm.profile", "delete-tostring"],
    )
    _assert_dart2js(
        env,
        js_fallback,
        present = ["--enable-asserts", "--no-minify", "--native-null-assertions"],
        absent_substrings = ["dart.vm.product", "dart.vm.profile", "frequency-based"],
        # Dart2js stops at 1 in debug; see the levels note below.
        level = 1,
    )

    # Upstream's debug levels, which the two compilers disagree about: dart2js
    # stops at 1 because level 0 "is not well supported" there, while dart2wasm
    # takes 0 — it compiles a debug app in half the time for twice the output,
    # which is the trade a debug build exists to make. Both were 2 until this
    # was corrected, which is what minified debug JS before `--no-minify` was
    # stated outright.
    _assert_optimization_level(env, _action(env, "FlutterDart2Wasm"), 0)
    _assert_bundle_agent(env, expected = True)

    # The dbg dev-loop contract: the target's outputs still carry the dev
    # config and the DDC side-files the dev tool's DWDS loop stages.
    basenames = _default_basenames(env)
    prefix = analysistest.target_under_test(env).label.name
    for expected in [
        prefix + "_dev_config.json",
        prefix + ".dev_package_config.json",
        prefix + "_ddc_outline.dill",
        prefix + "_ddc_libraries.json",
        prefix + "_ddc_dart_sdk.js",
        prefix + "_ddc_module_loader.js",
        prefix + "_ddc_stack_trace_mapper.js",
        prefix + ".agent_extensions.dart",
        prefix + "_dev_flutter_bootstrap.js",
    ]:
        asserts.true(env, expected in basenames, "%s missing from dbg outputs: %s" % (expected, basenames))

    # The dev server answers `/flutter_bootstrap.js` with the file this names.
    # Named rather than found by suffix, so a run cannot pick up a sibling
    # target's bootstrap and boot the wrong app.
    dev_config = written_json(env, "_dev_config.json")
    if dev_config != None:
        asserts.true(
            env,
            dev_config["flutterBootstrapJs"].endswith(prefix + "_dev_flutter_bootstrap.js"),
            "the dev config must name the dev loop's bootstrap: %s" % dev_config.get("flutterBootstrapJs"),
        )

    # The dev loop serves this bundle's index.html next to a bootstrap of its
    # own, so a debug build is where inlining the boot path has to be refused.
    _assert_template_wiring(env, expect_dev_loop_guard = True)
    return analysistest.end(env)

_dbg_web_defines_test = analysistest.make(
    _dbg_web_defines_test_impl,
    attrs = {"js_fallback": attr.bool(default = False)},
    config_settings = {"//command_line_option:compilation_mode": "dbg"},
)

def _profile_web_defines_test_impl(ctx):
    """`profile = True` is its own mode, and neither of the other two.

    Asserted from a `-c dbg` configuration on purpose: the attr overrides the
    compilation-mode mapping, so a profile build assembled under `-c dbg` must
    still come out as profile. An implementation that only special-cased
    `-c opt` would pass an opt-configured version of this test.
    """
    env = analysistest.begin(ctx)

    # dart2wasm: profile carries its own define, and the release-shaped
    # `toString()` stripping that makes it representative of release.
    _assert_argv(
        env,
        _action(env, "FlutterDart2Wasm"),
        present = [
            "-Ddart.vm.profile=true",
            # Left unminified and unstripped on purpose: a profile build
            # exists to be read, and upstream gates both on release.
            "--no-minify",
            "--no-strip-wasm",
            "--extra-compiler-option=--delete-tostring-package-uri=dart:ui",
            "--extra-compiler-option=--delete-tostring-package-uri=package:flutter",
        ],
        absent_substrings = ["enable-asserts", "dart.vm.product"],
    )

    # dart2js gets the define but not the tostring options — upstream's
    # `Dart2JSTarget` has no equivalent, and dart2js would reject them.
    _assert_dart2js(
        env,
        True,
        present = ["-Ddart.vm.profile=true", "--no-minify", "--native-null-assertions"],
        absent_substrings = ["enable-asserts", "dart.vm.product", "delete-tostring"],
    )

    # A profile build optimizes exactly as release does — it exists to measure
    # release, so a lower level here would measure something nobody ships.
    _assert_optimization_level(env, _action(env, "FlutterDart2Wasm"), 2)
    _assert_optimization_level(env, _action(env, "FlutterDart2JS"), 4)
    _assert_bundle_agent(env, expected = False)

    # A profile build is not a dev-loop build: nothing may serve it as one.
    for basename in _default_basenames(env):
        asserts.false(
            env,
            "dev_config" in basename or "_ddc_" in basename,
            "dev-loop file %s leaked into a profile build" % basename,
        )
    _assert_template_wiring(env, expect_dev_loop_guard = False)
    return analysistest.end(env)

_profile_web_defines_test = analysistest.make(
    _profile_web_defines_test_impl,
    config_settings = {"//command_line_option:compilation_mode": "dbg"},
)

def _opt_web_defines_test_impl(ctx):
    """A `-c opt` web build is a release build: product define, no asserts."""
    env = analysistest.begin(ctx)
    js_fallback = ctx.attr.js_fallback
    _assert_argv(
        env,
        _action(env, "FlutterDart2Wasm"),
        present = [
            "-Ddart.vm.product=true",
            "--minify",
            "--strip-wasm",
            # Release drops `toString()` bodies upstream. Missing here until
            # profile mode landed, which is why it is pinned in both modes
            # that carry it rather than only in the new one.
            "--extra-compiler-option=--delete-tostring-package-uri=dart:ui",
            "--extra-compiler-option=--delete-tostring-package-uri=package:flutter",
        ],
        absent_substrings = ["enable-asserts", "dart.vm.profile"],
    )
    _assert_dart2js(
        env,
        js_fallback,
        present = ["-Ddart.vm.product=true", "--minify", "--native-null-assertions"],
        absent_substrings = ["enable-asserts", "dart.vm.profile"],
        level = 4,
    )

    # The release levels, and the reason they differ: dart2js goes to 4, while
    # dart2wasm stops at 2 because that is the highest level using only sound
    # optimizations and upstream's benchmarks put the rest at marginal. A
    # single shared level cannot state both, which is why there is no single
    # shared attr.
    _assert_optimization_level(env, _action(env, "FlutterDart2Wasm"), 2)
    _assert_bundle_agent(env, expected = False)

    # Release output is the bundle directory alone — none of the dev-loop
    # side-files may leak into it.
    for basename in _default_basenames(env):
        asserts.false(
            env,
            "dev_config" in basename or "_ddc_" in basename,
            "dev-loop file %s leaked into release outputs" % basename,
        )

    # Nothing serves a release bundle but a web server, so an index.html that
    # inlines the bootstrap is a legitimate single-request deployment here.
    _assert_template_wiring(env, expect_dev_loop_guard = False)
    return analysistest.end(env)

_opt_web_defines_test = analysistest.make(
    _opt_web_defines_test_impl,
    attrs = {"js_fallback": attr.bool(default = False)},
    config_settings = {"//command_line_option:compilation_mode": "opt"},
)

def _dev_config_test_impl(ctx):
    """`_dev_config.json` is the artifact the whole DDC dev loop hangs off.

    The dev tool reads every key below by name — a run whose `_dev_config.json`
    is missing ends deliberately, quoting the file (`web_e2e_test.dart`), so a
    file that is *present but wrong* is the failure with no guard at all. The
    dbg-outputs test above only proves it was written; this proves what is in it.

    `expect_entrypoint` is passed in rather than derived, because deriving it
    here would just re-run the rule's own `main.short_path` arithmetic and
    agree with itself.
    """
    env = analysistest.begin(ctx)
    config = written_json(env, "_dev_config.json")
    if config == None:
        return analysistest.end(env)

    # The synthetic entrypoint the dev tool compiles. Getting this wrong is a
    # frontend server that compiles the wrong library and an app that never
    # starts, so both branches of the rule's `<pkg>/lib/` strip are pinned —
    # see the two fixtures in `_setup_web_fixtures`.
    asserts.equals(env, ctx.attr.expect_entrypoint, config["appEntrypoint"])

    # Staged beside the synthetic entrypoint and imported by it. Named by the
    # build precisely so the dev tool never has to search for it.
    asserts.true(
        env,
        config["agentExtensions"].endswith(".agent_extensions.dart"),
        "agentExtensions must name the staged file, got %r" % config["agentExtensions"],
    )

    # Replayed as -D on the resident frontend server, so a reload recompiles
    # under the same environment the initial build used.
    asserts.equals(env, ["from.attr=1"], config["dartDefines"])

    # The dev loop asserts native nullability through its own bootstrap rather
    # than a compiler flag, so the value has to travel to it explicitly or a
    # `native_null_assertions = False` app would keep checking under
    # `flutter_bazel run` while its bundle had stopped.
    asserts.equals(env, True, config["nativeNullAssertions"])

    # A fixture with no web plugins. The empty state must be expressible and
    # asserted: the dev tool distinguishes "this app has no registrant" from
    # "the registrant went missing", and a sentinel here would collapse the two.
    asserts.equals(env, "", config["webPluginRegistrant"])

    # Always written in dbg — the dev package config is what lets a
    # source-assembled app resolve `package:` URIs across the live tree rather
    # than the frozen assembled copy, and every dbg web run is a dev-loop run.
    asserts.true(
        env,
        config["devPackageConfig"].endswith(".dev_package_config.json"),
        "devPackageConfig must name the dbg dev package config, got %r" %
        config["devPackageConfig"],
    )

    # Codegen keys in their non-codegen state. A plain app must contribute no
    # filesystem roots and no generated sources; phantom entries here would put
    # the frontend server on a multi-root layout it has no sources for.
    asserts.equals(env, [], config["filesystemRoots"])
    asserts.equals(env, [], config["generatedSourcePaths"])
    asserts.equals(env, [], config["generatedSourceUris"])

    # The scheme the dev tool hands its frontend server as
    # `--filesystem-scheme`; the URIs it then invalidates are built on it, so
    # the two sides have to name the same one.
    asserts.equals(env, "org-dartlang-app", config["filesystemScheme"])

    # The app itself, which is how the dev tool maps a live edit of a file
    # back to the `package:` URI to invalidate. The fixture declares no `srcs`,
    # so its `main` is the only first-party source here — and it is listed
    # under this target's own package, not the workspace root.
    #
    # An app record claiming `lib_root = ""` would match no file of a package
    # that does not sit at the workspace root, so a live edit to such an app's
    # `main` would map to no package at all.
    asserts.equals(
        env,
        [{"name": "web_fixture", "libRoot": "flutter/tests"}],
        config["sourcePackages"],
    )

    # The tools the dev tool spawns or reads by path. None may be empty: an
    # empty path here surfaces as a spawn failure deep in the dev loop, far
    # from the build that wrote it.
    for key in [
        "engineRevision",
        "flutterVersion",
        "dartSdkRoot",
        "dartaotruntime",
        "frontendServer",
        "patchedSdkRoot",
    ]:
        asserts.true(env, len(config[key]) > 0, "%s must not be empty" % key)
    return analysistest.end(env)

