def _template_config(env):
    """The config the templating action is driven by, decoded."""
    return action_config(env, "FlutterWebTemplate")

def _template_action_outputs(env):
    """Basenames the single FlutterWebTemplate action declares."""
    action = _action(env, "FlutterWebTemplate")
    if action == None:
        return []
    return [f.basename for f in action.outputs.to_list()]

def _assert_template_wiring(env, expect_dev_loop_guard):
    """The templating pass's plumbing, asserted at the three joints it has.

    What the config says, what the action declares, and where the bundler is
    told to put it. The substitution itself is the tool's own business and is
    covered by `web_template_test.dart`; asserting text here would only
    re-run the same code twice.
    """
    config = _template_config(env)
    if config == None:
        return
    files = config["files"]

    # Bootstrap first: index.html inlines the *substituted* bootstrap through
    # `{{flutter_bootstrap_js}}`, which only works if it was already produced.
    # The dev loop's copy goes last, so that index stays at output 0 and inlines
    # the bundle's bootstrap rather than DDC's.
    expected_labels = ["flutter_bootstrap.js", "index.html"]
    if expect_dev_loop_guard:
        expected_labels.append("flutter_bootstrap.js (dev loop)")
    asserts.equals(env, expected_labels, [f["label"] for f in files])
    bootstrap, index = files[0], files[1]
    asserts.equals(env, 0, index["builtins"]["flutter_bootstrap_js"]["from_output"])

    # Without a build config the loader has nothing to boot, and it is the one
    # built-in that cannot come from anywhere but this rule.
    for entry in [bootstrap, index]:
        asserts.true(
            env,
            "_flutter.buildConfig" in entry["builtins"]["flutter_build_config"]["value"],
            "%s must receive this target's build config" % entry["label"],
        )

    # The guard exists because the dev tool serves index.html as built while
    # serving a DDC-configured bootstrap beside it. It is a debug-only concern,
    # and turning it on in release would refuse a legitimate single-file
    # deployment.
    asserts.equals(env, expect_dev_loop_guard, index["dev_loop_guard"])
    asserts.false(
        env,
        bootstrap["dev_loop_guard"],
        "the guard is about index.html; a bootstrap is served by the dev loop, not inlined",
    )

    # The dev loop's bootstrap: the same template, the same defines, DDC's
    # build config. Without this the run served a bootstrap the dev tool wrote
    # from string literals, which no `bootstrap_js` template and no
    # `web_defines` entry could reach.
    if expect_dev_loop_guard:
        dev = files[2]
        asserts.equals(
            env,
            bootstrap["template"],
            dev["template"],
            "the dev loop must boot from the same template the bundle ships",
        )
        dev_config = dev["builtins"]["flutter_build_config"]["value"]
        asserts.true(
            env,
            "\"compileTarget\":\"dartdevc\"" in dev_config,
            "the dev loop compiles with DDC, so its build config must say so: %s" % dev_config,
        )
        asserts.true(
            env,
            "\"useLocalCanvasKit\":true" in dev_config,
            "the dev loop serves the renderer from the bundle it is serving: %s" % dev_config,
        )
        asserts.false(
            env,
            "\"compileTarget\":\"dartdevc\"" in bootstrap["builtins"]["flutter_build_config"]["value"],
            "the bundle's own bootstrap must name the bundle's compiler, not DDC's",
        )

        # A worker registered against localhost outlives the run and serves the
        # next one a stale bundle. Upstream's run mode substitutes null too.
        asserts.equals(env, "null", dev["builtins"]["flutter_service_worker_version"]["value"])

        # One template, read twice: a deprecated construct in it is one
        # mistake, and reporting it once is the difference between a clear
        # error and a doubled one.
        asserts.true(env, bootstrap["check_constructs"])
        asserts.true(env, index["check_constructs"])
        asserts.false(env, dev["check_constructs"])

    # Upstream substitutes an empty base href into the bootstrap and the real
    # one into index.html.
    asserts.equals(env, "", bootstrap["base_href"])
    asserts.equals(env, "/", index["base_href"])

    # Named from the target under test rather than written down, so the same
    # assertion serves every fixture instead of pinning one fixture's name.
    prefix = analysistest.target_under_test(env).label.name
    outputs = _template_action_outputs(env)
    for expected in [prefix + "_index.html", prefix + "_flutter_bootstrap.js"]:
        asserts.true(env, expected in outputs, "%s not declared: %s" % (expected, outputs))

    # The dev loop's bootstrap is declared only where there is a dev loop: it
    # names DDC output a release bundle does not contain.
    asserts.equals(
        env,
        expect_dev_loop_guard,
        prefix + "_dev_flutter_bootstrap.js" in outputs,
        "the dev bootstrap belongs to debug builds only: %s" % outputs,
    )

    # And the bundler is told to ship them under the names the page asks for.
    bundle = action_config(env, "FlutterWebBundle")
    if bundle != None:
        dsts = [c["dst"] for c in bundle["copies"]]
        for expected in ["index.html", "flutter_bootstrap.js"]:
            asserts.true(env, expected in dsts, "%s missing from bundle: %s" % (expected, dsts))

