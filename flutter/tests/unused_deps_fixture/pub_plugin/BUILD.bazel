load("//flutter:defs.bzl", "dart_package_metadata", "flutter_plugin_platform")
load("//flutter/private:flutter_pub_library.bzl", "flutter_pub_library", "flutter_pub_member")

# A pub plugin as the hub generates it: its member, and the library of its
# dependency cycle that `@deps//:<name>` names.
dart_package_metadata(
    name = "pubspec-metadata",
    package_name = "unused_deps_pub_plugin",
)

flutter_plugin_platform(
    name = "web",
    platform = "web",
    plugin_class = "PubPlugin",
)

flutter_pub_member(
    name = "member",
    srcs = ["lib/pub_plugin.dart"],
    package = ":pubspec-metadata",
    platforms = [":web"],
    visibility = ["//flutter/tests/unused_deps_fixture:__pkg__"],
)

flutter_pub_library(
    name = "pub_plugin",
    members = [":member"],
    visibility = ["//flutter/tests/unused_deps_fixture:__pkg__"],
)

# The same package without `platforms`, and bundling nothing: no plugin.
flutter_pub_member(
    name = "plain_member",
    srcs = ["lib/pub_plugin.dart"],
    package = ":pubspec-metadata",
)

flutter_pub_library(
    name = "plain",
    members = [":plain_member"],
    visibility = ["//flutter/tests/unused_deps_fixture:__pkg__"],
)
