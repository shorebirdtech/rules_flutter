load("//flutter:defs.bzl", "flutter_library")

package(default_visibility = ["//flutter/tests:__pkg__"])

# A pub package's contribution: one asset for every build, one for the paid flavor.
flutter_library(
    name = "flavor_lib",
    package_name = "flavor_test_lib",
    srcs = ["flavor_pkg.dart"],
    pkg_asset_flavors = {"assets/paid.txt": ["paid"]},
    pkg_assets = {
        ":all.txt": "assets/all.txt",
        ":paid.txt": "assets/paid.txt",
    },
    tags = ["manual"],
)
