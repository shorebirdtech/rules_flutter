# A package really fetched, reached through the hub that lists it, says what it
# is: the purl of its lock entry (`pubspec.lock`'s `args`), in a
# `package_metadata` its repository's `REPO.bazel` attaches to every target.
package_metadata_files(
    name = "fetched_package_metadata",
    deps = ["@dev_tool_deps//:args"],
)

# The test reads the purls of a closure, for the e2e workspaces with packages
# of kinds this one has none of (plugins, overlays, path packages).
exports_files(["fetched_purls_test.dart"])

dart_test(
    name = "fetched_purls_test",
    size = "small",
    data = [":fetched_package_metadata"],
    env = {
        "PACKAGE_METADATA": "$(rlocationpaths :fetched_package_metadata)",
        "PURLS": "pkg:pub/args@2.7.0?checksum=sha256:d0481093c50b1da8910eb0bb301626d4d8eb7284aa739614d2b394ee09e3ea04",
    },
    main = "fetched_purls_test.dart",
    deps = ["@rules_dart//dart/runfiles"],
)

