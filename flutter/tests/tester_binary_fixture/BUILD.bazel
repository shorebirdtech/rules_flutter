load("@rules_dart//dart:defs.bzl", "dart_package_metadata")
load("//flutter:defs.bzl", "flutter_tester_binary")

# A constraint no execution platform has, standing in for the Apple ones an
# app's Mac platform carries.
constraint_setting(name = "app_only")

constraint_value(
    name = "app_only_value",
    constraint_setting = ":app_only",
)

platform(
    name = "app_mac",
    constraint_values = [":app_only_value"],
    parents = ["//flutter/platforms:macos_arm64"],
    visibility = ["//flutter/tests:__pkg__"],
)

dart_package_metadata(
    name = "pubspec-metadata",
    package_name = "tester_binary",
)

# Left `manual`; only the analysistest builds it.
flutter_tester_binary(
    name = "tester_binary",
    main = "main.dart",
    package = ":pubspec-metadata",
    tags = ["manual"],
    visibility = ["//flutter/tests:__pkg__"],
    deps = ["//flutter/tests/dart_asset_fixture:fake_test_api"],
)
