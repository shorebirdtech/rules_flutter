load("@rules_dart//dart:defs.bzl", "dart_package_metadata")
load("//flutter:defs.bzl", "flutter_library", "flutter_plugin")
load("//flutter/tests:flutter_fonts_test.bzl", "assets_owner_test", "font_mismatch_fails_test", "fonts_bundled_test")

dart_package_metadata(
    name = "two_fonts_pubspec",
    package_name = "two_fonts",
)

flutter_library(
    name = "two_fonts",
    srcs = ["lib/fixture.dart"],
    font_files = {
        "fonts/Bold.ttf": "fonts/Bold.ttf",
        "fonts/Regular.ttf": "fonts/Regular.ttf",
    },
    fonts_json = '[{"family":"F","fonts":[{"asset":"fonts/Regular.ttf"},{"asset":"fonts/Bold.ttf","weight":700}]}]',
    package = ":two_fonts_pubspec",
    tags = ["manual"],
)

fonts_bundled_test(
    name = "two_fonts_test",
    size = "small",
    files = {
        "packages/two_fonts/fonts/Bold.ttf": "fonts/Bold.ttf",
        "packages/two_fonts/fonts/Regular.ttf": "fonts/Regular.ttf",
    },
    manifest = '[{"family":"packages/two_fonts/F","fonts":[{"asset":"packages/two_fonts/fonts/Regular.ttf"},{"asset":"packages/two_fonts/fonts/Bold.ttf","weight":700}]}]',
    target_under_test = ":two_fonts",
)

# In a program of the library's own package (its own `flutter_test`, say) the
# fonts are the program's: the family and the files are bare, as the
# package's pubspec declares them.
fonts_bundled_test(
    name = "two_fonts_own_package_test",
    size = "small",
    files = {
        "fonts/Bold.ttf": "fonts/Bold.ttf",
        "fonts/Regular.ttf": "fonts/Regular.ttf",
    },
    manifest = '[{"family":"F","fonts":[{"asset":"fonts/Regular.ttf"},{"asset":"fonts/Bold.ttf","weight":700}]}]',
    own_package = True,
    target_under_test = ":two_fonts",
)

# No `package_name`: the Dart package name derived from the BUILD file's path
# is the one the fonts and `assets` are bundled under.
flutter_library(
    name = "derived_name",
    srcs = ["lib/fixture.dart"],
    assets = ["fonts/Bold.ttf"],
    font_files = {"fonts/Regular.ttf": "fonts/Regular.ttf"},
    fonts_json = '[{"family":"F","fonts":[{"asset":"fonts/Regular.ttf"}]}]',
    tags = ["manual"],
)

fonts_bundled_test(
    name = "derived_name_test",
    size = "small",
    files = {"packages/fonts_fixture/fonts/Regular.ttf": "fonts/Regular.ttf"},
    manifest = '[{"family":"packages/fonts_fixture/F","fonts":[{"asset":"packages/fonts_fixture/fonts/Regular.ttf"}]}]',
    target_under_test = ":derived_name",
)

assets_owner_test(
    name = "derived_name_assets_test",
    size = "small",
    assets = ["fonts_fixture:fonts/Bold.ttf"],
    target_under_test = ":derived_name",
)

dart_package_metadata(
    name = "font_of_other_package_pubspec",
    package_name = "font_of_other_package",
)

# A font of another package keeps that package's path; only the family is this
# package's, which is what flutter_tools writes to FontManifest.json.
flutter_library(
    name = "font_of_other_package",
    srcs = ["lib/fixture.dart"],
    font_files = {"//flutter/tests/fonts_fixture/other:fonts/Other.ttf": "packages/other/fonts/Other.ttf"},
    fonts_json = '[{"family":"F","fonts":[{"asset":"packages/other/fonts/Other.ttf"}]}]',
    package = ":font_of_other_package_pubspec",
    tags = ["manual"],
)

fonts_bundled_test(
    name = "font_of_other_package_test",
    size = "small",
    files = {"packages/other/fonts/Other.ttf": "other/fonts/Other.ttf"},
    manifest = '[{"family":"packages/font_of_other_package/F","fonts":[{"asset":"packages/other/fonts/Other.ttf"}]}]',
    target_under_test = ":font_of_other_package",
)

# The other package's font keeps its path in the declaring package's own
# program too; only the family is bare there.
fonts_bundled_test(
    name = "font_of_other_package_own_package_test",
    size = "small",
    files = {"packages/other/fonts/Other.ttf": "other/fonts/Other.ttf"},
    manifest = '[{"family":"F","fonts":[{"asset":"packages/other/fonts/Other.ttf"}]}]',
    own_package = True,
    target_under_test = ":font_of_other_package",
)

dart_package_metadata(
    name = "own_packages_directory_pubspec",
    package_name = "own_packages_directory",
)

# A file of this package at that literal path is this package's own font.
flutter_library(
    name = "own_packages_directory",
    srcs = ["lib/fixture.dart"],
    font_files = {"packages/other/fonts/Own.ttf": "packages/other/fonts/Own.ttf"},
    fonts_json = '[{"family":"F","fonts":[{"asset":"packages/other/fonts/Own.ttf"}]}]',
    package = ":own_packages_directory_pubspec",
    tags = ["manual"],
)

fonts_bundled_test(
    name = "own_packages_directory_test",
    size = "small",
    files = {"packages/own_packages_directory/packages/other/fonts/Own.ttf": "packages/other/fonts/Own.ttf"},
    manifest = '[{"family":"packages/own_packages_directory/F","fonts":[{"asset":"packages/own_packages_directory/packages/other/fonts/Own.ttf"}]}]',
    target_under_test = ":own_packages_directory",
)

dart_package_metadata(
    name = "first_of_two_missing_pubspec",
    package_name = "first_of_two_missing",
)

# The first of two fonts has no file, so the second must not take its place.
flutter_library(
    name = "first_of_two_missing",
    srcs = ["lib/fixture.dart"],
    font_files = {"fonts/Bold.ttf": "fonts/Bold.ttf"},
    fonts_json = '[{"family":"F","fonts":[{"asset":"fonts/Regular.ttf"},{"asset":"fonts/Bold.ttf","weight":700}]}]',
    package = ":first_of_two_missing_pubspec",
    tags = ["manual"],
)

font_mismatch_fails_test(
    name = "first_of_two_missing_test",
    size = "small",
    message = "names font asset \"fonts/Regular.ttf\" but font_files does not provide it",
    target_under_test = ":first_of_two_missing",
)

dart_package_metadata(
    name = "plugin_missing_font_pubspec",
    package_name = "plugin_missing_font",
)

flutter_plugin(
    name = "plugin_missing_font",
    srcs = ["lib/fixture.dart"],
    fonts_json = '[{"family":"F","fonts":[{"asset":"fonts/Regular.ttf"}]}]',
    package = ":plugin_missing_font_pubspec",
    plugin_platforms_json = '{"web":{"pluginClass":"FixturePlugin"}}',
    tags = ["manual"],
)

font_mismatch_fails_test(
    name = "plugin_missing_font_test",
    size = "small",
    message = "names font asset \"fonts/Regular.ttf\" but font_files does not provide it",
    target_under_test = ":plugin_missing_font",
)

dart_package_metadata(
    name = "undeclared_file_pubspec",
    package_name = "undeclared_file",
)

# A file listed for a font nobody declared would never reach the bundle.
flutter_library(
    name = "undeclared_file",
    srcs = ["lib/fixture.dart"],
    font_files = {
        "fonts/Bold.ttf": "fonts/Bold.ttf",
        "fonts/Regular.ttf": "fonts/Regular.ttf",
    },
    fonts_json = '[{"family":"F","fonts":[{"asset":"fonts/Regular.ttf"}]}]',
    package = ":undeclared_file_pubspec",
    tags = ["manual"],
)

font_mismatch_fails_test(
    name = "undeclared_file_test",
    size = "small",
    message = "font_files provides font asset \"fonts/Bold.ttf\" but fonts_json does not name it",
    target_under_test = ":undeclared_file",
)

dart_package_metadata(
    name = "files_without_fonts_json_pubspec",
    package_name = "files_without_fonts_json",
)

flutter_library(
    name = "files_without_fonts_json",
    srcs = ["lib/fixture.dart"],
    font_files = {"fonts/Bold.ttf": "fonts/Bold.ttf"},
    package = ":files_without_fonts_json_pubspec",
    tags = ["manual"],
)

font_mismatch_fails_test(
    name = "files_without_fonts_json_test",
    size = "small",
    message = "font_files provides font asset \"fonts/Bold.ttf\" but fonts_json does not name it",
    target_under_test = ":files_without_fonts_json",
)

dart_package_metadata(
    name = "two_files_for_one_font_pubspec",
    package_name = "two_files_for_one_font",
)

flutter_library(
    name = "two_files_for_one_font",
    srcs = ["lib/fixture.dart"],
    font_files = {
        "fonts/Bold.ttf": "fonts/Regular.ttf",
        "fonts/Regular.ttf": "fonts/Regular.ttf",
    },
    fonts_json = '[{"family":"F","fonts":[{"asset":"fonts/Regular.ttf"}]}]',
    package = ":two_files_for_one_font_pubspec",
    tags = ["manual"],
)

font_mismatch_fails_test(
    name = "two_files_for_one_font_test",
    size = "small",
    message = "font_files lists two files for font asset \"fonts/Regular.ttf\"",
    target_under_test = ":two_files_for_one_font",
)
