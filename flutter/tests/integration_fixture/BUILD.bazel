load("@rules_dart//dart:defs.bzl", "dart_package_metadata")
load("//flutter:integration_test.bzl", "flutter_android_app_integration_test", "flutter_android_device_runner", "flutter_android_emulator_runner", "flutter_android_system_image", "flutter_application_variant", "flutter_chrome_runner", "flutter_desktop_app_integration_test", "flutter_integration_bootstrap", "flutter_ios_app_integration_test", "flutter_ios_simulator_runner", "flutter_web_app_integration_test")
load("//flutter:web.bzl", "flutter_web_bundle")
load("//flutter/tests:fake_android_sdk.bzl", "fake_android_sdk")
load("//flutter/tests:flutter_integration_test_test.bzl", "android_probe_targets", "stub_golden_service", "stub_runner")

package(default_visibility = ["//flutter/tests:__subpackages__"])

flutter_integration_bootstrap(
    name = "bootstrap",
    src = "test/a_test.dart",
    tags = ["manual"],
)

flutter_integration_bootstrap(
    name = "bootstrap_with_config",
    src = "test/a_test.dart",
    tags = ["manual"],
    test_config = "test/flutter_test_config.dart",
)

# What a web program's bootstrap imports the test by.
flutter_integration_bootstrap(
    name = "bootstrap_relative",
    src = "test/a_test.dart",
    src_import = "relative",
    tags = ["manual"],
    test_config = "test/flutter_test_config.dart",
)

# A bootstrap given deps without a package its program needs.
flutter_integration_bootstrap(
    name = "bootstrap_missing_a_package",
    src = "test/a_test.dart",
    requires_packages = ["integration_test"],
    tags = ["manual"],
)

stub_runner(
    name = "web_runner",
    family = "web",
    tags = ["manual"],
)

flutter_desktop_app_integration_test(
    name = "desktop_test",
    src = "test/a_test.dart",
    app = "//flutter/tests/variant_fixture/app",
    env = {"FIXTURE_KEY": "fixture value"},
    tags = ["manual"],
)

stub_golden_service(
    name = "golden_service",
    tags = ["manual"],
)

# A test given the comparator of its goldens, and the source they are relative to.
flutter_desktop_app_integration_test(
    name = "desktop_test_with_goldens",
    src = "test/a_test.dart",
    app = "//flutter/tests/variant_fixture/app",
    golden_service = ":golden_service",
    tags = ["manual"],
)

# A test given tag selectors.
flutter_desktop_app_integration_test(
    name = "desktop_test_with_tags",
    src = "test/a_test.dart",
    app = "//flutter/tests/variant_fixture/app",
    exclude_tags = ["flaky"],
    include_tags = [
        "a",
        "b || c",
    ],
    tags = ["manual"],
)

# A test given an empty tag selector.
flutter_desktop_app_integration_test(
    name = "desktop_test_with_an_empty_tag",
    src = "test/a_test.dart",
    app = "//flutter/tests/variant_fixture/app",
    include_tags = [""],
    tags = ["manual"],
)

# A test given a runner of another family.
flutter_desktop_app_integration_test(
    name = "desktop_test_on_a_web_runner",
    src = "test/a_test.dart",
    app = "//flutter/tests/variant_fixture/app",
    runner = ":web_runner",
    tags = ["manual"],
)

# A program that needs a package no dependency brings, and one that has it.
flutter_application_variant(
    name = "program_missing_a_package",
    application = "//flutter/tests/variant_fixture/app",
    main = "test/a_test.dart",
    requires_packages = ["integration_test"],
    tags = ["manual"],
)

flutter_application_variant(
    name = "program_with_its_packages",
    application = "//flutter/tests/variant_fixture/app",
    main = "test/a_test.dart",
    requires_packages = ["variant_base_plugin"],
    tags = ["manual"],
)

# A browser shaped as the Chrome for Testing repository's: an executable, with
# what it needs beside it as `data`.
filegroup(
    name = "fake_chrome",
    srcs = ["fake_chrome/chrome-headless-shell"],
    data = ["fake_chrome/resources.pak"],
    tags = ["manual"],
)

flutter_chrome_runner(
    name = "chrome_runner",
    chrome = ":fake_chrome",
    tags = ["manual"],
)

dart_package_metadata(
    name = "pubspec",
    package_name = "integration_fixture",
)

# A web bundle run by the web test rule, in the fake browser.
flutter_web_bundle(
    name = "web_app",
    main = "test/a_test.dart",
    package = ":pubspec",
    tags = ["manual"],
)

flutter_web_app_integration_test(
    name = "web_test",
    src = "test/a_test.dart",
    app = ":web_app",
    runner = ":chrome_runner",
    tags = ["manual"],
)

# A web bundle with a file a rule wrote beside the user's, whose imports are not
# checked against the bundle's `deps`.
flutter_web_bundle(
    name = "web_unchecked",
    srcs = ["test/b_test.dart"],
    main = "test/a_test.dart",
    package = ":pubspec",
    tags = ["manual"],
    unchecked_srcs = ["test/flutter_test_config.dart"],
)

# An SDK shaped as rules_android's: its `adb` is a different file on Windows.
fake_android_sdk(
    name = "fake_android_sdk",
    adb = select({
        "@platforms//os:windows": "fake_sdk/platform-tools/adb.exe",
        "//conditions:default": "fake_sdk/platform-tools/adb",
    }),
    tags = ["manual"],
)

flutter_android_device_runner(
    name = "android_runner",
    sdk = ":fake_android_sdk",
    tags = ["manual"],
)

flutter_android_app_integration_test(
    name = "android_test",
    src = "test/a_test.dart",
    app = "//flutter/tests/variant_fixture/app",
    runner = ":android_runner",
    tags = ["manual"],
)

# An environment, which an app on a device cannot be given.
flutter_android_app_integration_test(
    name = "android_test_with_env",
    src = "test/a_test.dart",
    app = "//flutter/tests/variant_fixture/app",
    env = {"FIXTURE_KEY": "fixture value"},
    runner = ":android_runner",
    tags = ["manual"],
)

# A runner of another family.
flutter_android_app_integration_test(
    name = "android_test_on_a_desktop_runner",
    src = "test/a_test.dart",
    app = "//flutter/tests/variant_fixture/app",
    runner = "//flutter/integration_test:desktop",
    tags = ["manual"],
)

# An emulator, shaped as the pinned one's repository: the launcher, carrying
# the rest of the emulator.
filegroup(
    name = "fake_emulator",
    srcs = ["fake_emulator/emulator/emulator"],
    data = glob(["fake_emulator/**"]),
    tags = ["manual"],
)

flutter_android_system_image(
    name = "fake_x86_64_image",
    abi = "x86_64",
    api_level = 35,
    files = ["fake_image/system.img"],
    properties = "fake_image/source.properties",
    tag = "aosp_atd",
    tags = ["manual"],
)

flutter_android_emulator_runner(
    name = "emulator_runner",
    emulator = ":fake_emulator",
    sdk = ":fake_android_sdk",
    system_image = ":fake_x86_64_image",
    tags = ["manual"],
)

flutter_android_app_integration_test(
    name = "android_emulator_test",
    src = "test/a_test.dart",
    abi = "x86_64",
    app = "//flutter/tests/variant_fixture/app",
    runner = ":emulator_runner",
    tags = ["manual"],
)

# An app of an ABI the emulator's image does not run.
flutter_android_app_integration_test(
    name = "android_emulator_test_of_another_abi",
    src = "test/a_test.dart",
    abi = "arm64-v8a",
    app = "//flutter/tests/variant_fixture/app",
    runner = ":emulator_runner",
    tags = ["manual"],
)

# The pinned emulator and system image of the host, which the default runner
# of an Android test boots.
flutter_android_emulator_runner(
    name = "pinned_emulator_runner",
    emulator = "//flutter/integration_test:android_emulator",
    linux_runtime = select({
        "//flutter/integration_test:linux_x64": "@flutter_linux_runtime_amd64//:runtime",
        "//conditions:default": None,
    }),
    sdk = ":fake_android_sdk",
    system_image = "//flutter/integration_test:android_system_image",
    tags = ["manual"],
)

# What the Android test builds its app as, for each ABI it takes.
android_probe_targets(
    name = "built_for_arm64_v8a",
    abi = "arm64-v8a",
)

android_probe_targets(
    name = "built_for_x86_64",
    abi = "x86_64",
)

# A simulator runner as the default is, and one that names its device and cores.
flutter_ios_simulator_runner(
    name = "ios_runner",
    tags = ["manual"],
)

flutter_ios_simulator_runner(
    name = "ios_named_runner",
    cpus = 3,
    device_type = "iPad (10th generation)",
    runtime = "com.apple.CoreSimulator.SimRuntime.iOS-18-0",
    tags = ["manual"],
)

flutter_ios_app_integration_test(
    name = "ios_test",
    src = "test/a_test.dart",
    app = "//flutter/tests/variant_fixture/app",
    runner = ":ios_runner",
    tags = ["manual"],
)

# An environment, which an app on a simulator cannot be given.
flutter_ios_app_integration_test(
    name = "ios_test_with_env",
    src = "test/a_test.dart",
    app = "//flutter/tests/variant_fixture/app",
    env = {"FIXTURE_KEY": "fixture value"},
    runner = ":ios_runner",
    tags = ["manual"],
)

# A runner of another family.
flutter_ios_app_integration_test(
    name = "ios_test_on_a_desktop_runner",
    src = "test/a_test.dart",
    app = "//flutter/tests/variant_fixture/app",
    runner = "//flutter/integration_test:desktop",
    tags = ["manual"],
)
