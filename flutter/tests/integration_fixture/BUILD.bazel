load("//flutter:integration_test.bzl", "flutter_android_app_integration_test", "flutter_android_device_runner", "flutter_application_variant", "flutter_chrome_runner", "flutter_desktop_integration_test", "flutter_integration_bootstrap", "flutter_web_bundle_integration_test")
load("//flutter:web.bzl", "flutter_web_bundle")
load("//flutter/tests:flutter_integration_test_test.bzl", "android_probe_targets", "stub_runner")

package(default_visibility = ["//flutter/tests:__subpackages__"])

flutter_integration_bootstrap(
    name = "bootstrap",
    src = "test/a_test.dart",
    tags = ["manual"],
)

flutter_integration_bootstrap(
    name = "bootstrap_with_config",
    src = "test/a_test.dart",
    tags = ["manual"],
    test_config = "test/flutter_test_config.dart",
)

# What a web program's bootstrap imports the test by.
flutter_integration_bootstrap(
    name = "bootstrap_relative",
    src = "test/a_test.dart",
    src_import = "relative",
    tags = ["manual"],
    test_config = "test/flutter_test_config.dart",
)

# A bootstrap given deps without a package its program needs.
flutter_integration_bootstrap(
    name = "bootstrap_missing_a_package",
    src = "test/a_test.dart",
    requires_packages = ["integration_test"],
    tags = ["manual"],
)

stub_runner(
    name = "web_runner",
    family = "web",
    tags = ["manual"],
)

flutter_desktop_integration_test(
    name = "desktop_test",
    app = "//flutter/tests/variant_fixture/app",
    env = {"FIXTURE_KEY": "fixture value"},
    tags = ["manual"],
)

# A test given a runner of another family.
flutter_desktop_integration_test(
    name = "desktop_test_on_a_web_runner",
    app = "//flutter/tests/variant_fixture/app",
    runner = ":web_runner",
    tags = ["manual"],
)

# A program that needs a package no dependency brings, and one that has it.
flutter_application_variant(
    name = "program_missing_a_package",
    application = "//flutter/tests/variant_fixture/app",
    main = "test/a_test.dart",
    requires_packages = ["integration_test"],
    tags = ["manual"],
)

flutter_application_variant(
    name = "program_with_its_packages",
    application = "//flutter/tests/variant_fixture/app",
    main = "test/a_test.dart",
    requires_packages = ["variant_base_plugin"],
    tags = ["manual"],
)

# A browser shaped as the Chrome for Testing repository's: an executable, with
# what it needs beside it as `data`.
filegroup(
    name = "fake_chrome",
    srcs = ["fake_chrome/chrome-headless-shell"],
    data = ["fake_chrome/resources.pak"],
    tags = ["manual"],
)

flutter_chrome_runner(
    name = "chrome_runner",
    chrome = ":fake_chrome",
    tags = ["manual"],
)

# A web bundle run by the web test rule, in the fake browser.
flutter_web_bundle(
    name = "web_app",
    package_name = "integration_fixture",
    main = "test/a_test.dart",
    tags = ["manual"],
)

flutter_web_bundle_integration_test(
    name = "web_test",
    app = ":web_app",
    runner = ":chrome_runner",
    tags = ["manual"],
)

# A web bundle with a file a rule wrote beside the user's, whose imports are not
# checked against the bundle's `deps`.
flutter_web_bundle(
    name = "web_unchecked",
    package_name = "integration_fixture",
    srcs = ["test/b_test.dart"],
    main = "test/a_test.dart",
    tags = ["manual"],
    unchecked_srcs = ["test/flutter_test_config.dart"],
)

# An `adb` shaped as the SDK's: a file, in a directory that stands for the SDK.
flutter_android_device_runner(
    name = "android_runner",
    adb = "fake_sdk/platform-tools/adb",
    tags = ["manual"],
)

flutter_android_app_integration_test(
    name = "android_test",
    app = "//flutter/tests/variant_fixture/app",
    runner = ":android_runner",
    tags = ["manual"],
)

# An environment, which an app on a device cannot be given.
flutter_android_app_integration_test(
    name = "android_test_with_env",
    app = "//flutter/tests/variant_fixture/app",
    env = {"FIXTURE_KEY": "fixture value"},
    runner = ":android_runner",
    tags = ["manual"],
)

# A runner of another family.
flutter_android_app_integration_test(
    name = "android_test_on_a_desktop_runner",
    app = "//flutter/tests/variant_fixture/app",
    runner = "//flutter/integration_test:desktop",
    tags = ["manual"],
)

# What the Android test builds its app as, for each ABI it takes.
android_probe_targets(
    name = "built_for_arm64_v8a",
    abi = "arm64-v8a",
)

android_probe_targets(
    name = "built_for_x86_64",
    abi = "x86_64",
)
