load("@rules_dart//dart:defs.bzl", "dart_package_metadata")
load("//flutter:defs.bzl", "flutter_test")

dart_package_metadata(
    name = "plain_pubspec",
    package_name = "plain",
)

# Left `manual`; only the analysis tests build them.
flutter_test(
    name = "plain",
    main = "main.dart",
    package = ":plain_pubspec",
    tags = ["manual"],
    visibility = ["//flutter/tests:__pkg__"],
    deps = ["//flutter/tests/dart_asset_fixture:fake_test_api"],
)

dart_package_metadata(
    name = "tagged_pubspec",
    package_name = "tagged",
)

flutter_test(
    name = "tagged",
    exclude_tags = ["flaky"],
    include_tags = [
        "a",
        "b || c",
    ],
    main = "main.dart",
    package = ":tagged_pubspec",
    tags = ["manual"],
    visibility = ["//flutter/tests:__pkg__"],
    deps = ["//flutter/tests/dart_asset_fixture:fake_test_api"],
)

dart_package_metadata(
    name = "empty_entry_pubspec",
    package_name = "empty_entry",
)

flutter_test(
    name = "empty_entry",
    include_tags = [""],
    main = "main.dart",
    package = ":empty_entry_pubspec",
    tags = ["manual"],
    visibility = ["//flutter/tests:__pkg__"],
    deps = ["//flutter/tests/dart_asset_fixture:fake_test_api"],
)

dart_package_metadata(
    name = "comma_entry_pubspec",
    package_name = "comma_entry",
)

flutter_test(
    name = "comma_entry",
    include_tags = ["a,b"],
    main = "main.dart",
    package = ":comma_entry_pubspec",
    tags = ["manual"],
    visibility = ["//flutter/tests:__pkg__"],
    deps = ["//flutter/tests/dart_asset_fixture:fake_test_api"],
)
