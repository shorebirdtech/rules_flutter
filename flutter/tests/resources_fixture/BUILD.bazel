load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@rules_dart//dart:defs.bzl", "dart_package_metadata")
load("//flutter:defs.bzl", "flutter_library", "flutter_plugin")
load("//flutter/tests:dart_resources_test.bzl", "dart_in_resources_fails_test", "missing_font_fails_test", "resources_probe")

dart_package_metadata(
    name = "resources_fixture_pubspec",
    package_name = "resources_fixture",
)

# A library whose lib/ holds a Dart source, a YAML file, and a shader. The
# shader is deliberately listed on BOTH channels: `resources` says it is part
# of the package's lib/ tree (package:-URI addressable, staged wherever the
# whole package is), `shaders` says it is compiled and bundled into
# flutter_assets. The two have different destinations, so a lib/ shader is
# legitimately both — this fixture pins that coexistence.
flutter_library(
    name = "resources_library",
    srcs = ["lib/fixture.dart"],
    package = ":resources_fixture_pubspec",
    resources = [
        "lib/data.yaml",
        "lib/glow.frag",
    ],
    shaders = ["lib/glow.frag"],
    # The path-mapping test compiles this library's shader.
    visibility = ["//flutter/tests:__pkg__"],
)

dart_package_metadata(
    name = "resources_plugin_pubspec",
    package_name = "resources_plugin",
)

flutter_plugin(
    name = "resources_plugin",
    srcs = ["lib/fixture.dart"],
    package = ":resources_plugin_pubspec",
    plugin_platforms_json = '{"web":{"pluginClass":"FixturePlugin"}}',
    resources = ["lib/data.yaml"],
)

resources_probe(
    name = "library_resources_probe",
    expected_basenames = [
        "data.yaml",
        "glow.frag",
    ],
    deps = [":resources_library"],
)

resources_probe(
    name = "plugin_resources_probe",
    expected_basenames = ["data.yaml"],
    deps = [":resources_plugin"],
)

build_test(
    name = "resources_probe_test",
    size = "small",
    targets = [
        ":library_resources_probe",
        ":plugin_resources_probe",
    ],
)

dart_package_metadata(
    name = "dart_in_resources_pubspec",
    package_name = "dart_in_resources",
)

# Mis-filed Dart source: refused, mirroring dart_library.
flutter_library(
    name = "dart_in_resources_library",
    srcs = ["lib/fixture.dart"],
    package = ":dart_in_resources_pubspec",
    resources = ["lib/fixture.dart"],
    tags = ["manual"],
)

dart_package_metadata(
    name = "dart_in_resources_plugin_pubspec",
    package_name = "dart_in_resources_plugin",
)

flutter_plugin(
    name = "dart_in_resources_plugin",
    srcs = ["lib/fixture.dart"],
    package = ":dart_in_resources_plugin_pubspec",
    plugin_platforms_json = '{"web":{"pluginClass":"FixturePlugin"}}',
    resources = ["lib/fixture.dart"],
    tags = ["manual"],
)

dart_in_resources_fails_test(
    name = "dart_in_resources_library_test",
    size = "small",
    target_under_test = ":dart_in_resources_library",
)

dart_in_resources_fails_test(
    name = "dart_in_resources_plugin_test",
    size = "small",
    target_under_test = ":dart_in_resources_plugin",
)

dart_package_metadata(
    name = "missing_font_pubspec",
    package_name = "missing_font",
)

# fonts_json names a font that font_files does not provide.
flutter_library(
    name = "missing_font_library",
    srcs = ["lib/fixture.dart"],
    fonts_json = '[{"family":"Missing","fonts":[{"asset":"assets/fonts/Missing.ttf"}]}]',
    package = ":missing_font_pubspec",
    tags = ["manual"],
)

missing_font_fails_test(
    name = "missing_font_library_test",
    size = "small",
    target_under_test = ":missing_font_library",
)
