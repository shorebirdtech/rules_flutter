"""Plugin `rusty`, whose macOS and Linux libraries its own build makes, as `flutter_pub_package` writes one."""

load("@rules_dart//dart:defs.bzl", "dart_package_metadata")
load("//flutter:defs.bzl", "flutter_plugin")
load("//flutter/private:unbuilt_native_code.bzl", "flutter_unbuilt_plugin_library")

package(default_visibility = ["//flutter/tests:__subpackages__"])

flutter_unbuilt_plugin_library(
    name = "rusty_apple_macos",
    message = "package:rusty 1.0 builds native code for macOS with cargokit",
    tags = ["manual"],
)

flutter_unbuilt_plugin_library(
    name = "rusty_linux",
    message = "package:rusty 1.0 builds native code for Linux with cargokit",
    tags = ["manual"],
)

dart_package_metadata(
    name = "pubspec",
    package_name = "rusty",
)

flutter_plugin(
    name = "rusty",
    srcs = ["lib/rusty.dart"],
    apple_libs = [":rusty_apple_macos"],
    linux_libs = [":rusty_linux"],
    package = ":pubspec",
    tags = ["manual"],
)
