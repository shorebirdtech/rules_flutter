"""The packages that own the fixture's code assets: one package built by a
Flutter package rule and by a Dart package rule that knows nothing of Flutter,
a rule that forwards a package under an attribute of its own name, and one that
makes its asset with no target of its own. Each reaches its own application
only, so sharing a root is not a conflict. `bare_owner/` is the bare control,
and `owner_twin/` the first package again, its asset bare."""

load("@rules_dart//dart:defs.bzl", "dart_library")
load("//flutter:defs.bzl", "dart_package_metadata", "flutter_plugin")
load("//flutter/tests/code_asset_fixture:forwarding_package.bzl", "forwarding_package")
load("//flutter/tests/code_asset_fixture:inline_asset_package.bzl", "inline_asset_package")

package(default_visibility = [
    "//flutter/tests/code_asset_fixture:__pkg__",
    "//flutter/tests/code_asset_fixture/test:__pkg__",
])

dart_package_metadata(
    name = "pubspec-metadata",
    package_name = "code_asset_owner",
    code_assets = ["//flutter/tests/code_asset_fixture:wrapped"],
)

dart_library(
    name = "dart_owner",
    srcs = ["lib/owner.dart"],
    package = ":pubspec-metadata",
)

flutter_plugin(
    name = "plugin_owner",
    srcs = ["lib/owner.dart"],
    package = ":pubspec-metadata",
    platforms = [
        "android",
        "ios",
        "linux",
        "macos",
        "windows",
    ],
)

forwarding_package(
    name = "forwarded_owner",
    exports = [":dart_owner"],
)

inline_asset_package(
    name = "inline_owner",
    package_name = "inline_owner",
    library = "//flutter/tests/code_asset_fixture:library",
)
