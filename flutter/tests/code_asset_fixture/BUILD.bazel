"""A native library delivered as a Dart code asset, wrapped and bare.

The wrapper — `flutter_native_library` over a target providing
`DartCodeAssetInfo` — is what tells a debug app's dev config the library's
binding contract and the dev tool its patch builder. It sits in the owning
package's `code_assets` (see `owner/`), and the owner is a plain `dart_library`
in one app and a `flutter_plugin` in another: the application has to find it
either way, and when a rule forwards the owner under an attribute of its own
name. The bare asset is the control, with a library and no contract. The inline
owner makes its asset with no target of its own, so nothing describes it.
"""

load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("//flutter:defs.bzl", "dart_package_metadata", "flutter_application", "flutter_native_library")
load("//flutter:integration_test.bzl", "flutter_application_variant")
load(":stand_in_code_asset.bzl", "stand_in_code_asset")

package(default_visibility = [
    "//flutter/tests:__pkg__",
    "//flutter/tests/code_asset_fixture/bare_owner:__pkg__",
    "//flutter/tests/code_asset_fixture/owner:__pkg__",
    "//flutter/tests/code_asset_fixture/owner_twin:__pkg__",
])

_LIBRARY = "//flutter/tests/native_sources_fixture:bridge"

# The library for `owner/`'s inline owner, which takes it directly.
alias(
    name = "library",
    actual = _LIBRARY,
)

dart_package_metadata(
    name = "pubspec-metadata",
    package_name = "code_asset_app",
)

stand_in_code_asset(
    name = "code_asset",
    asset_id = "package:code_asset_owner/bridge",
    library = _LIBRARY,
)

write_file(
    name = "manifest",
    out = "bridge.hot_patch.json",
    content = ["{}"],
)

filegroup(
    name = "patcher",
    srcs = [":manifest"],
)

flutter_native_library(
    name = "wrapped",
    binding_contract = ["interface.json"],
    hot_patch = ":patcher",
    library = ":code_asset",
)

stand_in_code_asset(
    name = "bare_code_asset",
    asset_id = "package:bare_owner/bridge",
    library = _LIBRARY,
)

[
    flutter_application(
        name = "app_" + owner,
        main = "main.dart",
        package = ":pubspec-metadata",
        tags = ["manual"],
        deps = [package],
    )
    for owner, package in {
        "dart_owner": "//flutter/tests/code_asset_fixture/owner:dart_owner",
        "plugin_owner": "//flutter/tests/code_asset_fixture/owner:plugin_owner",
        "bare_owner": "//flutter/tests/code_asset_fixture/bare_owner",
        "forwarded_owner": "//flutter/tests/code_asset_fixture/owner:forwarded_owner",
        "inline_owner": "//flutter/tests/code_asset_fixture/owner:inline_owner",
    }.items()
]

# A variant of an application whose library arrives as a code asset: the
# variant bundles it as the application does.
flutter_application_variant(
    name = "variant_dart_owner",
    application = ":app_dart_owner",
    main = "variant_main.dart",
    tags = ["manual"],
)

# One library under one id, described by its wrapper and bare, by two copies of
# the package rooted apart.
flutter_application(
    name = "app_disagreeing_owners",
    main = "main.dart",
    package = ":pubspec-metadata",
    tags = ["manual"],
    deps = [
        "//flutter/tests/code_asset_fixture/owner:dart_owner",
        "//flutter/tests/code_asset_fixture/owner_twin:bare_twin_owner",
    ],
)

# A wrapper names one library for its contract to describe, and a code asset
# loaded from the system has none in the bundle.
stand_in_code_asset(
    name = "system_code_asset",
    asset_id = "package:code_asset_owner/system",
    link_mode = "dynamic_loading_system",
    uri = "libbridge.so.1",
)

flutter_native_library(
    name = "wrapped_system",
    binding_contract = ["interface.json"],
    library = ":system_code_asset",
    tags = ["manual"],
)
