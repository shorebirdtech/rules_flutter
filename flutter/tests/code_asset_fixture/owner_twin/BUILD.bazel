"""The package `code_asset_owner` a second time, rooted apart from `owner/`, as
two pub hubs can each supply one package: the same id and library as `owner/`'s,
bare where `owner/`'s is wrapped."""

load("@rules_dart//dart:defs.bzl", "dart_library", "dart_package_metadata")

package(default_visibility = ["//flutter/tests/code_asset_fixture:__pkg__"])

dart_package_metadata(
    name = "pubspec-metadata",
    package_name = "code_asset_owner",
    code_assets = ["//flutter/tests/code_asset_fixture:code_asset"],
)

dart_library(
    name = "bare_twin_owner",
    srcs = ["lib/owner.dart"],
    package = ":pubspec-metadata",
)
