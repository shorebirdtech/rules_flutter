load("@rules_dart//dart:defs.bzl", "dart_package_metadata")
load("//flutter:defs.bzl", "flutter_library")

exports_files(["pubspec.lock"])

dart_package_metadata(
    name = "pubspec",
    package_name = "integration_support_analysis",
)

# The integration-test support library, as a library so the analysis aspect
# reaches it. `flutter_integration_bootstrap` stages these files into each
# program as that program's own sources, which no analysis of a program checks,
# and they import packages of the user's pub hub, so they cannot be a library
# where they sit. This one resolves those packages from a hub of this repository.
flutter_library(
    name = "support",
    srcs = [
        "//flutter/private/integration_test/support:_channel.dart",
        "//flutter/private/integration_test/support:_channel_io.dart",
        "//flutter/private/integration_test/support:_channel_web.dart",
        "//flutter/private/integration_test/support:_golden.dart",
        "//flutter/private/integration_test/support:integration_suite.dart",
    ],
    package = ":pubspec",
    deps = [
        "@dev_tool_deps//:flutter_test",
        "@dev_tool_deps//:integration_test",
        "@dev_tool_deps//:stack_trace",
        "@dev_tool_deps//:stream_channel",
        "@dev_tool_deps//:test_api",
    ],
)
