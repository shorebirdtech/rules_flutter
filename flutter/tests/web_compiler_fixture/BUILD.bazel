load("//flutter:defs.bzl", "flutter_library", "flutter_native_library", "flutter_plugin")

# Things a web bundle may reach under two compilers at once, each with
# something generated for `web_compiler_test.bzl` to find the configuration of.
# `manual`: only that test builds them.

[
    genrule(
        name = "gen_" + name,
        outs = ["lib/%s.dart" % name],
        cmd = "echo 'const %s = 1;' > $@" % name,
        tags = ["manual"],
    )
    for name in [
        "library",
        "plugin",
        "independent_library",
        "independent_plugin",
    ]
]

genrule(
    name = "gen_native",
    outs = ["libnative.so"],
    cmd = "echo native > $@",
    tags = ["manual"],
)

flutter_native_library(
    name = "native_library",
    binding_contract = ["contract.txt"],
    library = ":gen_native",
    tags = ["manual"],
    visibility = ["//flutter/tests:__pkg__"],
)

# Not independent: it may `select()` by compiler, so it is built for each.
flutter_library(
    name = "library",
    package_name = "web_compiler_library",
    srcs = [":gen_library"],
    tags = ["manual"],
    visibility = ["//flutter/tests:__pkg__"],
)

flutter_plugin(
    name = "plugin",
    package_name = "web_compiler_plugin",
    srcs = [":gen_plugin"],
    tags = ["manual"],
    visibility = ["//flutter/tests:__pkg__"],
)

# As every package from pub is.
flutter_library(
    name = "independent_library",
    package_name = "web_compiler_independent_library",
    srcs = [":gen_independent_library"],
    tags = ["manual"],
    visibility = ["//flutter/tests:__pkg__"],
    web_compiler_independent = True,
)

flutter_plugin(
    name = "independent_plugin",
    package_name = "web_compiler_independent_plugin",
    srcs = [":gen_independent_plugin"],
    tags = ["manual"],
    visibility = ["//flutter/tests:__pkg__"],
    web_compiler_independent = True,
)
