"""File declaring metadata applying to all packages and targets in the Bazel module."""

repo(
    default_package_metadata = [
        "//:package_metadata",
    ],
)

# Not packages of this module, here or in a consumer's copy of it: the
# end-to-end workspaces, each its own Bazel project; the checkout's own state;
# and the packages that need a repo only development has.
ignore_directories([
    "bazel-*",
    ".claude",
    "e2e",
    "references",
    "tools/preset",
])
