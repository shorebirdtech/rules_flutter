# An app's `<name>_maven_artifacts` reports the Maven artifacts of the plugins
# that app depends on and no others, and that the install needs no artifact
# raised to align with another. The reports read the Gradle module metadata of
# the install's artifacts from a recorded snapshot rather than the install's
# Maven repositories, so the test needs no network.
_MAVEN_ARTIFACTS_REPORTS = [
    ":__package_info_only_android_maven_artifacts_report",
    ":__annotated_android_maven_artifacts_report",
    ":__plugin_android_maven_artifacts_report",
    ":annotated_android_maven_artifacts",
    ":package_info_only_android_maven_artifacts",
    ":plugin_android_maven_artifacts",
]

# The Kotlin of `annotated_plugin` compiles against `androidx.browser`, which
# nothing but its annotation gives it, so an APK of `annotated_app` links it.
build_test(
    name = "annotated_android_build_test",
    tags = ["android"],
    targets = [":annotated_arm64_build"],
)

dart_test(
    name = "verify_android_maven_artifacts_test",
    data = _MAVEN_ARTIFACTS_REPORTS + ["test/gradle_module_metadata.json"],
    env = {
        "ANNOTATED_REPORT": "$(rlocationpath :__annotated_android_maven_artifacts_report)",
        "ANNOTATED_REPORT_PROGRAM": "$(rlocationpath :annotated_android_maven_artifacts)",
        "ALL_PLUGINS_REPORT": "$(rlocationpath :__plugin_android_maven_artifacts_report)",
        "ALL_PLUGINS_REPORT_PROGRAM": "$(rlocationpath :plugin_android_maven_artifacts)",
        "ONE_PLUGIN_REPORT": "$(rlocationpath :__package_info_only_android_maven_artifacts_report)",
        "ONE_PLUGIN_REPORT_PROGRAM": "$(rlocationpath :package_info_only_android_maven_artifacts)",
        "SNAPSHOT": "$(rlocationpath test/gradle_module_metadata.json)",
    },
    main = "test/verify_android_maven_artifacts_test.dart",
    tags = ["android"],
    deps = ["@rules_dart//dart/runfiles"],
)

# Each report program, then its report, for gradle_module_metadata.dart.
_REPORT_ARGS = [
    "$(rlocationpath :plugin_android_maven_artifacts)",
    "$(rlocationpath :__plugin_android_maven_artifacts_report)",
    "$(rlocationpath :package_info_only_android_maven_artifacts)",
    "$(rlocationpath :__package_info_only_android_maven_artifacts_report)",
]

# Records the snapshot those reports read, from the live repositories, after a
# re-pin that changes what @rules_flutter_maven resolves:
#   bazel run //:record_gradle_module_metadata
dart_binary(
    name = "record_gradle_module_metadata",
    args = ["record"] + _REPORT_ARGS,
    data = _MAVEN_ARTIFACTS_REPORTS,
    main = "test/gradle_module_metadata.dart",
    deps = ["@rules_dart//dart/runfiles"],
)

# Whether the snapshot still matches the live repositories. In the `deep`
# tier (.bazelrc): it needs the network, and published metadata should never
# change.
dart_test(
    name = "gradle_module_metadata_live_test",
    args = [
        "check",
        "--snapshot=$(rlocationpath test/gradle_module_metadata.json)",
    ] + _REPORT_ARGS,
    data = _MAVEN_ARTIFACTS_REPORTS + ["test/gradle_module_metadata.json"],
    main = "test/gradle_module_metadata.dart",
    tags = [
        "android",
        "deep",
        "requires-network",
    ],
    deps = ["@rules_dart//dart/runfiles"],
)

# APK content verifier: asserts every plugin's native pieces are packaged —
# including package:jni's libdartjni.so (jnigen plugins load it via
# System.loadLibrary), its shared Java support classes, and that every
# packaged .so is ELF for the ABI of its directory. Verifies the arm64 APK
# (release), the -c dbg APK, asserting INTERNET is present iff debug, the
# armeabi-v7a and x86_64 APKs, asserting each carries no ABI but its own, and
# the fat APK, asserting it carries all three. And that the app's Kotlin
# standard library is the one `kotlin-stdlib` resolves to, not a mix of two.
dart_test(
    name = "verify_android_apk_test",
    data = [
        ":plugin_android_arm64",
        ":plugin_android_armv7",
        ":plugin_android_dbg",
        ":plugin_android_deploy.jar",
        ":plugin_android_fat",
        ":plugin_android_x86_64",
        "@bazel_tools//tools/zip:zipper",
        "@rules_flutter_maven//:org_jetbrains_kotlin_kotlin_stdlib",
    ],
    env = {
        "KOTLIN_STDLIB_RUNFILES": "$(rlocationpaths @rules_flutter_maven//:org_jetbrains_kotlin_kotlin_stdlib)",
        "ZIPPER_RUNFILE": "$(rlocationpath @bazel_tools//tools/zip:zipper)",
    },
    main = "test/verify_android_apk_test.dart",
    tags = ["android"],
    deps = [
        "@rules_dart//dart/runfiles",
        "@rules_flutter//tools/e2e_testing",
    ],
)

# Runtime verifier for the Android APK. Installs on a connected emulator or
# device, waits for RESUMED, and asserts the plugin_example_results logcat
# line reports a real /data/user/0/... path from path_provider — proving
# jnigen plugin registration (libdartjni.so) end to end. Tagged "manual" +
# "exclusive" because it needs a live device; run explicitly per
# docs/TESTING.md § Plugin verification matrix.
dart_test(
    name = "verify_android_app_test",
    # The fat APK installs on whichever device is attached, the Pixel or an
    # x86_64 emulator.
    data = [
        ":plugin_android_fat",
        "@androidsdk//:adb",
    ],
    # The `adb` of the Android SDK Bazel resolved, so the test needs nothing
    # on `PATH`.
    env = {"ADB_RUNFILE": "$(rlocationpath @androidsdk//:adb)"},
    main = "test/verify_android_app_test.dart",
    tags = [
        "android",
        "exclusive",
        "manual",
    ],
    deps = ["@rules_flutter//tools/e2e_testing"],
)

# `manual`, so `bazel test //...` never gives it to the analysis aspect; this
# checks it anyway.
dart_analysis_test(
    name = "verify_android_app_test_analysis",
    targets = [":verify_android_app_test"],
)

build_test(
    name = "web_build_test",
    targets = [":plugin_web"],
)

# Runtime verifier for the macOS bundle. Launches the .app, captures stdout,
# and asserts the four plugin-result strings appear. Tagged "manual" +
# "exclusive" because it requires a GUI session and exclusive control of the
# Dock; run explicitly per docs/TESTING.md § Plugin verification matrix.
dart_test(
    name = "verify_macos_app_test",
    data = [":plugin_macos"],
    main = "test/verify_macos_app_test.dart",
    tags = [
        "exclusive",
        "manual",
    ],
    target_compatible_with = ["@platforms//os:macos"],
    deps = ["@rules_flutter//tools/e2e_testing"],
)

# `manual`, so `bazel test //...` never gives it to the analysis aspect; this
# checks it anyway.
dart_analysis_test(
    name = "verify_macos_app_test_analysis",
    target_compatible_with = ["@platforms//os:macos"],
    targets = [":verify_macos_app_test"],
)

# The workspace's lint ruleset, bundled with the pub package whose YAML its
# `include:` resolves against. Named here rather than in a library's `deps`: a
# lint ruleset is not a dependency of the code it lints, and listing it there
# carries it into the `DartInfo` of every binary and test downstream.
dart_analysis_options(
    name = "options",
    src = "analysis_options.yaml",
    deps = ["@deps//:very_good_analysis"],
)

# Every `analysis_options.yaml` in this workspace, for the `dart_analyze`
# aspect `.bazelrc` enables: each Dart file is checked against the nearest
# listed one above it.
dart_analysis_config(
    name = "analysis_config",
    options = [":options"],
)

# Static analysis over this example's Dart. The app rule is a bundle and
# carries no DartInfo, so the sources are declared once more as a library for
# the analyzer to stage.
flutter_library(
    name = "app_lib",
    srcs = glob(["lib/**/*.dart"]),
    package = ":pubspec-metadata",
    deps = [
        "//greeting_plugin",
        "@deps//:audio_session",
        "@deps//:flutter",
        "@deps//:geolocator_apple",
        "@deps//:package_info_plus",
        "@deps//:path_provider",
        "@deps//:record_android",
        "@deps//:shared_preferences",
        "@deps//:url_launcher",
    ],
)

# There is deliberately no `flutter_test` target in this workspace. Under
# `flutter_tester` no plugin registrant runs, so a widget test here could only
# assert that every plugin is absent — `GreetingPlugin.greeting` reads back
# 'No greeting registered', and each platform-channel call lands in `_safe` as
# a MissingPluginException string — inverting the one property plugin_example
# exists to prove. The rule's own bootstrap is regression-covered by
# //e2e/hello_world:widget_test. Plugin registration is verified here against
# real artifacts instead: the APK and runtime verifiers above, and
# playwright/web.spec.js for web.

# =============================================================================
# A plugin whose Package.swift decides its defines from the app, on macOS
# =============================================================================

# geolocator_apple leaves out its check for an "always" location description
# when its manifest's environment has BYPASS_PERMISSION_LOCATION_ALWAYS=1,
# which this app sets for it: :verify_macos_app_settings_test.
flutter_application(
    name = "location_app",
    main = "lib/location_main.dart",
    package = ":pubspec-metadata",
    deps = [
        "@deps//:flutter",
        "@deps//:geolocator_apple",
    ],
)

flutter_macos_app(
    name = "location_macos",
    application = ":location_app",
    bundle_id = "com.example.plugin.location",
    swift_package_environment = {"BYPASS_PERMISSION_LOCATION_ALWAYS": "1"},
    tags = ["manual"],
    target_compatible_with = ["@platforms//os:macos"],
)

dart_test(
    name = "verify_macos_app_settings_test",
    data = [":location_macos"],
    main = "test/verify_macos_app_settings_test.dart",
    target_compatible_with = ["@platforms//os:macos"],
    deps = ["@rules_flutter//tools/e2e_testing"],
)
