# The ABIs of that APK are the platforms of --@rules_android//flags:android_platforms. These build it
# for given ones whatever the command line says, so one `bazel test //...`
# checks each: armeabi-v7a, arm64-v8a, x86_64, and all three at once, as
# `flutter build apk`'s default fat APK. The x86_64 APK must carry the x86_64
# engine and no other: a plugin that packaged its own (always arm64) engine
# would make Android install it on an arm64 device and crash at launch. The fat
# APK carries the engine, `libapp.so` and the plugins' native libraries of all
# three.
flutter_android_build(
    name = "plugin_android_armv7_build",
    android_platforms = ["@rules_android//:armeabi-v7a"],
    targets = [":plugin_android"],
)

flutter_android_build(
    name = "plugin_android_arm64_build",
    android_platforms = ["@rules_android//:arm64-v8a"],
    targets = [":plugin_android"],
)

flutter_android_build(
    name = "plugin_android_x86_64_build",
    android_platforms = ["@rules_android//:x86_64"],
    targets = [":plugin_android"],
)

flutter_android_build(
    name = "plugin_android_fat_build",
    android_platforms = [
        "@rules_android//:armeabi-v7a",
        "@rules_android//:arm64-v8a",
        "@rules_android//:x86_64",
    ],
    targets = [":plugin_android"],
)

