load("@rules_flutter//flutter:android.bzl", "flutter_android_engine", "flutter_android_plugin_library")
load("@rules_flutter//flutter:defs.bzl", "dart_package_metadata", "flutter_plugin", "flutter_plugin_platform")
load("@rules_flutter//flutter:macos.bzl", "flutter_apple_plugin_library")

dart_package_metadata(
    name = "pubspec-metadata",
    package_name = "glass_plugin",
)

# A plugin written in the workspace that ships fragment shaders, the shape of
# a Liquid Glass UI kit: `shaders` is its pubspec's `flutter: shaders:`, and
# `platforms` its `flutter: plugin: platforms:`. Its iOS and macOS code is one
# source (`sharedDarwinSource`), so both platforms name one library. The app
# in //glass_app draws with both shaders and calls the native side.
flutter_plugin(
    name = "glass_plugin",
    srcs = ["lib/glass_plugin.dart"],
    package = ":pubspec-metadata",
    platforms = [
        ":android",
        ":ios",
        ":macos",
    ],
    # invert.frag includes premultiplied.glsl.
    shader_includes = glob(["shaders/*.glsl"]),
    shaders = [
        "shaders/invert.frag",
        "shaders/tint.frag",
    ],
    visibility = ["//visibility:public"],
    # Its Kotlin, which every Android app that depends on the plugin links,
    # as it links a pub plugin's. Only an Android build analyses it.
    exports = select({
        "@platforms//os:android": [":glass_plugin_android"],
        "//conditions:default": [],
    }),
    deps = ["@deps//:flutter"],
)

flutter_plugin_platform(
    name = "android",
    # The Maven group of its AAR in a `flutter_android_aar` repository.
    group = "com.example.glass_plugin",
    package = "com.example.glass_plugin",
    platform = "android",
    plugin_class = "GlassPlugin",
)

flutter_plugin_platform(
    name = "ios",
    lib = ":glass_plugin_apple",
    platform = "ios",
    plugin_class = "GlassPlugin",
)

flutter_plugin_platform(
    name = "macos",
    lib = ":glass_plugin_apple",
    platform = "macos",
    plugin_class = "GlassPlugin",
)

# Compiles against the Flutter framework of the platform the build is for.
flutter_apple_plugin_library(
    name = "glass_plugin_apple",
    srcs = ["darwin/Classes/GlassPlugin.swift"],
    module_name = "glass_plugin",
    platform = "darwin",
)

# Compile-only: the app packages its own engine, of its own ABI.
flutter_android_engine(
    name = "android_engine",
    neverlink = True,
    tags = ["manual"],
)

flutter_android_plugin_library(
    name = "glass_plugin_android",
    srcs = glob(["android/src/main/kotlin/**/*.kt"]),
    flutter_engine = ":android_engine",
    java_package = "com.example.glass_plugin",
    manifest = "android/src/main/AndroidManifest.xml",
)

# The plugin again with no Maven `group`, which `//glass_app:no_group_aar` shows
# a workspace plugin built into an AAR must set.
flutter_plugin(
    name = "glass_plugin_no_group",
    srcs = ["lib/glass_plugin.dart"],
    package = ":pubspec-metadata",
    platforms = [":android_no_group"],
    tags = ["manual"],
    visibility = ["//glass_app:__pkg__"],
    exports = select({
        "@platforms//os:android": [":glass_plugin_android"],
        "//conditions:default": [],
    }),
    deps = ["@deps//:flutter"],
)

flutter_plugin_platform(
    name = "android_no_group",
    package = "com.example.glass_plugin",
    platform = "android",
    plugin_class = "GlassPlugin",
)
