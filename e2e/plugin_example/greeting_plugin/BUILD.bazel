load("@rules_flutter//flutter:defs.bzl", "flutter_plugin", "flutter_plugin_platform")

# Demonstrate flutter_plugin with dart_plugin_class only (no native code).
# The generated registrant calls GreetingPlugin.registerWith(null) at startup,
# which sets up Dart-side state before main() runs.
flutter_plugin(
    name = "greeting_plugin",
    srcs = ["lib/greeting_plugin.dart"],
    platforms = [
        ":android",
        ":ios",
        ":linux",
        ":macos",
        ":web",
        ":windows",
    ],
    visibility = ["//visibility:public"],
)

flutter_plugin_platform(
    name = "android",
    dart_plugin_class = "GreetingPlugin",
    platform = "android",
)

flutter_plugin_platform(
    name = "ios",
    dart_plugin_class = "GreetingPlugin",
    platform = "ios",
)

flutter_plugin_platform(
    name = "linux",
    dart_plugin_class = "GreetingPlugin",
    platform = "linux",
)

flutter_plugin_platform(
    name = "macos",
    dart_plugin_class = "GreetingPlugin",
    platform = "macos",
)

flutter_plugin_platform(
    name = "web",
    dart_plugin_class = "GreetingPlugin",
    platform = "web",
)

flutter_plugin_platform(
    name = "windows",
    dart_plugin_class = "GreetingPlugin",
    platform = "windows",
)
