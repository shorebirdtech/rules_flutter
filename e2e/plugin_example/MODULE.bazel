# The Gradle-built host app of add_to_app_host/android builds offline, from
# what these pin: the Gradle distribution its Android Gradle plugin needs (the
# version and plugin `flutter create` writes), and a Maven repository of every
# artifact the build resolves, from the lock
# `bazel run --config=deep //:record_gradle_host_repository` writes. Its JDK is the Java
# runtime .bazelrc names, and its Android SDK the one above.
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "gradle",
    build_file_content = """
package(default_visibility = ["//visibility:public"])

exports_files([
    "lib/agents/gradle-instrumentation-agent-9.3.1.jar",
    "lib/gradle-gradle-cli-main-9.3.1.jar",
])

filegroup(
    name = "distribution",
    srcs = glob(["**"], exclude = ["BUILD.bazel", "REPO.bazel"]),
)
""",
    sha256 = "b266d5ff6b90eada6dc3b20cb090e3731302e553a27c5d3e4df1f0d76beaff06",
    strip_prefix = "gradle-9.3.1",
    url = "https://services.gradle.org/distributions/gradle-9.3.1-bin.zip",
)

gradle_offline_repository = use_repo_rule("//:gradle_offline_repository.bzl", "gradle_offline_repository")

gradle_offline_repository(
    name = "gradle_host_maven",
    lock = "//:add_to_app_host/android/gradle_repository.json",
)

# Hermetic C++ toolchain for Linux arm64 execution platforms, so a C++ tool
# built for the exec platform (zipper, xmllint) can be compiled when Bazel runs
# actions on a Linux arm64 worker. Only the Linux-exec, Linux-target toolchain
# exists: Mac and iOS builds keep apple_support's toolchain. It is registered
# only on request, with `--extra_toolchains=@llvm_toolchains//:all` (for
# example in .bazelrc.user, for builds that run on a Linux arm64 worker):
# registering it here would make every build fetch llvm-project's sources,
# which toolchain resolution loads the generated package from.
bazel_dep(name = "llvm", version = "0.8.26", dev_dependency = True)

llvm_tc = use_extension("@llvm//extensions:toolchain.bzl", "toolchain", dev_dependency = True)
llvm_tc.exec(
    arch = "aarch64",
    os = "linux",
)
llvm_tc.target(
    arch = "aarch64",
    os = "linux",
)
use_repo(llvm_tc, "llvm_toolchains")
