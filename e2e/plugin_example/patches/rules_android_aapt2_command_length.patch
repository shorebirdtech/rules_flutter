+  /**
+   * Whether aapt2 would package a file from the assets directory {@code dir}. A library without
+   * assets gets a directory holding only a placeholder whose name ends in '~' (Bazel cannot declare
+   * an empty directory as an output), and aapt2 ignores such names. Leaving those directories out
+   * keeps the aapt2 command line short: it is limited to 32,767 characters on Windows, and cannot
+   * take -A from a file.
+   */
+  private static boolean hasAssetsToPackage(String dir) {
+    Path path = Path.of(dir);
+    if (!Files.isDirectory(path)) {
+      return true; // aapt2 reports it.
+    }
+    try (Stream<Path> files = Files.walk(path)) {
+      return files.anyMatch(
+          file -> Files.isRegularFile(file) && !file.getFileName().toString().endsWith("~"));
+    } catch (IOException e) {
+      throw new UncheckedIOException(e);
+    }
+  }
