load("@rules_dart//dart:defs.bzl", "dart_analysis_config", "dart_analysis_options", "dart_analysis_test", "dart_binary")
load("@rules_flutter//flutter:defs.bzl", "flutter_application", "flutter_library", "flutter_test")
load("@rules_flutter//flutter:integration_test.bzl", "flutter_android_integration_test", "flutter_ios_simulator_integration_test", "flutter_linux_integration_test", "flutter_macos_integration_test", "flutter_web_integration_test", "flutter_windows_integration_test")
load(":test_outcome.bzl", "outcome_test")

exports_files(["pubspec.lock"])

# The workspace's lint ruleset, bundled with the pub package whose YAML its
# `include:` resolves against, as the other e2e workspaces do.
dart_analysis_options(
    name = "options",
    src = "analysis_options.yaml",
    deps = ["@deps//:very_good_analysis"],
)

dart_analysis_config(
    name = "analysis_config",
    options = [":options"],
)

# The app's Dart as a library, so the analyzer has something to stage:
# `flutter_application` is a bundle and carries no `DartInfo`.
flutter_library(
    name = "app_lib",
    package_name = "integration_test_example",
    srcs = glob(["lib/**/*.dart"]),
    deps = ["@deps//:flutter"],
)

dart_analysis_test(
    name = "app_lib_analysis",
    targets = [":app_lib"],
)

# The test files, as a library for the same reason: the tests' programs are
# bundles, which the analyzer does not look into.
flutter_library(
    name = "test_files_lib",
    package_name = "integration_test_example",
    testonly = True,
    srcs = glob([
        "integration_test/**/*.dart",
        "test/**/*.dart",
    ]),
    deps = [
        ":app_lib",
        "@deps//:flutter",
        "@deps//:flutter_test",
        "@deps//:integration_test",
    ],
)

dart_analysis_test(
    name = "test_files_analysis",
    testonly = True,
    targets = [":test_files_lib"],
)

# The counter app. Each integration test runs it as the application with the
# test as its program.
flutter_application(
    name = "app_flutter",
    package_name = "integration_test_example",
    srcs = glob(["lib/**/*.dart"]),
    main = "lib/main.dart",
    deps = ["@deps//:flutter"],
)

# The same app as a flavor's target.
flutter_application(
    name = "app_flutter_paid",
    package_name = "integration_test_example",
    flavor = "paid",
    main = "lib/main.dart",
    deps = ["@deps//:flutter"],
)

_TEST_DEPS = [
    "@deps//:flutter_test",
    "@deps//:integration_test",
]

# The golden tests' own files. A golden is a function of the platform that
# rendered it, so `integration_test/goldens/<platform>/` holds one per platform
# (the test names the directory), and `matchesGoldenFile` reads them from the
# directory of the test, so they are the test's `data`.
_GOLDEN_SRCS = ["integration_test/swatch.dart"]

_GOLDENS = glob(["integration_test/goldens/**"])

# The files of the golden test whose directory has a `flutter_test_config.dart`.
_TOLERANT_FILES = glob(["integration_test/tolerant/**"])

# Where a failed golden leaves its pictures, as `flutter_test` does: the golden
# as it is, the picture the test made, and the two differences.
_FAILURE_PICTURES = [
    "failures/swatch_masterImage.png",
    "failures/swatch_testImage.png",
    "failures/swatch_isolatedDiff.png",
    "failures/swatch_maskedDiff.png",
]

# What a golden that does not match says, which names the golden.
_MISMATCH_SAYS = [
    "Golden \"goldens/",
    "swatch.png\": Pixel test failed",
]

# -- Tag selection and an empty suite (`flutter_test`) ---------------------

_TAGS_TEST_DEPS = [
    "@deps//:flutter",
    "@deps//:flutter_test",
]

# Three cases, tagged `golden`, `slow` and neither, and
# `library_tag` on every one. Passes as a whole.
flutter_test(
    name = "tags_test",
    package_name = "integration_test_example",
    main = "test/tags_test.dart",
    deps = _TAGS_TEST_DEPS,
)

# `manual`, since each is meant to fail or is only run by the outcome tests
# below: the same suite with a fixed selection, and a suite with no case.
flutter_test(
    name = "tags_fixed",
    package_name = "integration_test_example",
    include_tags = ["golden"],
    main = "test/tags_test.dart",
    tags = ["manual"],
    deps = _TAGS_TEST_DEPS,
)

flutter_test(
    name = "tags_fixed_empty",
    package_name = "integration_test_example",
    include_tags = ["no_such_tag"],
    main = "test/tags_test.dart",
    tags = ["manual"],
    deps = _TAGS_TEST_DEPS,
)

flutter_test(
    name = "no_tests",
    package_name = "integration_test_example",
    main = "test/no_tests_test.dart",
    tags = ["manual"],
    deps = _TAGS_TEST_DEPS,
)

# `--test_env=DART_TEST_TAGS=golden` runs the case tagged so.
outcome_test(
    name = "tags_run_include_test",
    cases = ["golden group a golden case"],
    expect = "pass",
    failing_cases_given = True,
    run_env = {"DART_TEST_TAGS": "golden"},
    test = ":tags_test",
)

outcome_test(
    name = "tags_run_exclude_test",
    cases = ["an untagged case"],
    expect = "pass",
    failing_cases_given = True,
    run_env = {"DART_TEST_EXCLUDE_TAGS": "golden,slow"},
    test = ":tags_test",
)

# A selector is a boolean expression.
outcome_test(
    name = "tags_run_selector_test",
    cases = [
        "golden group a golden case",
        "a slow case",
    ],
    expect = "pass",
    failing_cases_given = True,
    run_env = {"DART_TEST_TAGS": "golden || slow"},
    test = ":tags_test",
)

# The library's `@Tags` reached every case: excluding it leaves none, and a run
# that narrowed a target to nothing passes.
outcome_test(
    name = "tags_library_test",
    expect = "pass",
    output_contains = ["no test case in this suite matches"],
    run_env = {"DART_TEST_EXCLUDE_TAGS": "library_tag"},
    test = ":tags_test",
)

outcome_test(
    name = "tags_fixed_test",
    cases = ["golden group a golden case"],
    expect = "pass",
    failing_cases_given = True,
    test = ":tags_fixed",
)

# The target's own selection and the run's both apply: `slow` is not among the
# cases `include_tags = ["golden"]` keeps, so the run keeps none and passes.
outcome_test(
    name = "tags_fixed_narrowed_test",
    expect = "pass",
    output_contains = ["no test case in this suite matches"],
    run_env = {"DART_TEST_TAGS": "slow"},
    test = ":tags_fixed",
)

# A target whose own selection keeps nothing is broken.
outcome_test(
    name = "tags_fixed_empty_test",
    expect = "fail",
    output_contains = ["No tests match the requested tag selectors"],
    test = ":tags_fixed_empty",
)

outcome_test(
    name = "tags_bad_selector_test",
    expect = "fail",
    output_contains = ["is not a tag selector"],
    run_env = {"DART_TEST_TAGS": "golden &&"},
    test = ":tags_test",
)

outcome_test(
    name = "no_tests_test",
    expect = "fail",
    output_contains = ["the suite registered no tests"],
    test = ":no_tests",
)

# -- Library annotations (`flutter_test`) ----------------------------------

# `manual`, since the outcome tests below are what run them.
[
    flutter_test(
        name = name,
        package_name = "integration_test_example",
        main = "test/%s_test.dart" % name,
        tags = ["manual"],
        deps = _TAGS_TEST_DEPS,
    )
    for name in [
        "skip",
        "on_platform",
        "test_on",
        "timeout",
    ]
]

# A library `@Skip` skips every case, with its reason; a case body that ran
# would fail.
outcome_test(
    name = "skip_library_test",
    expect = "pass",
    output_contains = ["SKIP  a skipped case (skipped for the outcome test)"],
    test = ":skip",
)

# A library `@OnPlatform` resolves against the host.
outcome_test(
    name = "on_platform_library_test",
    expect = "pass",
    output_contains = ["SKIP  a case skipped by platform (skipped on this host)"],
    test = ":on_platform",
)

# A suite `@TestOn` excludes passes with a note naming the selector and the
# platform, and is not the no-tests failure.
outcome_test(
    name = "test_on_library_test",
    expect = "pass",
    output_contains = [
        "is not run: @TestOn(\"browser\") does not match the platform vm on ",
    ],
    test = ":test_on",
)

# A library `@Timeout` replaces Bazel's limit: the case that outlives it fails.
outcome_test(
    name = "timeout_library_test",
    expect = "fail",
    failing_cases = ["a case that outlives the timeout"],
    failing_cases_given = True,
    output_contains = ["Test timed out after 0.5 seconds"],
    test = ":timeout",
)

