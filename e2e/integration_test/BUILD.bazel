    name = "macos_filter_test",
    cases = ["counter increments when tapped"],
    expect = "pass",
    failing_cases_given = True,
    test = ":macos_pass_test",
    test_filter = "increments",
)

# A test that is wrong. `manual`, because it is meant to fail: the red twin
# below is what runs it, and passes only while it fails the way it should.
flutter_macos_integration_test(
    name = "macos_red",
    src = "integration_test/failing_test.dart",
    application = ":app_flutter",
    bundle_id = "com.example.integrationtest",
    tags = ["manual"],
    deps = _TEST_DEPS,
)

# A failing integration test fails its target, and its JUnit report names the
# failing case.
outcome_test(
    name = "macos_red_twin_test",
    cases = ["counter reads 99 after one tap"],
    expect = "fail",
    failing_cases = ["counter reads 99 after one tap"],
    failing_cases_given = True,
    output_contains = ["Expected: exactly one matching"],
    test = ":macos_red",
)

# The app ends during a test, with status 3.
flutter_macos_integration_test(
    name = "macos_crash",
    src = "integration_test/crash_test.dart",
    application = ":app_flutter",
    bundle_id = "com.example.integrationtest",
    tags = ["manual"],
    deps = _TEST_DEPS,
)

# An app that dies during a test fails its target, and the failure says how the
# app ended.
#
# The suite's `tearDownAll`, which the integration binding registers, cannot
# run in an app that is gone either, and is reported failing with it.
outcome_test(
    name = "macos_crash_test",
    cases = [
        "app exits during the test",
        "(tearDownAll)",
    ],
    expect = "fail",
    failing_cases = [
        "app exits during the test",
        "(tearDownAll)",
    ],
    failing_cases_given = True,
    output_contains = ["exited with code 3"],
    test = ":macos_crash",
)

# A flat swatch compared with `goldens/macOS/swatch.png`: the golden is
# compared on the host, where the app's `matchesGoldenFile` sends the picture.
# Regenerated with `bazel run //:macos_golden_test -- --update-goldens`.
flutter_macos_integration_test(
    name = "macos_golden_test",
    src = "integration_test/golden_test.dart",
    srcs = _GOLDEN_SRCS,
    application = ":app_flutter",
    bundle_id = "com.example.integrationtest",
    data = _GOLDENS,
    deps = _TEST_DEPS,
)

# A golden test whose directory has a `flutter_test_config.dart`, which the
# golden service runs as `flutter test` runs a config for its comparator: an
# orange swatch passes against the blue golden only because the config's
# comparator tolerates the difference, by a threshold it imports from the app's
# own package.
flutter_macos_integration_test(
    name = "macos_golden_config_test",
    src = "integration_test/tolerant/golden_tolerant_test.dart",
    srcs = _GOLDEN_SRCS,
    application = ":app_flutter",
    bundle_id = "com.example.integrationtest",
    data = _TOLERANT_FILES,
    deps = _TEST_DEPS,
)

# The same swatch in another colour against the same golden: `manual`, since it
# is meant to fail.
flutter_macos_integration_test(
    name = "macos_golden_mismatch",
    src = "integration_test/golden_mismatch_test.dart",
    srcs = _GOLDEN_SRCS,
    application = ":app_flutter",
    bundle_id = "com.example.integrationtest",
    data = _GOLDENS,
    tags = ["manual"],
    deps = _TEST_DEPS,
)

# A golden that does not match fails the target, names the golden and says how
# far it is off, and leaves the pictures of the failure where `flutter_test`
# leaves them, in the target's undeclared outputs.
outcome_test(
    name = "macos_golden_mismatch_twin_test",
    cases = ["an orange swatch matches the blue golden"],
    expect = "fail",
    failing_cases = ["an orange swatch matches the blue golden"],
    failing_cases_given = True,
    output_contains = _MISMATCH_SAYS,
    test = ":macos_golden_mismatch",
    undeclared_outputs = _FAILURE_PICTURES,
)

