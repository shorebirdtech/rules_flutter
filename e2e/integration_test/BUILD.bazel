# -- Web -------------------------------------------------------------------

# The same app in headless Chrome, on macOS and on Linux, where the browser loads
# the pinned runtime's libraries. Windows runs the browser too, but these are
# not registered for a Windows host (see the Android tests below); Bazel reports
# them skipped there.
_WEB_HOSTS = select({
    "@platforms//os:linux": [],
    "@platforms//os:macos": [],
    "//conditions:default": ["@platforms//:incompatible"],
})

# The same in a browser, where the framework reads `NOTICES`, uncompressed.
flutter_web_integration_test(
    name = "web_licences_test",
    package_name = "integration_test_example",
    src = "integration_test/licences_test.dart",
    srcs = glob(["lib/**/*.dart"]),
    target_compatible_with = _WEB_HOSTS,
    deps = ["@deps//:flutter"] + _TEST_DEPS,
)

# The two tests of `:macos_pass_test`, in a browser: each is reported.
flutter_web_integration_test(
    name = "web_pass_test",
    package_name = "integration_test_example",
    src = "integration_test/counter_test.dart",
