    data = [":plugin_class_macos"],
    main = "test/verify_macos_bundle_test.dart",
    target_compatible_with = ["@platforms//os:macos"],
    deps = ["@rules_flutter//tools/e2e_testing"],
)

dart_test(
    name = "verify_linux_bundle_test",
    data = [":plugin_class_linux"],
    main = "test/verify_linux_bundle_test.dart",
    target_compatible_with = ["@platforms//os:linux"],
    deps = ["@rules_flutter//tools/e2e_testing"],
)

build_test(
    name = "plugin_class_build_test",
    targets = [
        ":plugin_class_app",
        "//:multiply",
        "//multiply_plugin",
    ],
)

build_test(
    name = "macos_bundle_build_test",
    target_compatible_with = ["@platforms//os:macos"],
    targets = [":plugin_class_macos"],
)

flutter_ios_simulator_build_test(
    name = "ios_bundle_build_test",
    target_compatible_with = ["@platforms//os:macos"],
    targets = [":plugin_class_ios"],
)

build_test(
    name = "linux_bundle_build_test",
    target_compatible_with = ["@platforms//os:linux"],
    targets = [":plugin_class_linux"],
)

# Static analysis over this app's Dart, under the workspace's lint ruleset
# (`//:analysis_config`). The app rule is a bundle and carries no DartInfo, so
# the sources are declared once more as a library for the analyzer to stage.
flutter_library(
    name = "app_lib",
    srcs = glob(["lib/**/*.dart"]),
    package = ":pubspec-metadata",
    deps = [
        "//multiply_plugin",
        "@deps//:flutter",
        "@rules_flutter//flutter:material_icons",
    ],
)
