<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Not a real provisioning profile: a plain property list in the shape of
  one, for a device build that is never signed (`--features=disable_legacy_signing`).
  rules_apple wants a profile for every device build, though it signs with none
  of it, and reads the entitlements and team from this.
-->
<plist version="1.0">
<dict>
	<key>AppIDName</key>
	<string>Unsigned</string>
	<key>ApplicationIdentifierPrefix</key>
	<array>
		<string>UNSIGNED00</string>
	</array>
	<key>CreationDate</key>
	<date>2026-01-01T00:00:00Z</date>
	<key>Entitlements</key>
	<dict>
		<key>application-identifier</key>
		<string>UNSIGNED00.*</string>
		<key>com.apple.developer.team-identifier</key>
		<string>UNSIGNED00</string>
		<key>get-task-allow</key>
		<true/>
	</dict>
	<key>ExpirationDate</key>
	<date>2099-01-01T00:00:00Z</date>
	<key>Name</key>
	<string>Unsigned</string>
	<key>ProvisionedDevices</key>
	<array/>
	<key>TeamIdentifier</key>
	<array>
		<string>UNSIGNED00</string>
	</array>
	<key>TeamName</key>
	<string>Unsigned</string>
	<key>TimeToLive</key>
	<integer>1000</integer>
	<key>UUID</key>
	<string>00000000-0000-0000-0000-000000000000</string>
	<key>Version</key>
	<integer>1</integer>
</dict>
</plist>
