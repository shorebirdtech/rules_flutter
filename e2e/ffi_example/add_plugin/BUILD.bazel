load("@rules_dart//dart:defs.bzl", "dart_code_asset")
load("@rules_flutter//flutter:defs.bzl", "dart_package_metadata", "flutter_plugin")

# Demonstrate the Native Assets pipeline end to end: the shared library is
# declared as a Dart code asset of this package, and the Dart side binds with a
# bare `@Native(symbol: ...)` — no asset id, no paths, no Platform switch. The
# id below is the default the Dart VM derives for annotations in
# `lib/add_plugin.dart` (the library's URI), which is exactly how hook-built
# pub packages behave, so the same Dart source works under `flutter run`.
#
# The library ships under the name `//:add` gives it on each platform:
# `libadd.dylib`, `libadd.so`, `add.dll`. On iOS it is wrapped in a signed
# `add.framework` (loose embedded dylibs are forbidden there), and the manifest
# records `add.framework/add`. Runtime binds are proven by
# //:verify_ios_simulator_test and //:verify_macos_runtime_test.
dart_code_asset(
    name = "add_native_asset",
    asset_id = "package:add_plugin/add_plugin.dart",
    shared_library = "//:add",
)

dart_package_metadata(
    name = "pubspec-metadata",
    package_name = "add_plugin",
    code_assets = [":add_native_asset"],
)

flutter_plugin(
    name = "add_plugin",
    srcs = ["lib/add_plugin.dart"],
    package = ":pubspec-metadata",
    visibility = ["//visibility:public"],
)
