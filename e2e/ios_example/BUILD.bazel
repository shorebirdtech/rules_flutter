# =============================================================================
# Shared: Flutter application (Dart compilation)
# =============================================================================

dart_package_metadata(
    name = "pubspec-metadata",
    package_name = "ios_example",
)

flutter_application(
    name = "app_flutter",
    # A first-party asset so the dev loop has something real to deliver here.
    # iOS is the platform where this mattered: the runner reaches this target
    # through a split transition, so the app's `flutter_assets` tree lives in a
    # configuration no bare build produces. asset_reload_e2e_test edits
    # assets/message.txt on the simulator and asserts the change arrives.
    assets = glob(["assets/**"]),
    # Not the default, and the same as `:app`'s, whose bundle and program must
    # agree. Two numbers, which become three in the bundle as `flutter build`
    # pads them.
    build_name = "2.3",
    build_number = "42",
    main = "lib/main.dart",
    minimum_os_version = IOS_MINIMUM_OS_VERSION,
    package = ":pubspec-metadata",
    deps = [
        "@deps//:flutter",
        "@rules_flutter//flutter:material_icons",
    ],
)

# =============================================================================
# Shared iOS targets (used by approaches 2 & 3)
# =============================================================================

flutter_ios_framework_gen(
    name = "app_framework",
    application = ":app_flutter",
)

flutter_ios_registrant_gen(
    name = "app_registrant",
    application = ":app_flutter",
)

flutter_ios_engine(name = "app_engine")

flutter_ios_native_frameworks_gen(
    name = "app_native_frameworks",
    application = ":app_flutter",
)

# Shared version for approaches 2 & 3 and the app with extensions.
flutter_apple_bundle_version(
    name = "app_version",
    tags = ["manual"],
    visibility = ["//extensions:__pkg__"],
)

# =============================================================================
# Approach 1: Flutter-generated runner (flutter_ios_app)
#
# Recommended for most users. Requires ios/Runner/ from `flutter create`.
# The macro auto-discovers Swift files, processes Info.plist (resolves Xcode
# variables), and wires everything automatically.
# =============================================================================

flutter_ios_app(
    name = "app",
    application = ":app_flutter",
    # Not the default, so :verify_ios_info_plist_test can see it arrive. Two
    # numbers, which become three as `flutter build` pads them: 2.3.0.
    build_name = "2.3",
    build_number = "42",
    bundle_id = "com.rulesflutter.ios.example",
)

# An application only a test may depend on, as one an integration test builds for
# itself is, and an app over it. Everything `flutter_ios_app` declares around the
# app has to be `testonly` too: `:testonly_app_build_test`.
flutter_application(
    name = "testonly_flutter",
    testonly = True,
    main = "lib/testonly_main.dart",
    minimum_os_version = IOS_MINIMUM_OS_VERSION,
    package = ":pubspec-metadata",
    deps = ["@deps//:flutter"],
)

flutter_ios_app(
    name = "testonly_app",
    testonly = True,
    application = ":testonly_flutter",
    bundle_id = "com.rulesflutter.ios.example.testonly",
    tags = ["manual"],
)

# A second app in the same package, built from a second application of the
# same Dart package.
#
# Regression guard for every output the pair would otherwise share: each app's
# runner compiles into its own Swift module, and each App.framework is written
# under its own target's directory. Either one hardcoded would make both apps
# write one path and fail the build with conflicting actions.
#
# The second `flutter_application`, with an entry point of its own, is what
# gives the guard its teeth, and costs the second Dart compile it looks like it
# costs. Pointing both apps at one application gives the two App.frameworks
# identical inputs, so their actions are identical, and Bazel shares identical
# actions instead of reporting a conflict — which is exactly how this defect
# survived here until 2026-09. Differing only in `minimum_os_version` does not
# work either: that attribute is part of the configuration, so it separates the
# two into different output directories where nothing can collide.
flutter_application(
    name = "app_flutter_second",
    main = "lib/second_main.dart",
    minimum_os_version = IOS_MINIMUM_OS_VERSION,
    package = ":pubspec-metadata",
    deps = ["@deps//:flutter"],
)

flutter_ios_app(
    name = "app_second",
    application = ":app_flutter_second",
    bundle_id = "com.rulesflutter.ios.example.second",
)

# The same app, signed for a physical device: `provisioning_profile` is the
# only difference, so the device bundle is the identical construction rather
# than a second one hand-assembled out of Tier-2 `_gen` rules.
#
# Signed with the developer's own profile, which is not in this repository:
# `//:device_profile` is a flag whose default fails with the setup steps (copy
# device.example/ to the git-ignored device/, then set
# `--//:device_profile=//device:profile` in .bazelrc.user; see README.md
# "Device builds"). The flag keeps `bazel query 'deps(//...)'` from following
# a label into the //device package a fresh clone lacks. flutter_ios_app
# defaults to `tags = ["manual"]`, so `bazel build //...` skips the target.
device_profile()

flutter_ios_app(
    name = "app_device",
    application = ":app_flutter",
    bundle_id = "com.rulesflutter.ios.example",
    provisioning_profile = ":device_profile",
)

# An app that ships App Intents. The library goes to `runner_deps` so the runner
# links it, and to rules_apple's `app_intents`, which only extracts metadata.
# :verify_ios_app_intents_test finds the intent in the bundle's metadata.
swift_library(
    name = "ping_intents",
    srcs = ["intents/PingIntent.swift"],
    # rules_apple's `app_intents` aspect refuses a library that does not name
    # the AppIntents SDK framework.
    linkopts = ["-Wl,-framework,AppIntents"],
    module_name = "PingIntents",
    tags = ["manual"],
)

flutter_ios_app(
    name = "app_intents",
    app_intents = [":ping_intents"],
    application = ":app_flutter",
    bundle_id = "com.rulesflutter.ios.example.intents",
    runner_deps = [":ping_intents"],
)

# An app with extensions, built in //extensions: a widget extension holding a
# WidgetKit widget and a Control Center control, and a share extension. Each
# extension's bundle id starts with the app's, and the app joins the App Group
# the extensions declare by merging the same entitlements file into its own.
# :verify_ios_extensions_test checks where each lands and what each declares.
flutter_ios_app(
    name = "app_extensions",
    additional_entitlements = ["//extensions:AppGroup.entitlements"],
    application = ":app_flutter",
    bundle_id = "com.rulesflutter.ios.example.extensions",
    extensions = [
        "//extensions:share",
        "//extensions:widgets",
    ],
    # The extensions' version: an extension's must match its app's.
    version = ":app_version",
)

# The same app for a device, signed with //device's team wildcard profile. A
# wildcard profile cannot grant an App Group, so the app and its extensions
# leave the group out here; see README.md "App extensions".
flutter_ios_app(
    name = "app_extensions_device",
    application = ":app_flutter",
    bundle_id = "com.rulesflutter.ios.example.extensions",
    extensions = [
        "//extensions:share_device",
        "//extensions:widgets_device",
    ],
    provisioning_profile = ":device_profile",
    version = ":app_version",
)

# =============================================================================
# Approach 2: Bazel-generated runner (flutter_ios_runner_lib_gen)
#
# For users without `flutter create` output. Uses template files from
# rules_flutter. Only needs app_name. User manually wires ios_application.
# =============================================================================

flutter_ios_info_plist_gen(
    name = "bazel_runner_info_plist",
    app_name = "Flutter App",
    module_name = "BazelRunner",
)

flutter_ios_runner_lib_gen(
    name = "bazel_runner_lib",
    engine = ":app_engine",
    module_name = "BazelRunner",
    registrant = ":app_registrant",
)

ios_application(
    name = "app_bazel_runner",
    bundle_id = "com.rulesflutter.ios.example.bazelrunner",
    families = ["iphone"],
    infoplists = [":bazel_runner_info_plist"],
    launch_storyboard = IOS_DEFAULT_LAUNCH_STORYBOARD,
    minimum_os_version = IOS_MINIMUM_OS_VERSION,
    tags = ["manual"],
    version = ":app_version",
    deps = [
        ":app_framework",
        # Native-asset frameworks. Declared above but easy to leave
        # unwired: the app still builds and renders, then fails every
        # native-asset call at runtime because dyld cannot resolve the
        # framework-relative path the manifest records.
        ":app_native_frameworks",
        ":bazel_runner_lib",
    ],
)

# =============================================================================
# Approach 3: Custom runner (manual swift_library)
#
# For advanced users who want full control. User writes their own
# AppDelegate/SceneDelegate, creates a swift_library with the registrant
# from flutter_ios_registrant_gen, and wires into ios_application.
# =============================================================================

# Custom Info.plist with CustomRunner module name for scene delegate lookup.
flutter_ios_info_plist_gen(
    name = "custom_runner_info_plist",
    app_name = "Custom Runner Example",
    module_name = "CustomRunner",
)

swift_library(
    name = "custom_runner_lib",
    srcs = [
        "custom_runner/AppDelegate.swift",
        "custom_runner/SceneDelegate.swift",
        ":app_registrant",
    ],
    data = [IOS_DEFAULT_MAIN_STORYBOARD],
    module_name = "CustomRunner",
    tags = ["manual"],
    deps = [":app_engine"],
)

ios_application(
    name = "app_custom_runner",
    bundle_id = "com.rulesflutter.ios.example.customrunner",
    families = ["iphone"],
    infoplists = [":custom_runner_info_plist"],
    launch_storyboard = IOS_DEFAULT_LAUNCH_STORYBOARD,
    minimum_os_version = IOS_MINIMUM_OS_VERSION,
    tags = ["manual"],
    version = ":app_version",
    deps = [
        ":app_framework",
        # Native-asset frameworks. Declared above but easy to leave
        # unwired: the app still builds and renders, then fails every
        # native-asset call at runtime because dyld cannot resolve the
        # framework-relative path the manifest records.
        ":app_native_frameworks",
        ":custom_runner_lib",
    ],
)

