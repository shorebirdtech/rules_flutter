# =============================================================================
# What a release iOS app ships
#
# `flutter build ios --release` strips App.framework/App. A release bundle is
# a device build, which needs a provisioning profile this workspace does not
# have, so the framework is checked where it is assembled: it is the same
# `App` the bundle embeds. Flutter's release mode is every `-c` but `dbg`.
# =============================================================================

flutter_ios_framework_gen(
    name = "release_framework",
    application = ":app_flutter",
    tags = ["manual"],
)

[
    apple_release_build(
        name = "release_framework_%s" % mode,
        compilation_mode = mode,
        ios_device = True,
        targets = [":release_framework"],
    )
    for mode in ("fastbuild", "opt")
]

[
    dart_test(
        name = "verify_ios_release_stripped_%s_test" % mode,
        data = [":release_framework_%s" % mode],
        main = "test/verify_ios_release_stripped_test.dart",
        target_compatible_with = ["@platforms//os:macos"],
        deps = ["@rules_flutter//tools/e2e_testing"],
    )
    for mode in (
        "fastbuild",
        "opt",
    )
]

# =============================================================================
# The install name of App.framework/App
#
# A host app that links the framework records its install name, so it must be
# `@rpath/App.framework/App` as `flutter build ios` makes it: the AOT snapshot
# of every release mode, and the debug stub for a device and the simulator.
# =============================================================================

[
    apple_release_build(
        name = "install_name_framework_%s" % variant,
        compilation_mode = mode,
        ios_device = device,
        targets = [":release_framework"],
    )
    for variant, mode, device in (
        ("fastbuild", "fastbuild", True),
        ("opt", "opt", True),
        ("dbg_device", "dbg", True),
        ("dbg_simulator", "dbg", False),
    )
]

[
    dart_test(
        name = "verify_ios_app_install_name_%s_test" % variant,
        data = [":install_name_framework_%s" % variant],
        main = "test/verify_ios_app_install_name_test.dart",
        target_compatible_with = ["@platforms//os:macos"],
        deps = ["@rules_flutter//tools/e2e_testing"],
    )
    for variant in (
        "fastbuild",
        "opt",
        "dbg_device",
        "dbg_simulator",
    )
]

# =============================================================================
# The build as a whole
# =============================================================================

# Property: the simulator wrappers build debug mode whatever mode flags the
# command line carries, `--@rules_flutter//flutter:profile` among them. A
# `bazel test //... -c opt --@rules_flutter//flutter:profile` run (the way to
# test a profile build of the other targets) must still analyse them.
test_suite(
    name = "simulator_command_line_tests",
    tests = command_line_tests(
        name = "simulator_build",
        profile = False,
        target = ":app_simulator",
    ) + command_line_tests(
        name = "simulator_build_test",
        profile = False,
        target = ":ios_app_build_test",
    ),
)

# The same with the profile flag, which the other targets in a profile run
# need and the wrappers must not trip over.
test_suite(
    name = "simulator_profile_command_line_tests",
    tests = command_line_tests(
        name = "simulator_build_profile",
        profile = True,
        target = ":app_simulator",
    ) + command_line_tests(
        name = "simulator_build_test_profile",
        profile = True,
        target = ":ios_app_build_test",
    ),
)

# Property: a `flutter_ios_app` that declares itself for one platform is
# skipped for another, not failed, and what the user declares on it is kept.
#
# Each test passes by being skipped (see `skipped_test`); `..._control_test`
# is the same app where it is compatible, and passes by analysing.
flutter_ios_app(
    name = "app_macos_only",
    application = ":app_flutter",
    bundle_id = "com.rulesflutter.ios.example.macosonly",
    target_compatible_with = ["@platforms//os:macos"],
)

flutter_ios_app(
    name = "app_windows_only",
    application = ":app_flutter",
    bundle_id = "com.rulesflutter.ios.example.windowsonly",
    target_compatible_with = ["@platforms//os:windows"],
)

# Property: an iOS app over an application with an iOS-only dependency is
# built for iOS and passes on its program for analysis, rather than being
# skipped: nothing configures its application for any platform but the
# bundle's. A regression shows as this test SKIPPED, not FAILED, since Bazel
# skips a test of an incompatible target; `bazel build //:ios_only_app` says
# so outright.
flutter_application(
    name = "ios_only_flutter",
    main = "lib/testonly_main.dart",
    minimum_os_version = IOS_MINIMUM_OS_VERSION,
    package = ":pubspec-metadata",
    deps = [
        "//ios_only",
        "@deps//:flutter",
    ],
)

flutter_ios_app(
    name = "ios_only_app",
    application = ":ios_only_flutter",
    bundle_id = "com.rulesflutter.ios.example.iosonly",
)

program_test(
    name = "ios_only_app_program_test",
    main = "lib/testonly_main.dart",
    target = ":ios_only_app",
)

analyses_test(
    name = "ios_app_macos_only_control_test",
    target = ":app_macos_only",
)

skipped_test(
    name = "ios_app_user_constraint_skipped_test",
    target = ":app_windows_only",
)

skipped_test(
    name = "ios_app_macos_only_skipped_on_linux_test",
    on_linux = True,
    target = ":app_macos_only",
)

skipped_test(
    name = "ios_app_skipped_on_linux_test",
    on_linux = True,
    target = ":app",
)

# The same app for a device, built as a release and not signed, so that its
# release link can be read on any machine: rules_apple wants a provisioning
# profile for every device build, and this one is a plain property list in the
# shape of one (profiles/unsigned.mobileprovision).
flutter_ios_app(
    name = "swiftpm_plugins_app_device",
    application = ":swiftpm_plugins_flutter",
    bundle_id = "com.rulesflutter.ios.example.swiftpm",
    provisioning_profile = "profiles/unsigned.mobileprovision",
