load("@rules_dart//dart:defs.bzl", "dart_library")
load("@rules_flutter//flutter:defs.bzl", "dart_package_metadata")
load("//tools:bundle.bzl", "bundle_test", "notices_test")
load(":font_of_other_package_test.bzl", "font_of_other_package_test")
load(":two_files_one_key_test.bzl", "two_files_one_key_test")

dart_package_metadata(
    name = "pubspec-metadata",
    package_name = "asset_bundle_checks",
)

dart_library(
    name = "bundle_check",
    srcs = ["lib/bundle_check.dart"],
    package = ":pubspec-metadata",
    visibility = ["//visibility:public"],
)

exports_files(glob([
    "expected/*.json",
    "expected/*.txt",
]) + [
    "bundle_test.dart",
    "notices_test.dart",
])

# Each test is one property, stated above it, checked on a layout, name or
# platform of its kind. The reference is flutter_tools (`asset.dart`, 3.47.x):
# every asset a pubspec declares ends up in `flutter_assets/` under the key,
# with the variants, at the stored name and for the platforms that
# `flutter build` gives it.

# Property: an application at the root of the workspace ships the files it
# lists under their paths, each with the resolution variants beside it.
bundle_test(
    name = "app_at_workspace_root_ships_assets_with_their_variants_test",
    bundle = "//:app_root_bundle",
    expected = ":expected/kit.json",
)

# -- Keys ------------------------------------------------------------------------

# Property: an application's asset is keyed by its path relative to the
# application's package (`assets/a.png`), wherever in the workspace the package
# is, since that is the key the program loads it by (`rootBundle`,
# `Image.asset`) and the one `flutter run` gives it. A file in a Bazel package
# below the application's, listed explicitly, is keyed the same way.
bundle_test(
    name = "app_below_workspace_root_keys_assets_by_path_in_its_package_test",
    bundle = "//apps/sub:app_bundle",
    expected = "//tests:expected/kit_with_extra.json",
)

bundle_test(
    name = "app_deep_below_workspace_root_keys_assets_by_path_in_its_package_test",
    bundle = "//apps/team/deep:app_bundle",
    expected = "//tests:expected/kit.json",
)

# Property: a library's asset is keyed `packages/<package_name>/<path in the
# library's package>`, whether the library sits below the workspace root or in
# another repository.
bundle_test(
    name = "subdir_library_assets_are_keyed_under_packages_name_test",
    bundle = "//:app_with_subdir_lib_bundle",
    expected = "//tests:expected/kit.json",
    prefix = "packages/lib_assets/",
)

bundle_test(
    name = "deep_library_assets_are_keyed_under_packages_name_test",
    bundle = "//:app_with_deep_lib_bundle",
    expected = "//tests:expected/kit.json",
    prefix = "packages/deep_lib/",
)

bundle_test(
    name = "external_library_assets_are_keyed_under_packages_name_test",
    bundle = "//:app_with_external_lib_bundle",
    expected = "//tests:expected/kit.json",
    prefix = "packages/ext_assets/",
)

# Property: an asset's path is its path from the root of its Dart package (the
# directory above `lib/`), as the package's pubspec lists it, not from the
# BUILD file that names it. A library built from a BUILD file inside `lib/`
# keys its files `packages/<name>/lib/...`, and may name any file of its
# package.
bundle_test(
    name = "library_inside_lib_keys_assets_by_path_from_its_package_root_test",
    bundle = "//:app_with_split_lib_bundle",
    expected = "//tests:expected/split.json",
    prefix = "packages/split/",
)

# Property: the assets, fonts and shaders of a library of the application's
# own package are the application's, keyed with no `packages/<name>/` in front,
# as `flutter build` keys what the application's own pubspec lists. That holds
# for a library naming the application's package and for one whose derived
# name is it, and the font family is the bare one too.
bundle_test(
    name = "app_own_package_libraries_key_assets_without_a_package_prefix_test",
    bundle = "//apps/own:app_bundle",
    expected = "//tests:expected/own.json",
)

# -- Variants --------------------------------------------------------------------

# Property: a file is a resolution variant of the file of the same name one
# directory up when its directory is named `<number>x` (flutter_tools'
# `(\d+(\.\d*)?)x`), whatever the number, and only when that directory is its
# immediate parent. `scales/2x/nested/e.png` is an asset of its own.
bundle_test(
    name = "app_variants_of_any_scale_in_the_immediate_parent_directory_test",
    bundle = "//:app_scales_bundle",
    expected = "//tests:expected/scales.json",
)

# -- Pub packages --------------------------------------------------------------

# Property: every variant of an image a pub package lists is bundled and
# listed with its scale (`flutter build` finds them beside the listed file, in
# its `<number>x/` directories), so a high-density screen gets the image made
# for it.
# Property: a directory a pub package lists ships the files directly in it and
# the variants of those, and nothing from the directories below it (they need
# an entry of their own).
[
    bundle_test(
        name = name,
        bundle = "//:app_with_%s_bundle" % package,
        expected = "//tests:expected/%s.json" % package,
        prefix = "packages/%s/" % package,
    )
    for name, package in {
        "pub_package_variants_of_listed_images_ship_test": "fx_variants",
        "pub_package_listed_directory_ships_only_its_own_files_test": "fx_dirs",
    }.items()
]

# -- Platforms and flavors -------------------------------------------------------

# Property: a pub package's asset entry with `platforms:` is bundled only for
# those platforms (and one without, for all). Each platform is one build of the
# same application; the expectation file says which entries are meant for which.
[
    bundle_test(
        name = "pub_package_assets_bundle_only_for_their_platforms_%s_test" % os,
        bundle = bundle,
        expected = "//tests:expected/fx_platforms.json",
        platform = os,
        prefix = "packages/fx_platforms/",
        subdir = "assets" if os == "web" else "",
    )
    for os, bundle in {
        "android": "//:app_with_fx_platforms_android_bundle",
        "ios": "//:app_with_fx_platforms_ios_bundle",
        "linux": "//:app_with_fx_platforms_linux_bundle",
        "macos": "//:app_with_fx_platforms_macos_bundle",
        "web": "//:web_with_fx_platforms_bundle",
        "windows": "//:app_with_fx_platforms_windows_bundle",
    }.items()
]

# Property: a pub package's asset entry with `flavors:` (a file or a directory)
# is bundled only for a build of one of those flavors, and in no build without
# one, as with `flutter build`. The application's `flavor` is the build's.
bundle_test(
    name = "pub_package_flavor_restricted_assets_are_not_bundled_without_a_flavor_test",
    bundle = "//:app_with_fx_flavors_bundle",
    expected = "//tests:expected/fx_flavors.json",
    prefix = "packages/fx_flavors/",
)

[
    bundle_test(
        name = "pub_package_flavor_restricted_assets_ship_in_a_build_of_that_flavor_%s_test" % flavor,
        bundle = "//:app_with_fx_flavors_%s_bundle" % flavor,
        expected = "//tests:expected/fx_flavors.json",
        flavor = flavor,
        prefix = "packages/fx_flavors/",
    )
    for flavor in [
        "paid",
        "premium",
        "free",
        "other",
    ]
]

# Property: the platform and the flavor are independent filters.
bundle_test(
    name = "pub_package_flavor_restricted_assets_ship_in_a_flavored_android_build_test",
    bundle = "//:app_with_fx_flavors_paid_android_bundle",
    expected = "//tests:expected/fx_flavors.json",
    flavor = "paid",
    platform = "android",
    prefix = "packages/fx_flavors/",
)

# Property: web selects `flavors:` entries like the other platforms (which
# `flutter build web` does not: it has no `--flavor`).
bundle_test(
    name = "pub_package_flavor_restricted_assets_ship_in_a_flavored_web_build_test",
    bundle = "//:web_with_fx_flavors_paid_bundle",
    expected = "//tests:expected/fx_flavors.json",
    flavor = "paid",
    platform = "web",
    prefix = "packages/fx_flavors/",
    subdir = "assets",
)

# -- Names -----------------------------------------------------------------------

# Property: a file whose name needs URI encoding (a space, a non-ASCII
# character) is stored at its encoded path, the form the engine asks for
# (`Uri.encodeFull(key)`), and listed in the manifest by its decoded key, as
# flutter_tools does; so `rootBundle.load('names/my image.png')` finds it.
bundle_test(
    name = "app_asset_names_are_stored_uri_encoded_test",
    bundle = "//:app_names_bundle",
    expected = "//tests:expected/names.json",
)

bundle_test(
    name = "pub_package_asset_names_are_stored_uri_encoded_test",
    bundle = "//:app_with_fx_names_bundle",
    expected = "//tests:expected/fx_names.json",
    prefix = "packages/fx_names/",
)

# -- Bundled, not listed -------------------------------------------------------

# Property: the Material icon font is in the bundle (the font manifest names
# it) and is no entry of the asset manifest, as flutter_tools has it. Neither
# are Flutter's own shaders, which every bundle holds: all the checks here
# compare the manifest as it is.
bundle_test(
    name = "material_icon_font_is_bundled_and_not_listed_test",
    bundle = "//:app_with_material_icons_bundle",
    expected = ":expected/empty.json",
    unlisted = ["fonts/MaterialIcons-Regular.otf"],
)

# -- Keys claimed twice ---------------------------------------------------------

# Property: an asset key stands for one file. Two different files claiming one
# key (here a package's own `fonts/MaterialIcons-Regular.otf` and the one the
# Material icon font ships at that key) fail the build, naming the key; the
# bundle could hold only one of them, and its manifest would name the other.
two_files_one_key_test(
    name = "two_files_claiming_one_asset_key_fail_the_build_test",
    target_under_test = "//:two_files_one_key",
)

# Property: a pub package's shader entry with `platforms:` is bundled (and
# compiled) only for those platforms, as flutter_tools drops it from a build
# for another; one without ships for all.
[
    bundle_test(
        name = "pub_package_shaders_bundle_only_for_their_platforms_%s_test" % os,
        bundle = bundle,
        expected = "//tests:expected/fx_shaders.json",
        platform = os,
        prefix = "packages/fx_shaders/",
        subdir = "assets" if os == "web" else "",
    )
    for os, bundle in {
        "android": "//:app_with_fx_shaders_android_bundle",
        "ios": "//:app_with_fx_shaders_ios_bundle",
        "linux": "//:app_with_fx_shaders_linux_bundle",
        "macos": "//:app_with_fx_shaders_macos_bundle",
        "web": "//:web_with_fx_shaders_bundle",
        "windows": "//:app_with_fx_shaders_windows_bundle",
    }.items()
]

# Property: a pub package's shader entry with `flavors:` is bundled only for a
# build of one of those flavors, and in no build without one.
bundle_test(
    name = "pub_package_flavor_restricted_shaders_are_not_bundled_without_a_flavor_test",
    bundle = "//:app_with_fx_shader_flavors_bundle",
    expected = "//tests:expected/fx_shader_flavors.json",
    prefix = "packages/fx_shader_flavors/",
)

[
    bundle_test(
        name = "pub_package_flavor_restricted_shaders_ship_in_a_build_of_that_flavor_%s_test" % flavor,
        bundle = "//:app_with_fx_shader_flavors_%s_bundle" % flavor,
        expected = "//tests:expected/fx_shader_flavors.json",
        flavor = flavor,
        prefix = "packages/fx_shader_flavors/",
    )
    for flavor in [
        "paid",
        "free",
    ]
]

# Property: a pub package's font named `packages/<other>/<path>` is the file of
# the package `<other>`, at that key, though `<other>` does not list it; only
# the family is under the declaring package.
bundle_test(
    name = "font_of_other_package_is_bundled_at_its_own_key_test",
    bundle = "//:app_with_font_of_other_package_bundle",
    expected = "//tests:expected/fx_font_of_other_package.json",
)

font_of_other_package_test(
    name = "font_of_other_package_keeps_its_path_in_the_font_manifest_test",
    target_under_test = "@fx_font_borrower",
)

# -- Licences ----------------------------------------------------------------------

# Property: every bundle ships the licences the framework's `showLicensePage`
# lists, in the asset it loads: `NOTICES.Z` (gzip), or `NOTICES` on the web
# where nothing decompresses it. It holds the engine's licences, which every
# program ships, as entries of their own, sorted as flutter_tools sorts them.
[
    notices_test(
        name = "notices_list_the_engine_licences_%s_test" % os,
        bundle = bundle,
        subdir = "assets" if os == "web" else "",
        web = os == "web",
    )
    for os, bundle in {
        "android": "//:app_with_fx_platforms_android_bundle",
        "ios": "//:app_with_fx_platforms_ios_bundle",
        "linux": "//:app_with_fx_platforms_linux_bundle",
        "macos": "//:app_with_fx_platforms_macos_bundle",
        "web": "//:web_with_fx_platforms_bundle",
        "windows": "//:app_with_fx_platforms_windows_bundle",
    }.items()
]

# Property: a program's own `LICENSE` is an entry named by its package, and the
# files its pubspec lists under `flutter: licenses:` come last, as they are.
notices_test(
    name = "notices_list_the_programs_own_licences_test",
    additional = ["//apps/licensed:licenses/THIRD_PARTY.txt"],
    bundle = "//apps/licensed:app_with_licences_bundle",
    own_license = "//apps/licensed:licenses/LICENSE",
    package = "licensed_app",
)

notices_test(
    name = "notices_list_the_programs_own_licences_web_test",
    additional = ["//apps/licensed:licenses/THIRD_PARTY.txt"],
    bundle = "//apps/licensed:web_with_licences_bundle",
    own_license = "//apps/licensed:licenses/LICENSE",
    package = "licensed_app",
    subdir = "assets",
    web = True,
)

# Property: a pub package's `flutter: licenses:` files are appended to the
# program's `NOTICES` as they are, after the sorted entries, as flutter_tools
# appends them.
notices_test(
    name = "notices_end_with_the_licences_a_pub_package_lists_test",
    additional = ["//registry:fx_extra/1.0.0/THIRD_PARTY.txt"],
    bundle = "//:app_with_fx_extra_bundle",
)

# Property: the licence of every package a program depends on is an entry named
# by the package: a `NOTICES` over a `LICENSE`, one text under two names as one
# entry, nothing for a package with no file, and nothing for a package of the
# lock the program does not depend on.
notices_test(
    name = "notices_list_the_licence_of_every_package_test",
    absent = [
        "fx_dev_only",
        "fx_nolicence",
    ],
    bundle = "//:app_with_licence_fixtures_bundle",
    fixtures = "//tests:expected/notices_fixtures.txt",
)

notices_test(
    name = "notices_list_the_licence_of_every_package_web_test",
    absent = [
        "fx_dev_only",
        "fx_nolicence",
    ],
    bundle = "//:web_with_licence_fixtures_bundle",
    fixtures = "//tests:expected/notices_fixtures.txt",
    subdir = "assets",
    web = True,
)
