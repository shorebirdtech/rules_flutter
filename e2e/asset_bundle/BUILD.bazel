load("@rules_flutter//flutter:defs.bzl", "flutter_asset_bundle")
load("@rules_flutter//flutter:web.bzl", "flutter_web_app")
load("//tools:bundle.bzl", "bundled_app", "tree_of")

exports_files(["pubspec.lock"])

# -- First-party assets of an application at the workspace root ---------------

bundled_app(
    name = "app_root",
    assets = glob(["assets/**"]),
)

# -- The Material icon font -----------------------------------------------------

bundled_app(
    name = "app_with_material_icons",
    deps = ["@rules_flutter//flutter:material_icons"],
)

# -- File names the engine URI-encodes -----------------------------------------

bundled_app(
    name = "app_scales",
    assets = glob(["scales/**"]),
)

bundled_app(
    name = "app_names",
    assets = glob(["names/**"]),
)

# -- Assets of a library --------------------------------------------------------

bundled_app(
    name = "app_with_subdir_lib",
    deps = ["//libs/lib_assets"],
)

bundled_app(
    name = "app_with_deep_lib",
    deps = ["//libs/team/deep_lib"],
)

bundled_app(
    name = "app_with_external_lib",
    deps = ["@ext_assets"],
)

# -- Assets of a pub package ------------------------------------------------------

[
    bundled_app(
        name = "app_with_" + package,
        deps = ["@%s" % package],
    )
    for package in [
        "fx_dirs",
        "fx_flavors",
        "fx_names",
        "fx_platforms",
        "fx_variants",
    ]
]

# -- The same package, bundled for each platform ----------------------------------

platform(
    name = "android_arm64",
    constraint_values = [
        "@platforms//os:android",
        "@platforms//cpu:arm64",
    ],
)

[
    bundled_app(
        name = "app_with_fx_platforms_" + os,
        platform = platform,
        deps = ["@fx_platforms"],
    )
    for os, platform in {
        "android": ":android_arm64",
        "ios": "@rules_flutter//flutter/platforms:ios_arm64",
        "linux": "@rules_flutter//flutter/platforms:linux_x64",
        "macos": "@rules_flutter//flutter/platforms:macos_arm64",
        "windows": "@rules_flutter//flutter/platforms:windows_x64",
    }.items()
]

flutter_web_app(
    name = "web_with_fx_platforms",
    package_name = "asset_bundle",
    js_fallback = False,
    deps = [
        "@deps//:flutter",
        "@fx_platforms",
    ],
)

tree_of(
    name = "web_with_fx_platforms_bundle",
    src = ":web_with_fx_platforms",
    visibility = ["//visibility:public"],
)

# -- Two files for one key ----------------------------------------------------------

# This package's `fonts/MaterialIcons-Regular.otf` and the one the Material
# icon font brings are two files for one key. Tagged manual: it is not meant
# to build, `//tests:two_files_claiming_one_asset_key_fail_the_build_test` analyses it and expects the failure.
flutter_asset_bundle(
    name = "two_files_one_key",
    assets = ["fonts/MaterialIcons-Regular.otf"],
    tags = ["manual"],
    visibility = ["//visibility:public"],
    deps = ["@rules_flutter//flutter:material_icons"],
)
