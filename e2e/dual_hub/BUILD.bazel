load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@bazel_skylib//rules:diff_test.bzl", "diff_test")
load("@rules_dart//dart:defs.bzl", "dart_analysis_config", "dart_analysis_options")

# Two pub hubs, and two packages, `//agreeing` and `//upgraded`, each a library
# collecting a package from both hubs and a binary over it. See MODULE.bazel for
# how the two locks differ.
#
# The binaries are the point, not decoration. rules_dart's duplicate-record check
# runs wherever a package_config gets assembled (`dart_binary`, `dart_test`, ...);
# `dart_library` itself accumulates records into depsets and never dedups, so a
# `build_test` over a bare library proves nothing about it.

build_test(
    name = "bins_test",
    size = "small",
    targets = [
        "//agreeing:agreeing_bin",
        "//upgraded:upgraded_bin",
    ],
)

# The library each hub's label for a package is an alias of. A `build_test`
# cannot show that these are one repository, since two at one version build
# too; two repositories print two lines and fail the comparison.
genquery(
    name = "shared_libraries",
    expression = "labels(actual, @hub_a//:clock + @hub_b//:clock + @hub_a//:path + @hub_b//:path)",
    scope = [
        "@hub_a//:clock",
        "@hub_b//:clock",
        "@hub_a//:path",
        "@hub_b//:path",
    ],
)

diff_test(
    name = "shared_libraries_test",
    size = "small",
    file1 = ":shared_libraries",
    file2 = "shared_libraries.golden",
)

dart_analysis_options(
    name = "options",
    src = "analysis_options.yaml",
)

# Every `analysis_options.yaml` in this workspace, for the `dart_analyze`
# aspect `.bazelrc` enables: each Dart file is checked against the nearest
# listed one above it.
dart_analysis_config(
    name = "analysis_config",
    options = [":options"],
)
