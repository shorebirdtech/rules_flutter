load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@bazel_skylib//rules:diff_test.bzl", "diff_test")
load("@rules_dart//dart:defs.bzl", "dart_analysis_config", "dart_analysis_options", "dart_binary", "dart_library")

# Two pub hubs, a library collecting a package from each, and binaries over it.
# See MODULE.bazel for how the two locks differ.
#
# The binaries are the point, not decoration. rules_dart's duplicate-record check
# runs wherever a package_config gets assembled (`dart_binary`, `dart_test`, ...);
# `dart_library` itself accumulates records into depsets and never dedups, so a
# `build_test` over a bare library proves nothing about it.

# `path` is 1.9.1 in both hubs, down to the same sha256.
dart_library(
    name = "agreeing",
    package_name = "agreeing",
    srcs = ["lib/dual_hub.dart"],
    deps = [
        "@hub_a//:path",
        "@hub_b//:path",
    ],
)

dart_binary(
    name = "agreeing_bin",
    main = "bin/main.dart",
    deps = [":agreeing"],
)

# `clock` is 1.1.2 in `//hub_a` and 1.1.3 in `//hub_b`, which is the higher and
# so the one version of the build: `hub_a` accepts it with
# `on_version_conflict = "upgrade"`.
dart_library(
    name = "upgraded",
    package_name = "upgraded",
    srcs = ["lib/dual_hub.dart"],
    deps = [
        "@hub_a//:clock",
        "@hub_b//:clock",
    ],
)

dart_binary(
    name = "upgraded_bin",
    main = "bin/main.dart",
    deps = [":upgraded"],
)

build_test(
    name = "bins_test",
    size = "small",
    targets = [
        ":agreeing_bin",
        ":upgraded_bin",
    ],
)

# The library each hub's label for a package is an alias of. A `build_test`
# cannot show that these are one repository, since two at one version build
# too; two repositories print two lines and fail the comparison.
genquery(
    name = "shared_libraries",
    expression = "labels(actual, @hub_a//:clock + @hub_b//:clock + @hub_a//:path + @hub_b//:path)",
    scope = [
        "@hub_a//:clock",
        "@hub_b//:clock",
        "@hub_a//:path",
        "@hub_b//:path",
    ],
)

diff_test(
    name = "shared_libraries_test",
    size = "small",
    file1 = ":shared_libraries",
    file2 = "shared_libraries.golden",
)

dart_analysis_options(
    name = "options",
    src = "analysis_options.yaml",
)

# Every `analysis_options.yaml` in this workspace, for the `dart_analyze`
# aspect `.bazelrc` enables: each Dart file is checked against the nearest
# listed one above it.
dart_analysis_config(
    name = "analysis_config",
    options = [":options"],
)
