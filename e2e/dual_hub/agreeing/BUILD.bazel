load("@rules_dart//dart:defs.bzl", "dart_binary", "dart_library")
load("@rules_flutter//flutter:defs.bzl", "dart_package_metadata")

# What these targets test is which package records reach a program's closure
# through deps that nothing imports, so the unused-dependency check is off:
# removing the deps, or importing them, would leave nothing to test.
package(features = ["-dart_unused_deps"])

dart_package_metadata(
    name = "pubspec-metadata",
    package_name = "agreeing",
)

# `path` is 1.9.1 in both hubs, down to the same sha256.
dart_library(
    name = "agreeing",
    srcs = ["lib/agreeing.dart"],
    package = ":pubspec-metadata",
    deps = [
        "@hub_a//:path",
        "@hub_b//:path",
    ],
)

dart_binary(
    name = "agreeing_bin",
    main = "bin/main.dart",
    visibility = ["//:__pkg__"],
    deps = [":agreeing"],
)
