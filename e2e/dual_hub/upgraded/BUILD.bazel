load("@rules_dart//dart:defs.bzl", "dart_binary", "dart_library")
load("@rules_flutter//flutter:defs.bzl", "dart_package_metadata")

dart_package_metadata(
    name = "pubspec-metadata",
    package_name = "upgraded",
)

# `clock` is 1.1.2 in `//hub_a` and 1.1.3 in `//hub_b`, which is the higher and
# so the one version of the build: each lock's version is a minimum.
dart_library(
    name = "upgraded",
    srcs = ["lib/upgraded.dart"],
    package = ":pubspec-metadata",
    deps = [
        "@hub_a//:clock",
        "@hub_b//:clock",
    ],
)

dart_binary(
    name = "upgraded_bin",
    main = "bin/main.dart",
    visibility = ["//:__pkg__"],
    deps = [":upgraded"],
)
