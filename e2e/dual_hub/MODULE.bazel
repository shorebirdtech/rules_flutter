"""Two pub hubs in one workspace, sharing packages.

The shape a consumer reaches by resolving two lock files: an app's own
dependencies beside a tool's, or a rules_flutter hub beside a rules_dart one.
`//hub_a` and `//hub_b` differ in exactly one way: `clock` is 1.1.2 in the
first and 1.1.3 in the second, while `path` is the same 1.9.1 in both. Both
locks state the same SDK constraint on purpose, so the packages derive the same
`language_version` and the package version is the only difference between them.

`flutter.pub` builds one repository per package for the whole build, at the
highest version any lock records, so `@hub_a//:clock` and `@hub_b//:clock` are
the same library at 1.1.3: `hub_a` is behind and says `on_version_conflict =
"upgrade"`. `//:shared_libraries_test` proves they are one repository (two
repositories at one version would build too), and `//:upgraded_bin` and
`//:agreeing_bin` build over both. That a lock behind another at the default
`"error"` fails when the module is read cannot be a target of a workspace whose
every command would fail with it; `tools/dev_tool/test/e2e/pub_versions_e2e_test.dart`
holds that case.

rules_flutter's own root workspace runs the same shape: its tools' lock is
`dev_tool_deps`, at `"upgrade"`, beside whatever a consumer's lock adds.
"""

module(name = "dual_hub_e2e")

bazel_dep(name = "rules_flutter", version = "0.0.0")
bazel_dep(name = "rules_dart", version = "0.8.1")
bazel_dep(name = "bazel_skylib", version = "1.9.2")

local_path_override(
    module_name = "rules_flutter",
    path = "../..",
)

flutter = use_extension("@rules_flutter//flutter:extensions.bzl", "flutter")
flutter.pub(
    name = "hub_a",
    lock = "//hub_a:pubspec.lock",
    on_version_conflict = "upgrade",
)
flutter.pub(
    name = "hub_b",
    lock = "//hub_b:pubspec.lock",
)
use_repo(flutter, "hub_a", "hub_b")

# Hermetic C++ toolchain for Linux arm64 execution platforms, so a C++ tool
# built for the exec platform (zipper, xmllint) can be compiled when Bazel runs
# actions on a Linux arm64 worker. Only the Linux-exec, Linux-target toolchain
# exists: Mac and iOS builds keep apple_support's toolchain. It is registered
# only on request, with `--extra_toolchains=@llvm_toolchains//:all` (for
# example in .bazelrc.user, for builds that run on a Linux arm64 worker):
# registering it here would make every build fetch llvm-project's sources,
# which toolchain resolution loads the generated package from.
bazel_dep(name = "llvm", version = "0.8.26", dev_dependency = True)

llvm_tc = use_extension("@llvm//extensions:toolchain.bzl", "toolchain", dev_dependency = True)
llvm_tc.exec(
    arch = "aarch64",
    os = "linux",
)
llvm_tc.target(
    arch = "aarch64",
    os = "linux",
)
use_repo(llvm_tc, "llvm_toolchains")
