load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@rules_dart//dart:defs.bzl", "dart_test")
load("@rules_flutter//flutter:defs.bzl", "dart_package_metadata", "flutter_application")
load("@rules_flutter//flutter:web.bzl", "flutter_web_app", "flutter_web_bundle")

# The templating surface, exercised by a real build.
#
# A package of its own because `web/flutter_bootstrap.js` is discovered by the
# `web/` glob of whichever package it sits in: in the workspace root it would
# have silently become the bootstrap of every Tier 1 target there.
#
# Being nested is also what makes this the workspace's coverage for a web app
# outside the workspace root, where an app's `package:` URIs must resolve
# against its own package rather than the root's.

dart_package_metadata(
    name = "pubspec-metadata",
    package_name = "custom_boot",
)

flutter_application(
    name = "app",
    main = "lib/main.dart",
    package = ":pubspec-metadata",
    deps = [
        "@deps//:flutter",
        "@rules_flutter//flutter:material_icons",
    ],
)

# Tier 1 with both templates supplied: web/index.html carrying web_defines and
# a preserved placeholder, and web/flutter_bootstrap.js carrying the built-ins.
flutter_web_app(
    name = "custom_boot",
    app_name = "Custom Boot",
    application = ":app",
    keep_placeholders = ["vueThing"],
    web_defines = {"API_URL": "https://api.example.com"},
)

# Tier 2 inlining the substituted bootstrap into the page.
#
# build_test only, and deliberately so: this target cannot build in `-c dbg`.
# The dev tool serves index.html as built, next to a flutter_bootstrap.js the
# build substituted for DDC — so an index carrying an inlined copy of the
# bundle's would boot the built bundle and hot reload would do nothing, which
# the templating pass refuses rather than letting a developer discover it from
# a dead reload key.
flutter_web_bundle(
    name = "inline_boot",
    application = ":app",
    index_html = "inline_index.html",
    title = "Inline Boot",
)

build_test(
    name = "custom_boot_build_test",
    targets = [
        ":custom_boot",
        ":inline_boot",
    ],
)

dart_test(
    name = "verify_templating_test",
    data = [
        ":custom_boot",
        ":inline_boot",
    ],
    main = "test/verify_templating_test.dart",
    deps = ["@rules_flutter//tools/e2e_testing"],
)
