load("@rules_dart//dart:defs.bzl", "dart_package_metadata")
load("@rules_flutter//flutter:defs.bzl", "flutter_library")

dart_package_metadata(
    name = "pubspec-metadata",
    package_name = "int64_ids",
)

# 64-bit identifiers in an `Int64List`: the variant of `package:int64_ids` for
# dart2wasm, and for a build under no web compiler.
flutter_library(
    name = "ids",
    srcs = ["lib/ids.dart"],
    package = ":pubspec-metadata",
    visibility = ["//int64/ids:__pkg__"],
)
