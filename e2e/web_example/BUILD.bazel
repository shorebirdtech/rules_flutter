)

build_test(
    name = "dev_boot_build_test",
    targets = [":app_dev_boot"],
)

build_test(
    name = "wasm_subpath_build_test",
    targets = [":app_wasm_subpath"],
)

build_test(
    name = "js_build_test",
    targets = [":app_js"],
)

build_test(
    name = "no_pwa_build_test",
    targets = [":app_no_pwa"],
)

dart_test(
    name = "verify_index_html_test",
    data = [
        ":app_js",
        ":app_wasm",
        ":app_wasm_subpath",
    ],
