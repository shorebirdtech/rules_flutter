load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@rules_dart//dart:defs.bzl", "dart_analysis_config", "dart_analysis_options", "dart_test")
load("@rules_flutter//flutter:defs.bzl", "flutter_library")
load("@rules_flutter//flutter:web.bzl", "flutter_web_app", "flutter_web_bundle", "flutter_web_manifest_gen")

exports_files(["pubspec.lock"])

# =============================================================================
# Approach 1: Tier 1 — flutter_web_app (auto-discovers web/ runner files)
# WASM build (dart2wasm + skwasm) — modern, recommended. WebAssembly only: no
# dart2js compile runs and the bundle has no main.dart.js.
# =============================================================================

flutter_web_app(
    name = "app_wasm",
    package_name = "web_example",
    app_name = "Web Example",
    # A first-party asset, so the web dev loop's asset reload has something
    # real to deliver.
    assets = glob(["assets/**"]),
    deps = [
        "@deps//:flutter",
        "@rules_flutter//flutter:material_icons",
    ],
)

# Variant with a non-default base_href, exercising substitution of the
# user-provided web/index.html.
flutter_web_app(
    name = "app_wasm_subpath",
    package_name = "web_example",
    app_name = "Web Example (subpath)",
    # A first-party asset, so the web dev loop's asset reload has something
    # real to deliver.
    assets = glob(["assets/**"]),
    base_href = "/web_example/",
    deps = [
        "@deps//:flutter",
        "@rules_flutter//flutter:material_icons",
    ],
)

# An app whose `main` sits outside the package's `lib/` — the shape
# `flutter run -t test_driver/app.dart` runs. The dev loop's generated
# entrypoint imports it by its app-scheme URI instead of a `package:` one, and a
# hot reload has to deliver edits to it and to the sibling it imports.
flutter_web_app(
    name = "app_test_driver",
    package_name = "web_example",
    srcs = ["test_driver/banner.dart"],
    main = "test_driver/app.dart",
    deps = [
        "@deps//:flutter",
        "@rules_flutter//flutter:material_icons",
    ],
)

# =============================================================================
# Approach 2: Tier 2 — flutter_web_bundle (explicit control)
# JS build (dart2js + canvaskit) — legacy, wider browser support. Also what
# `js_fallback = True` adds beside a WASM build (see `app_fallback` below).
# =============================================================================

flutter_web_manifest_gen(
    name = "app_js_manifest",
    app_name = "Web Example JS",
)

flutter_web_bundle(
    name = "app_js",
    package_name = "web_example",
    assets = glob(["assets/**"]),
    base_href = "/web_example_js/",
    compiler = "dart2js",
    # Exercised here rather than on the unminified target: only minified
    # output has names to choose, so alongside `minify_js = "false"` this
    # setting reaches the command line and decides nothing.
    frequency_based_minification = False,
    main = "lib/main.dart",
    manifest_json = ":app_js_manifest",
    renderer = "canvaskit",
    title = "Web Example JS",
    web_assets = glob(
        ["web/**"],
        exclude = [
            "web/index.html",
            "web/manifest.json",
        ],
    ),
    deps = [
        "@deps//:flutter",
        "@rules_flutter//flutter:material_icons",
    ],
)

# =============================================================================
# Approach 3: Tier 1 with pwa = False (no service worker)
# =============================================================================

flutter_web_app(
    name = "app_no_pwa",
    package_name = "web_example",
    app_name = "Web Example No PWA",
    pwa = False,
    deps = [
        "@deps//:flutter",
        "@rules_flutter//flutter:material_icons",
    ],
)

# =============================================================================
# Approach 5: Tier 2 with a bootstrap template carrying a web_define
#
# The dev loop's boot path, end to end: `templates/dev_bootstrap.js` sets a
# global from `web_defines`, and `web_define_e2e_test.dart` reads that global
# off the live page of a `-d chrome` run. Nothing else here proves a define
# reaches the browser rather than only the built bundle.
#
# In the root package because it reuses this package's `lib/main.dart` and
# assets; a target beside `custom_boot`'s templates would have to carry copies
# of both. dart2js + canvaskit to keep the debug compile this adds as cheap as
# the sibling `:app_js`.
# =============================================================================

flutter_web_bundle(
    name = "app_dev_boot",
    package_name = "web_example",
    # `lib/main.dart` reads one, and an app reporting a failed asset load is a
    # worse signal to run an assertion against than one that boots cleanly.
    assets = glob(["assets/**"]),
    bootstrap_js = "templates/dev_bootstrap.js",
    compiler = "dart2js",
    main = "lib/main.dart",
    renderer = "canvaskit",
    title = "Web Example (dev boot)",
    web_defines = {"API_URL": "https://api.example.com"},
    deps = [
        "@deps//:flutter",
        "@rules_flutter//flutter:material_icons",
    ],
)

# =============================================================================
# Tests
# =============================================================================

build_test(
