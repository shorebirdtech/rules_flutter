dart_test(
    name = "verify_service_worker_test",
    data = [
        ":app_js",
        ":app_no_pwa",
        ":app_wasm",
    ],
    main = "test/verify_service_worker_test.dart",
    deps = ["@rules_dart//dart/runfiles"],
)

# The workspace's lint ruleset, bundled with the pub package whose YAML its
# `include:` resolves against. Named here rather than in a library's `deps`: a
# lint ruleset is not a dependency of the code it lints, and listing it there
# carries it into the `DartInfo` of every binary and test downstream.
dart_analysis_options(
    name = "options",
    src = "analysis_options.yaml",
    deps = ["@deps//:very_good_analysis"],
)

# Every `analysis_options.yaml` in this workspace, for the `dart_analyze`
# aspect `.bazelrc` enables: each Dart file is checked against the nearest
# listed one above it.
dart_analysis_config(
    name = "analysis_config",
    options = [":options"],
)

# Static analysis over this example's Dart.
#
# `flutter_web_app` provides `DartAnalyzableInfo`, so a bundle can be an
# analysis target directly — `//custom_boot:custom_boot_analyze` is one. This
# library covers strictly more: the bundles here name only
# `main = "lib/main.dart"`, while this globs all of `lib/`, so anything under it
# that no bundle reaches would otherwise be analyzed by nothing.
flutter_library(
    name = "app_lib",
    package_name = "web_example",
    srcs = glob(["lib/**/*.dart"]),
    deps = [
        "@deps//:flutter",
        "@rules_flutter//flutter:material_icons",
    ],
)

# =============================================================================
# Approach 4: compiler settings on a real app
#
# Everything above builds with the defaults. This target turns on the flags a
# deployment actually reaches for, so they are exercised against a real
# Flutter app rather than only against a `void main() {}` fixture — several of
# them (csp, the experiments, dump-info) only do anything once there is a
# program with imports, interop and icons in it.
# =============================================================================

flutter_web_app(
    name = "app_tuned",
    package_name = "web_example",
    app_name = "Web Example (tuned)",
    assets = glob(["assets/**"]),
    # The size report, produced as a named output rather than deployed. It
    # describes the dart2js build, so it needs the fallback to exist.
    dump_info = True,
    js_fallback = True,
    # Kept unminified and unstripped so the bundle can be read.
    minify_js = "false",
    minify_wasm = "false",
    strip_wasm = False,
    # Serves the renderer from the app itself, which is what lets this bundle
    # run under a `script-src 'self'` policy — the CDN copy is a script the
    # page may not fetch, and the app never boots without it.
    use_local_canvaskit = True,
    deps = [
        "@deps//:flutter",
        "@rules_flutter//flutter:material_icons",
    ],
)

# The defaults plus the opt-in JavaScript build: the WASM bundle with a dart2js
# fallback beside it, for browsers without WasmGC.
flutter_web_app(
    name = "app_fallback",
    package_name = "web_example",
    app_name = "Web Example (fallback)",
    assets = glob(["assets/**"]),
    js_fallback = True,
    deps = [
        "@deps//:flutter",
        "@rules_flutter//flutter:material_icons",
    ],
)

# WebAssembly for every browser engine flutter.js knows, instead of Flutter's
# default of Chromium only. A browser without WasmGC still gets the message the
# generated bootstrap shows, because there is no JavaScript build to run.
flutter_web_app(
    name = "app_all_browsers",
    package_name = "web_example",
    app_name = "Web Example (all browsers)",
    assets = glob(["assets/**"]),
    wasm_browsers = [
        "blink",
        "gecko",
        "webkit",
    ],
    deps = [
        "@deps//:flutter",
        "@rules_flutter//flutter:material_icons",
    ],
)

# The opposite: Chromium is left out of the allow-list, so Chrome finds no build
# it may run and the page shows the generated bootstrap's message. Stands in for
# a browser the loader refuses.
flutter_web_app(
    name = "app_no_blink",
    package_name = "web_example",
    app_name = "Web Example (no blink)",
    assets = glob(["assets/**"]),
    wasm_browsers = [
        "gecko",
        "webkit",
    ],
    deps = [
        "@deps//:flutter",
        "@rules_flutter//flutter:material_icons",
    ],
)

build_test(
    name = "wasm_browsers_build_test",
    targets = [
        ":app_all_browsers",
        ":app_no_blink",
    ],
)

build_test(
    name = "fallback_build_test",
    targets = [":app_fallback"],
)

build_test(
    name = "tuned_build_test",
    targets = [":app_tuned"],
)

# A profile build of the same app: release-shaped, but readable.
flutter_web_app(
    name = "app_profile",
    package_name = "web_example",
    app_name = "Web Example (profile)",
    assets = glob(["assets/**"]),
    profile = True,
    deps = [
        "@deps//:flutter",
        "@rules_flutter//flutter:material_icons",
    ],
)

build_test(
    name = "profile_build_test",
    targets = [":app_profile"],
)

dart_test(
    name = "verify_compiler_flags_test",
    data = [
        # The negative half of the `useLocalCanvasKit` check: a build that
        # never asked for it must not carry it, or the positive assertion
        # would hold for every bundle and mean nothing.
        ":app_all_browsers",
        ":app_fallback",
        ":app_js",
        ":app_no_blink",
        ":app_tuned",
        ":app_wasm",
    ],
    main = "test/verify_compiler_flags_test.dart",
    deps = ["@rules_dart//dart/runfiles"],
)
