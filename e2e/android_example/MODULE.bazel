"""E2e test: full Android APK via rules_flutter + rules_android composition.

The one e2e workspace set up for remote execution, as the README's "Remote
execution" describes it: `--incompatible_auto_exec_groups` and the hermetic
Python bootstrap in its .bazelrc, and the patches below that the rulesets an
Android app builds with need under them. Every other workspace is set up as
the README tells an app to be, with none of this.

Build it with both Android variables set. `ANDROID_NDK_HOME` must name the
*versioned* NDK directory; `$ANDROID_HOME/ndk` (its parent) fails inside
rules_android_ndk with an unrelated-looking `readdir()` error:

    ANDROID_HOME=~/Library/Android/sdk \\
    ANDROID_NDK_HOME=~/Library/Android/sdk/ndk/<version> \\
      bazel build //:app_android -c dbg

In a `.bazelrc` the same two values need `--repo_env`, not `--action_env` —
both repositories are fetched by repository rules, which never see
`--action_env`. See the Android section of the rules_flutter README.
"""

module(name = "rules_flutter_android_example")

bazel_dep(name = "rules_flutter", version = "0.0.0")
bazel_dep(name = "rules_dart", version = "0.8.1")
bazel_dep(name = "rules_cc", version = "0.2.28")
bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "rules_kotlin", version = "2.4.21")

local_path_override(
    module_name = "rules_flutter",
    path = "../..",
)

# Patches for `--incompatible_auto_exec_groups`, under which each action runs
# where the toolchain it names resolves. rules_android's runs aapt2, zipalign and
# apksigner where the Android SDK toolchain and the JDK both resolve (the Mac,
# whose SDK they are), and declares the JDK toolchain singlejar runs with.
# protobuf's names the proto toolchain on protoc actions. rules_go's runs a cgo
# link and a cgo stdlib build with the Go SDK resolved beside the C toolchain
# they need, so the Mac never runs the Linux Go SDK's tools. An override only
# applies in the root module: an Android app built with the flag needs these in
# its own MODULE.bazel. Drop each patch once a release of its module declares
# these toolchains and exec groups itself.
single_version_override(
    module_name = "rules_android",
    patch_strip = 1,
    patches = [
        "//patches:rules_android_auto_exec_groups.patch",
        # rules_android starts its tool JVMs with an initial heap as large as
        # the cap: -Xms3G for resource processing, -Xms8g for desugar, D8 and
        # R8. A JVM commits its initial heap the moment it starts. Linux and
        # macOS commit lazily and never notice; Windows charges it against the
        # commit limit (RAM plus pagefile), and two persistent desugar workers
        # exhaust that on a 16 GB machine. The patch keeps every cap and drops
        # the initial sizes. Drop it once a rules_android release does.
        "//patches:rules_android_no_initial_heap.patch",
    ],
)

single_version_override(
    module_name = "protobuf",
    patch_strip = 1,
    patches = ["//patches:protobuf_auto_exec_groups.patch"],
)

single_version_override(
    module_name = "rules_go",
    patch_strip = 1,
    patches = ["//patches:rules_go_auto_exec_groups.patch"],
)

# Pinned past the 0.1.5 release for 16KB page alignment. 0.1.5 links every
# arm64 .so with `-Wl,-z,max-page-size=4096`; a device booted with 16KB pages
# then refuses to load it — "ELF alignment check failed" — and nothing says so
# at build time, because the APK builds, installs and dies on launch. Upstream
# replaced that with 16384 for both max- and common-page-size, ungated, so it
# applies to every ABI; no release carries it yet, which is the only reason
# this is a commit rather than a version. Drop this override for the first
# release that includes it.
#
# 16KB alignment loads on a 4KB device too, so this is wider compatibility
# rather than a trade. The prebuilt engine libraries are unaffected —
# libflutter.so ships at 0x10000.
#
# The patch declares the exec constraints of the NDK found at
# `ANDROID_NDK_HOME`. Without them its toolchains match any execution
# platform, and a remote Linux worker would be sent the Mac's clang. Upstream
# sets them only for an NDK whose platform the rule is told. Once a release
# carries the alignment fix, keep the patch on that version, and drop it once a
# release sets exec constraints for a local NDK too.
archive_override(
    module_name = "rules_android_ndk",
    patch_strip = 1,
    patches = ["//patches:rules_android_ndk_exec_constraints.patch"],
    sha256 = "0f566314be1257379d42630e068618169e410e4ecf964b28e0c72559e2196658",
    strip_prefix = "rules_android_ndk-987213e7f982de48696f3b9cd031ff4e3e065c7c",
    urls = ["https://github.com/bazelbuild/rules_android_ndk/archive/987213e7f982de48696f3b9cd031ff4e3e065c7c.tar.gz"],
)

flutter = use_extension("@rules_flutter//flutter:extensions.bzl", "flutter")
flutter.toolchain(flutter_version = "3.47.9")

flutter_pub = use_extension("@rules_flutter//flutter/pub:extensions.bzl", "pub")
flutter_pub.from_lock(
    name = "deps",
    lock = "//:pubspec.lock",
)

use_repo(flutter, "flutter_toolchains", "flutter_web_sdk")

use_repo(flutter_pub, "deps")

register_toolchains("@flutter_toolchains//:all")

# Android, as the README's Android section sets it up.
bazel_dep(name = "rules_android", version = "0.8.1")
bazel_dep(name = "rules_android_ndk", version = "0.1.5")
bazel_dep(name = "rules_jvm_external", version = "7.2")

# The NDK CC toolchain, used for native and FFI deps built for Android and
# to strip the engine's native libraries, as a Gradle build does.
android_ndk_repository_extension = use_extension(
    "@rules_android_ndk//:extension.bzl",
    "android_ndk_repository_extension",
)

# Your app's `min_sdk_version` (24 unless you set it).
android_ndk_repository_extension.configure(api_level = 24)
use_repo(android_ndk_repository_extension, "androidndk")

register_toolchains("@androidndk//:all")

# The Android platform the app compiles against, rather than the newest one
# installed on the machine.
android_sdk_repository_extension = use_extension(
    "@rules_android//rules/android_sdk_repository:rule.bzl",
    "android_sdk_repository_extension",
)
android_sdk_repository_extension.configure(api_level = 35)
use_repo(android_sdk_repository_extension, "androidsdk")

# The Maven artifacts the app's own Kotlin code compiles against. They join
# rules_flutter's in one resolution, the app's, with a lock of this module's.
maven = use_extension("@rules_jvm_external//:extensions.bzl", "maven")
maven.install(
    name = "rules_flutter_maven",
    artifacts = [
        "androidx.annotation:annotation:1.9.1",
        "androidx.lifecycle:lifecycle-common:2.10.0",
    ],
    known_contributing_modules = ["rules_flutter"],
    lock_file = "//:rules_flutter_maven_install.json",
    repositories = [
        "https://maven.google.com",
        "https://repo1.maven.org/maven2",
    ],
)
use_repo(maven, "rules_flutter_maven")

# Hermetic C++ toolchain for Linux arm64 execution platforms, so a C++ tool
# built for the exec platform (zipper, xmllint) can be compiled when Bazel runs
# actions on a Linux arm64 worker. Only the Linux-exec, Linux-target toolchain
# exists: Mac and iOS builds keep apple_support's toolchain. It is registered
# only on request, with `--extra_toolchains=@llvm_toolchains//:all` (for
# example in .bazelrc.user, for builds that run on a Linux arm64 worker):
# registering it here would make every build fetch llvm-project's sources,
# which toolchain resolution loads the generated package from.
bazel_dep(name = "llvm", version = "0.8.26", dev_dependency = True)

llvm_tc = use_extension("@llvm//extensions:toolchain.bzl", "toolchain", dev_dependency = True)
llvm_tc.exec(
    arch = "aarch64",
    os = "linux",
)
llvm_tc.target(
    arch = "aarch64",
    os = "linux",
)
use_repo(llvm_tc, "llvm_toolchains")
