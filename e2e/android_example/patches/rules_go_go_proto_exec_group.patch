+# The exec group that runs protoc for a go_proto_library. The compiler builds
+# protoc, the plugin and go-protoc for this group, and go_proto_library runs
+# the action in an identical one, so the action lands on the platform its
+# tools were built for. With the tools built for the compiler's default exec
+# group instead, its Go and C++ toolchains could pick a different platform
+# than the action's.
+GO_PROTO_GEN_EXEC_GROUP = "internal_use_only_go_proto_gen"
+
+def go_proto_gen_exec_group():
+    return exec_group(toolchains = _use_toolchain(_PROTO_TOOLCHAIN_TYPE))
+
