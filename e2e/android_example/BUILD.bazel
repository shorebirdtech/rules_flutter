# =============================================================================
# Shared: Flutter application (Dart compilation)
# =============================================================================

# Native FFI library. It is built with the Android NDK toolchain for the
# platform the APK is built for, once for each of --@rules_android//flags:android_platforms.
cc_library(
    name = "add_cc",
    srcs = ["native/add.c"],
    hdrs = ["native/add.h"],
)

cc_shared_library(
    name = "add",
    deps = [":add_cc"],
)

# One counter, bound under two packages' asset ids. Each package declares a
# standalone library of its own (`counter_a`, `counter_b`); the app serves both
# ids from the combined `counter` instead, which the APK carries once, so the
# process loads one image and a bump through either id moves one count. See
# `lib/shared_counter_ffi.dart`.
cc_library(
    name = "counter_cc",
    srcs = ["native/counter.c"],
    hdrs = ["native/counter.h"],
)

[
    cc_shared_library(
        name = name,
        deps = [":counter_cc"],
    )
    for name in [
        "counter",
        "counter_a",
        "counter_b",
    ]
]

[
    dart_code_asset(
        name = "count_%s_%s" % (package, which),
        asset_id = "package:count_%s/count_%s" % (package, package),
        shared_library = library,
        visibility = ["//count_%s:__pkg__" % package],
    )
    for package in [
        "a",
        "b",
    ]
    for which, library in [
        (
            "own",
            ":counter_" + package,
        ),
        ("combined", ":counter"),
    ]
]

dart_package_metadata(
    name = "pubspec-metadata",
    package_name = "android_example",
)

flutter_application(
    name = "app_flutter",
    srcs = glob(["lib/**/*.dart"]),
    # Not the default: every app built over this has it as its version, and
    # `:second_app` states it too, which has to agree.
    build_name = "2.3.4",
    build_number = "42",
    code_assets = [
        ":count_a_combined",
        ":count_b_combined",
    ],
    main = "lib/main.dart",
    native_deps = [":add"],
    package = ":pubspec-metadata",
    deps = [
        "//count_a",
        "//count_b",
        "@deps//:flutter",
        "@rules_flutter//flutter:material_icons",
    ],
)

# An application only a test may depend on, as one an integration test builds for
# itself is. Everything `flutter_android_app` declares around it has to be
# `testonly` too: `:testonly_app_build_test`.
flutter_application(
    name = "testonly_flutter",
    testonly = True,
    srcs = glob(["lib/**/*.dart"]),
    main = "lib/testonly_main.dart",
    package = ":pubspec-metadata",
    deps = ["@deps//:flutter"],
)

# =============================================================================
# Approach 1: Flutter-generated runner (flutter_android_app)
#
# Recommended for most users. Requires android/app/src/main/ from
# `flutter create --platforms=android .`.
# The macro auto-discovers the manifest and resources from the conventional
# directory and wires everything automatically.
# =============================================================================

flutter_android_app(
    name = "app",
    app_bundle = "app_bundle",
    application = ":app_flutter",
    application_id = "com.example.flutterapp",
    # `flutter create` grants INTERNET in the debug variant manifest only —
    # a *debugging* requirement for the Dart VM service, not the app's
    # network grant. A release APK built from the untouched scaffold cannot
    # open a socket at all (Android enforces INTERNET via AID_INET group
    # membership; every connect fails with EACCES, with no build error).
    # An app that networks declares it here, and gets it in every
    # compilation mode. Verified from inside the built APK by
    # :verify_android_permissions_test.
    permissions = ["android.permission.INTERNET"],
)

# `bazel run :app_release` signs `:app_bundle` and the APK of the same build
# with the upload key android/key.properties names: release mode, every
# default ABI (armeabi-v7a, arm64-v8a and x86_64). `:verify_android_release_test` signs with a key it makes itself.
flutter_android_release(
    name = "app_release",
    app_bundle = ":app_bundle",
)

# The same flutter create runner shipped under a second application id. Its
# MainActivity.kt declares `package com.example.flutterapp`, and the manifest
# names `.MainActivity`, which Android resolves against the code's package
# (Gradle's `namespace`), not the application id. Its version, from
# `build_name` and `build_number`, is not the default. Both checked by
# :verify_android_second_app_test.
flutter_android_app(
    name = "second_app",
    application = ":app_flutter",
    application_id = "com.example.flutterapp.second",
    build_name = "2.3.4",
    build_number = 42,
    # A placeholder of the app's own passes through to `android_binary`
    # beside the ones the macro sets.
    manifest_values = {"appLabelSuffix": " (second)"},
    namespace = "com.example.flutterapp",
    # The VM service's grant, which this workspace has no debug variant
    # manifest to give, so `flutter_bazel run` can debug it.
    permissions = ["android.permission.INTERNET"],
)

flutter_android_app(
    name = "testonly_app",
    testonly = True,
    application = ":testonly_flutter",
    application_id = "com.example.flutterapp.testonly",
    namespace = "com.example.flutterapp",
)

# A native library the APK packages that is not the Flutter application's: a
# `cc_library` listed directly on the `android_binary`, which links it into a
# `lib<name>.so` of its own. `flutter_bazel run`'s restart has to notice an edit
# to it and relaunch, as it does for the application's `native_deps`
# (`android_restart_e2e_test`).
cc_library(
    name = "extra_native",
    srcs = ["native/extra.c"],
    hdrs = ["native/extra.h"],
    alwayslink = True,
)

# A prebuilt shared library checked into the workspace (built from
# native/prebuilt/prebuilt.c with the NDK's
# `aarch64-linux-android30-clang -shared -fPIC -Wl,-soname,libprebuilt.so`), so
# a source file, not a build output, is what the APK packages.
cc_import(
    name = "prebuilt_native",
    shared_library = "native/prebuilt/libprebuilt.so",
)

# A prebuilt static archive (native/prebuilt/prebuilt_static.c, compiled with
# the same compiler and archived with `llvm-ar rcsD`), which the APK links into
# the binary's own library. `alwayslink` keeps it there though nothing calls it.
# libprebuilt_static_next.a is the same source built with
# -DPREBUILT_STATIC_VALUE=2, which no target uses: the e2e swaps it in.
cc_import(
    name = "prebuilt_static",
    static_library = "native/prebuilt/libprebuilt_static.a",
    alwayslink = True,
)

# A library an AAR carries, which the APK packages under `lib/<abi>/`. The AAR
# is built here so that a test can edit the library's source.
cc_binary(
    name = "libaar_native.so",
    srcs = ["native/aar_native.c"],
    linkshared = True,
)

android_archive(
    name = "aar_native_archive",
    library = ":libaar_native.so",
    package = "com.example.flutterapp.aarnative",
)

aar_import(
    name = "aar_native",
    aar = ":aar_native_archive",
)

flutter_android_manifest_gen(
    name = "native_dep_manifest",
    application_id = "com.example.flutterapp.nativedep",
)

flutter_android_runner_lib_gen(
    name = "native_dep_runner_lib",
    engine = ":app_engine",
    namespace = "com.example.flutterapp.nativedep",
)

# The Tier 2 runner with `extra_native` listed on the `android_binary` itself,
# which the Tier 1 macro cannot take (its `deps` also feed the plugin
# registrant, which needs Java). Launchable under `-c dbg`: the generated
# manifest grants the VM service its INTERNET.
android_binary(
    name = "native_dep_app",
    assets = [":app_flutter_assets"],
    assets_dir = "assets",
    custom_package = "com.example.flutterapp.nativedep",
    manifest = ":native_dep_manifest",
    # Stored uncompressed, as the manifest's android:extractNativeLibs="false"
    # requires: Android refuses to install the APK otherwise.
    nocompress_extensions = [".so"],
    tags = ["manual"],
    deps = [
        ":aar_native",
        ":app_engine",
        ":app_native_libs",
        ":extra_native",
        ":native_dep_runner_lib",
        ":prebuilt_native",
        ":prebuilt_static",
    ],
)

# =============================================================================
# Shared Android targets (used by approaches 2 & 3)
# =============================================================================

flutter_android_bundle(
    name = "app_android",
    application = ":app_flutter",
)

# The bundle's native libraries, for composable wiring: libapp.so and the
# FFI library, offered for each ABI android_binary builds for.
filegroup(
    name = "app_native_libs_files",
    srcs = [":app_android"],
    output_group = "native_libs",
    tags = ["manual"],
)

cc_library(
    name = "app_native_libs",
    srcs = [":app_native_libs_files"],
    tags = ["manual"],
)

flutter_android_engine(
    name = "app_engine",
)

# Extract flutter_assets for composable approaches.
filegroup(
    name = "app_flutter_assets",
    srcs = [":app_android"],
    output_group = "mobile_install",
    tags = ["manual"],
)

# =============================================================================
# Approach 2: Bazel-generated runner (flutter_android_runner_lib_gen)
#
# For users without `flutter create` output. Uses template manifest and
# Kotlin MainActivity from rules_flutter. Only needs a namespace.
# =============================================================================

flutter_android_manifest_gen(
    name = "bazel_runner_manifest",
    app_name = "Flutter App (Bazel Runner)",
    application_id = "com.example.flutterapp.bazelrunner",
)

flutter_android_runner_lib_gen(
    name = "bazel_runner_lib",
    engine = ":app_engine",
    namespace = "com.example.flutterapp.bazelrunner",
)

android_binary(
    name = "app_bazel_runner",
    assets = [":app_flutter_assets"],
    assets_dir = "assets",
    custom_package = "com.example.flutterapp.bazelrunner",
    manifest = ":bazel_runner_manifest",
    # Stored uncompressed, as the manifest's android:extractNativeLibs="false"
    # requires: Android refuses to install the APK otherwise.
    nocompress_extensions = [".so"],
    tags = ["manual"],
    deps = [
        ":app_engine",
        ":app_native_libs",
        ":bazel_runner_lib",
    ],
)

# =============================================================================
# Approach 3: Custom runner (manual wiring with Kotlin)
#
# For advanced users who want full control. User provides their own
# AndroidManifest.xml and custom Kotlin Activity, compiled via
# kt_android_library with flutter_android_bundle + flutter_android_engine.
# =============================================================================

kt_android_library(
    name = "custom_runner_lib",
    srcs = ["custom_runner/MainActivity.kt"],
    custom_package = "com.example.flutterapp.customrunner",
    manifest = "custom_runner/AndroidManifest.xml",
    tags = ["manual"],
    deps = [
        ":app_engine",
        "@rules_android_maven//:androidx_annotation_annotation",
        "@rules_android_maven//:androidx_lifecycle_lifecycle_common",
    ],
)

android_binary(
    name = "app_custom_runner",
    assets = [":app_flutter_assets"],
    assets_dir = "assets",
    custom_package = "com.example.flutterapp.customrunner",
    manifest = "custom_runner/AndroidManifest.xml",
    tags = ["manual"],
    deps = [
        ":app_engine",
        ":app_native_libs",
        ":custom_runner_lib",
    ],
)

# =============================================================================
# Web build — same Dart code, no native deps.
# =============================================================================

flutter_web_bundle(
    name = "app_web",
    srcs = glob(["lib/**/*.dart"]),
    main = "lib/main.dart",
    package = ":pubspec-metadata",
    deps = ["@deps//:flutter"],
)

# =============================================================================
# Tests
# =============================================================================

build_test(
    name = "android_app_build_test",
    targets = [":app"],
)

# `flutter_android_app` takes `testonly = True`: every target it declares is
# `testonly` too, so none is a non-test target depending on a `testonly`
# application.
build_test(
    name = "testonly_app_build_test",
    targets = [":testonly_app"],
)

build_test(
    name = "android_bazel_runner_build_test",
    targets = [":app_bazel_runner"],
)

build_test(
    name = "android_custom_runner_build_test",
    targets = [":app_custom_runner"],
)

build_test(
    name = "web_build_test",
    targets = [":app_web"],
)

dart_test(
    name = "verify_android_apk_test",
    data = [
        ":app",
        "@bazel_tools//tools/zip:zipper",
    ],
    env = {"ZIPPER_RUNFILE": "$(rlocationpath @bazel_tools//tools/zip:zipper)"},
    main = "test/verify_android_apk_test.dart",
    deps = ["@rules_flutter//tools/e2e_testing"],
)

dart_test(
    name = "verify_android_second_app_test",
    data = [
        ":second_app",
        "@bazel_tools//tools/zip:zipper",
    ],
    env = {"ZIPPER_RUNFILE": "$(rlocationpath @bazel_tools//tools/zip:zipper)"},
    main = "test/verify_android_second_app_test.dart",
    deps = ["@rules_flutter//tools/e2e_testing"],
)

# Reads the permissions out of the compiled binary AndroidManifest.xml inside
# the built APK. Bazel's default fastbuild is not `-c dbg`, so this APK takes
# the non-debug manifest arm — finding INTERNET proves it came from
# flutter_android_app(permissions = ...) rather than from flutter create's
# debug variant overlay.
dart_test(
    name = "verify_android_permissions_test",
    data = [
        ":app",
        "@bazel_tools//tools/zip:zipper",
    ],
    env = {"ZIPPER_RUNFILE": "$(rlocationpath @bazel_tools//tools/zip:zipper)"},
    main = "test/verify_android_permissions_test.dart",
    deps = ["@rules_flutter//tools/e2e_testing"],
)

# Runs `:app_release` as `bazel run` would, with a keystore of its own, and
# checks what it signs with the SDK's own tools. The bundle is built through
# the rule's release transition, so this is a release build for both ABIs in a
# plain `bazel test`.
filegroup(
    name = "app_release_config",
    srcs = [":app_release"],
    output_group = "android_release_config",
)

dart_test(
    name = "verify_android_release_test",
    data = [
        ":app_release",
        ":app_release_config",
        "@androidsdk//:apksigner",
        "@androidsdk//:zipalign",
        "@bazel_tools//tools/zip:zipper",
    ],
    env = {
        "APKSIGNER_RUNFILE": "$(rlocationpath @androidsdk//:apksigner)",
        "RELEASE_CONFIG_RUNFILE": "$(rlocationpath :app_release_config)",
        "RELEASE_RUNFILE": "$(rlocationpath :app_release)",
        "ZIPALIGN_RUNFILE": "$(rlocationpath @androidsdk//:zipalign)",
        "ZIPPER_RUNFILE": "$(rlocationpath @bazel_tools//tools/zip:zipper)",
    },
    main = "test/verify_android_release_test.dart",
    deps = [
        "@rules_dart//dart/runfiles",
        "@rules_flutter//tools/e2e_testing",
    ],
)

dart_test(
    name = "verify_android_app_test",
    data = [
        ":app",
        "@androidsdk//:adb",
    ],
    # The `adb` of the Android SDK Bazel resolved, so the test needs nothing
    # on `PATH`.
    env = {"ADB_RUNFILE": "$(rlocationpath @androidsdk//:adb)"},
    main = "test/verify_android_app_test.dart",
    tags = [
        "exclusive",
        "manual",
    ],
    deps = ["@rules_flutter//tools/e2e_testing"],
)

# `manual`, so `bazel test //...` never gives it to the analysis aspect; this
# checks it anyway.
dart_analysis_test(
    name = "verify_android_app_test_analysis",
    targets = [":verify_android_app_test"],
)

# The workspace's lint ruleset, bundled with the pub package whose YAML its
# `include:` resolves against. Named here rather than in a library's `deps`: a
# lint ruleset is not a dependency of the code it lints, and listing it there
# carries it into the `DartInfo` of every binary and test downstream.
dart_analysis_options(
    name = "options",
    src = "analysis_options.yaml",
    deps = ["@deps//:very_good_analysis"],
)

# Every `analysis_options.yaml` in this workspace, for the `dart_analyze`
# aspect `.bazelrc` enables: each Dart file is checked against the nearest
# listed one above it.
dart_analysis_config(
    name = "analysis_config",
    options = [":options"],
)

# Static analysis over this example's Dart. The app rule is a bundle and
# carries no DartInfo, so the sources are declared once more as a library for
# the analyzer to stage.
flutter_library(
    name = "app_lib",
    srcs = glob(["lib/**/*.dart"]),
    package = ":pubspec-metadata",
    deps = [
        "@deps//:flutter",
    ],
)
