load("@rules_dart//dart:defs.bzl", "dart_binary", "dart_codegen")
load("@rules_flutter//flutter:defs.bzl", "dart_package_metadata", "flutter_library")

# Dependency package whose hand-written source IMPORTS a generated standalone
# library (catalog.g.dart). Consumed by //:app — exercises the import-as-library
# codegen shape in a non-app package.

dart_package_metadata(
    name = "pubspec-metadata",
    package_name = "dep_lib",
)

dart_codegen(
    name = "catalog_gen",
    src = "lib/catalog.dart",
    generator = ":catalog_generator",
    output_suffixes = [".g.dart"],
    package = ":pubspec-metadata",
)

flutter_library(
    name = "dep_lib",
    srcs = [
        "lib/catalog.dart",
        ":catalog_gen",
    ],
    package = ":pubspec-metadata",
    visibility = ["//visibility:public"],
)

# The generator: a Builder behind rules_dart's shim runner, over the shim and
# pub packages the workspace's `//tools` package resolves.
dart_binary(
    name = "catalog_generator",
    srcs = ["tools/catalog_generator.dart"],
    code_assets_from_packages = False,
    main = "tools/catalog_generator.dart",
    deps = [
        "//tools:builder_shim",
        "@generator_pub_deps//:build",
    ],
)
