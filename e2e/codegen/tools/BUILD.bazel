load("@rules_dart//dart:defs.bzl", "dart_binary")
load("@rules_dart//dart/ext:defs.bzl", "builder_shim_library")

# The generators of this workspace's codegen rules. A generator is an
# executable that speaks the builder shim's worker protocol: a `dart_binary`
# whose `main` hands a `package:build` Builder to `shimMain`. It is built for
# the execution platform and runs as a persistent worker.

exports_files(["pubspec.lock"])

# rules_dart's shim runner over the packages `generator_pub_deps` resolves
# (`pubspec.lock` beside this file), so a generator has one `analyzer` and one
# `build`. The dependency packages' generators share it.
builder_shim_library(
    name = "builder_shim",
    pub_hub = "@generator_pub_deps",
    visibility = ["//visibility:public"],
)

# The generators' source files are their targets' `srcs`, so the analysis
# aspect checks them to the same very_good_analysis bar as the app code.
[dart_binary(
    name = name,
    srcs = ["%s.dart" % name],
    code_assets_from_packages = False,
    main = "%s.dart" % name,
    visibility = ["//visibility:public"],
    deps = [
        ":builder_shim",
        "@generator_pub_deps//:build",
    ] + extra_deps,
) for name, extra_deps in {
    "simple_generator": [],
    "json_generator": [],
    "aggregate_generator": ["@generator_pub_deps//:glob"],
    "ui_type_generator": ["@generator_pub_deps//:analyzer"],
}.items()]
