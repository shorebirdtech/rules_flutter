"E2e test: cross-compile Flutter Linux bundles from macOS using LLVM toolchain"

module(name = "rules_flutter_cross_compile_example")

bazel_dep(name = "rules_flutter", version = "0.0.0")
bazel_dep(name = "rules_dart", version = "0.8.1")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "llvm", version = "0.8.26")

local_path_override(
    module_name = "rules_flutter",
    path = "../..",
)

flutter = use_extension("@rules_flutter//flutter:extensions.bzl", "flutter")
flutter.toolchain(flutter_version = "3.47.9")

flutter_pub = use_extension("@rules_flutter//flutter:extensions.bzl", "flutter_pub")
flutter_pub.from_lock(
    name = "deps",
    lock = "//:pubspec.lock",
)

use_repo(flutter, "flutter_toolchains")

use_repo(flutter_pub, "deps")

register_toolchains("@flutter_toolchains//:all")

# Hermetic LLVM CC toolchains for the linux_x64 target this workspace builds,
# from each Mac and Linux host and from a Linux arm64 remote worker. Only these
# pairs, not `:all`, which would also claim macOS-target compiles from Apple's
# toolchain.
register_toolchains(
    "@llvm//toolchain:macos_aarch64_to_linux_x86_64",
    "@llvm//toolchain:macos_x86_64_to_linux_x86_64",
    "@llvm//toolchain:linux_aarch64_to_linux_x86_64",
    "@llvm//toolchain:linux_x86_64_to_linux_x86_64",
)

# Hermetic C++ toolchain for Linux arm64 execution platforms, so a C++ tool
# built for the exec platform (zipper, xmllint) can be compiled when Bazel runs
# actions on a Linux arm64 worker. Only the Linux-exec, Linux-target toolchain
# exists: Mac and iOS builds keep apple_support's toolchain. It is registered
# only on request, with `--extra_toolchains=@llvm_toolchains//:all` (for
# example in .bazelrc.user, for builds that run on a Linux arm64 worker).
llvm_tc = use_extension("@llvm//extensions:toolchain.bzl", "toolchain", dev_dependency = True)
llvm_tc.exec(
    arch = "aarch64",
    os = "linux",
)
llvm_tc.target(
    arch = "aarch64",
    os = "linux",
)
use_repo(llvm_tc, "llvm_toolchains")
