load("@rules_dart//dart:defs.bzl", "dart_test")
load("@rules_flutter//flutter:defs.bzl", "dart_data_asset", "dart_package_metadata", "flutter_application")
load("@rules_flutter//flutter:macos.bzl", "flutter_macos_app")
load("@rules_flutter//flutter:web.bzl", "flutter_web_bundle")

exports_files(["pubspec.lock"])

# A data asset of the app's own package, which has no link hook: it ships as
# declared, linked or not.
dart_data_asset(
    name = "greeting",
    src = "greeting.txt",
    asset_id = "package:link_hooks/greeting.txt",
)

dart_package_metadata(
    name = "pubspec-metadata",
    package_name = "link_hooks",
    data_assets = [":greeting"],
)

# `glyphs`' link hook runs over the uses the release compile records and emits
# the index of glyphs the app constructs, bundled at
# `flutter_assets/packages/glyphs/glyphs/index.json`, and the declared glyphs
# it constructs (`heart` and `star`, not `moon`).
flutter_application(
    name = "app",
    link_hook_assets = [
        "package:glyphs/glyphs/heart.txt",
        "package:glyphs/glyphs/index.json",
        "package:glyphs/glyphs/star.txt",
    ],
    main = "lib/main.dart",
    package = ":pubspec-metadata",
    deps = [
        "//glyphs",
        "@deps//:flutter",
        "@rules_flutter//flutter:material_icons",
    ],
)

flutter_macos_app(
    name = "macos_app",
    app_name = "Link Hooks",
    application = ":app",
    bundle_id = "com.example.linkhooks",
    target_compatible_with = ["@platforms//os:macos"],
)

# The same app with a `Glyph` built at run time: the hook refuses it, so this
# must fail to build. Tagged manual so `//...` stays green; the e2e suite
# builds it and checks the hook's message reaches the user.
flutter_application(
    name = "dynamic_app",
    link_hook_assets = [
        "package:glyphs/glyphs/heart.txt",
        "package:glyphs/glyphs/index.json",
        "package:glyphs/glyphs/star.txt",
    ],
    main = "lib/dynamic_main.dart",
    package = ":pubspec-metadata",
    tags = ["manual"],
    deps = [
        "//glyphs",
        "@deps//:flutter",
        "@rules_flutter//flutter:material_icons",
    ],
)

# The same app on the web, once per compiler `flutter build web` links for:
# the link hooks run over the uses dart2wasm records, and over dart2js's when
# the bundle has no WebAssembly build.
flutter_web_bundle(
    name = "web_wasm",
    application = ":app",
)

flutter_web_bundle(
    name = "web_js",
    application = ":app",
    compiler = "dart2js",
)

config_setting(
    name = "debug",
    values = {"compilation_mode": "dbg"},
    visibility = ["//:__subpackages__"],
)

# Release bundles hold what the hooks ship; debug ones, which link nothing,
# every declared glyph and no index.
dart_test(
    name = "bundle_test",
    args = select({
        ":debug": ["--debug"],
        "//conditions:default": [],
    }) + [
        "$(rlocationpaths :app)",
        "$(rlocationpaths :web_wasm)",
        "$(rlocationpaths :web_js)",
    ],
    data = [
        ":app",
        ":web_js",
        ":web_wasm",
    ],
    main = "bundle_test.dart",
    deps = ["@rules_dart//dart/runfiles"],
)
