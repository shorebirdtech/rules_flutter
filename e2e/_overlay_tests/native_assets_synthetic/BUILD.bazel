load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_shared_library.bzl", "cc_shared_library")
load("@rules_dart//dart:defs.bzl", "dart_code_asset")
load("@rules_flutter//flutter:defs.bzl", "dart_package_metadata", "flutter_application", "flutter_plugin")
load("@rules_flutter//flutter:native_assets.bzl", "flutter_data_asset")

exports_files(["pubspec.lock"])

# 1. The native side.
cc_library(
    name = "_synthetic_cc",
    srcs = ["native/synthetic.c"],
)

cc_shared_library(
    name = "_synthetic_dylib",
    # The name it lands under in `Contents/Frameworks/`, and the one its
    # install name gives.
    shared_lib_name = "synthetic.dylib",
    target_compatible_with = ["@platforms//os:macos"],
    user_link_flags = [
        "-Wl,-install_name,@rpath/synthetic.dylib",
    ],
    deps = [":_synthetic_cc"],
)

# 2. The Native Assets — a code asset, owned by the package and routed by
#    the `select()` on its metadata below, and a data asset. Apple builds are
#    single-arch here; multi-arch is handled separately via
#    `apple_universal_binary`.
dart_code_asset(
    name = "synthetic_native_asset_macos",
    asset_id = "package:native_assets_synthetic/synthetic.dylib",
    shared_library = ":_synthetic_dylib",
    target_compatible_with = ["@platforms//os:macos"],
)

flutter_data_asset(
    name = "synthetic_blob",
    asset_id = "package:native_assets_synthetic/blob.txt",
    file = "data/blob.txt",
)

dart_package_metadata(
    name = "pubspec-metadata",
    package_name = "native_assets_synthetic",
    code_assets = select({
        "@platforms//os:macos": [":synthetic_native_asset_macos"],
        "//conditions:default": [],
    }),
)

# 3. A flutter_plugin glue target that pulls the data asset into the
#    FlutterInfo dep graph. Empty `platforms = []` keeps it acting as a
#    plain pure-Dart container; the only purpose is to surface FlutterInfo
#    with the asset entry for transitive pickup by `flutter_application`.
#
#    It names the app's own `dart_package_metadata` because it shares the
#    app's Bazel package, and two Dart packages cannot be rooted at one
#    directory. Carrying no sources it is not a package in its own
#    right, and its assets are already id'd under the app's name.
flutter_plugin(
    name = "synthetic_glue",
    srcs = [],
    data_assets = [":synthetic_blob"],
    package = ":pubspec-metadata",
    platforms = [],
)

# 4. The application itself.
flutter_application(
    name = "synthetic_app",
    main = "lib/main.dart",
    package = ":pubspec-metadata",
    deps = [
        ":synthetic_glue",
        "@deps//:flutter",
        "@rules_flutter//flutter:material_icons",
    ],
)

# 5. Build test exercising the application + Native Assets pipeline.
#    This workspace deliberately omits a `macos/Runner/` runner — the
#    purpose is to regress-test the *generic* infrastructure
#    (manifest emission, dylib bundling helpers, data-asset placement);
#    the dev_tool screenshot e2e proves runtime correctness against
#    `e2e/plugin_example`'s `:plugin_app` once `flutter create` is
#    available.
build_test(
    name = "synthetic_app_build_test",
    targets = [
        ":synthetic_app",
        ":_synthetic_dylib",
        ":synthetic_blob",
    ],
)
