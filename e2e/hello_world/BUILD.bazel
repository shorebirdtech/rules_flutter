# Constants that break a `const` constructor's assertion. `flutter test` fails
# to compile a test that holds one, so compiling each of these programs MUST
# FAIL, with a "Constant evaluation error" naming the assertion. The programs
# are `manual`, since they do not build; each `_test` runs the compile that
# fails and passes only when it fails so, and `_builds` does that in each of
# the four builds. `_entry` holds the constant in the test's own file, `_dep`
# in a library it depends on: in the modular build that library's compile
# records the error, and the entry compile of the program that reaches it
# fails with it.
[
    (
        flutter_test_program(
            name = "const_violation_%s" % where,
            testonly = True,
            main = "test/asserts/const_violation_%s_test.dart" % where,
            package = ":pubspec-metadata",
            tags = ["manual"],
            deps = [
                dep,
                "@deps//:flutter_test",
            ],
        ),
        compile_fail_test(
            name = "const_violation_%s_test" % where,
            size = "small",
            mnemonics = [
                "DartEntryKernel",
                "DartKernel",
            ],
            output_contains = [
                "Constant evaluation error",
                "This assertion failed with message: Positive: -1 is not positive",
            ],
            target = ":const_violation_%s" % where,
        ),
        build_variant_tests(
            name = "const_violation_%s_builds" % where,
            test = ":const_violation_%s_test" % where,
        ),
    )
    # What each one's test imports: the library the constant is in, or the
    # one whose constructor it breaks.
    for where, dep in [
        ("entry", "//asserts_dep"),
        ("dep", "//asserts_violation_dep"),
    ]
]

# Bazel's test protocol under `flutter_test`: `--test_filter` selects cases,
# `shard_count` splits them, and each case is reported in the XML Bazel
# collects. (Its `size`/`timeout` as the suite's default timeout is unit-tested
# on `suiteTimeout` in `flutter_test_runner_test`.) The sharded twin is what proves
# the runner declares sharding support; see the test file.
# An Impeller-only shader, drawn in flutter_tester running Impeller.
flutter_test(
    name = "impeller_shader_test",
    enable_impeller = True,
    main = "test/impeller_shader_test.dart",
    package = ":pubspec-metadata",
    shaders = ["shaders/indexed.frag"],
    deps = [
        "@deps//:flutter",
        "@deps//:flutter_test",
    ],
)

