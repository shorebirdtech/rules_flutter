# Constants that break a `const` constructor's assertion. `flutter test` fails
# to compile a test that holds one, so building each of these MUST FAIL, with a
# "Constant evaluation error" naming the assertion. They are `manual` because a
# failing build has no place in `bazel test //...`; docs/TESTING.md (the
# "`flutter_test` build modes" section) says how to check them.
[
    flutter_test(
        name = "const_violation_%s_test" % where,
        package_name = "hello_world",
        main = "test/asserts/const_violation_%s_test.dart" % where,
        tags = ["manual"],
        deps = [
            "//asserts_dep",
            "//asserts_violation_dep",
            "@deps//:flutter_test",
        ],
    )
    for where in [
        "entry",
        "dep",
    ]
]

