    args = [
        "hello_world_linux",
        "lib/libapp.so",
    ],
    data = [":hello_world_linux_profile"],
    main = "test/verify_profile_bundle_test.dart",
    target_compatible_with = ["@platforms//os:linux"],
    deps = [
        "@deps//:test",
        "@rules_flutter//tools/e2e_testing",
    ],
)

dart_test(
    name = "verify_windows_profile_bundle_test",
    args = [
        "hello_world_windows",
        "data/app.so",
    ],
    data = [":hello_world_windows_profile"],
    main = "test/verify_profile_bundle_test.dart",
    target_compatible_with = ["@platforms//os:windows"],
    deps = [
        "@deps//:test",
        "@rules_flutter//tools/e2e_testing",
    ],
)

# Verifies the asset bundle structure for pub-package fonts/assets:
# cupertino_icons (flutter.fonts), flutter_localized_locales (flutter.assets),
# and the toolchain-backed material_icons. Asserts files land at
# packages/<pkg>/<path>, FontManifest.json carries the prefixed family for
# pub fonts and a bare family for material_icons (the package_name = ""
# sentinel), and AssetManifest.bin.json references the prefixed asset path.
dart_test(
    name = "verify_pub_assets_test",
    data = [":hello_world_app"],
    main = "test/verify_pub_assets_test.dart",
    deps = [
        "@deps//:test",
        "@rules_flutter//tools/e2e_testing",
    ],
)

# Verifies that the entitlements blob applied at codesign time on the
# macOS bundle declares the App Sandbox capability — proves
# flutter_macos_app threaded macos/Runner/{DebugProfile,Release}.entitlements
# through to macos_application(entitlements = ...).
#
# iOS doesn't have a counterpart runtime test: rules_apple's
# codesigning pipeline strips user entitlements down to a single
# get-task-allow=true entry for simulator builds (per
# external/rules_apple/.../codesigning_support.bzl), so a sim-build
# codesign blob can't reflect forwarded entitlements. Forwarding is
# verified by `bazel cquery 'deps(//:hello_world_ios)' | grep
# Runner.entitlements`, and the existing `ios_bundle_build_test`
# proves the bundle still analyzes with the auto-discovered file.
dart_test(
    name = "verify_macos_entitlements_test",
    data = [":hello_world_macos"],
    main = "test/verify_macos_entitlements_test.dart",
    target_compatible_with = ["@platforms//os:macos"],
    deps = ["@rules_flutter//tools/e2e_testing"],
)

# The app icon `flutter create` leaves in the tree, which this BUILD file
# never mentions — `flutter_macos_app` discovers it, and the bundle has to
# actually carry it. See the test's own docs for why the Info.plist assertion
# is the load-bearing half.
dart_test(
    name = "verify_macos_app_icon_test",
    data = [":hello_world_macos"],
    main = "test/verify_macos_app_icon_test.dart",
    target_compatible_with = ["@platforms//os:macos"],
    deps = ["@rules_flutter//tools/e2e_testing"],
)

# The workspace's lint ruleset, bundled with the pub package its `include:`
# resolves against. Named here rather than in any library's `deps`: a lint
# ruleset is not a dependency of the code it lints, and listing it there would
# carry it into the `DartInfo` of every binary and test downstream.
dart_analysis_options(
    name = "options",
    src = "analysis_options.yaml",
    deps = ["@deps//:very_good_analysis"],
)

# Every `analysis_options.yaml` in this workspace, for the `dart_analyze`
# aspect `.bazelrc` enables: each Dart file is checked against the nearest
# listed one above it.
dart_analysis_config(
    name = "analysis_config",
    options = [":options"],
)

# Static analysis over this example's Dart. The app rule is a bundle and
# carries no DartInfo, so the sources are declared once more as a library for
# the analyzer to stage.
flutter_library(
    name = "app_lib",
    srcs = glob(["lib/**/*.dart"]),
    package = ":pubspec-metadata",
    deps = [
        "@deps//:cupertino_icons",
        "@deps//:flutter",
        "@deps//:flutter_localized_locales",
        "@rules_flutter//flutter:material_icons",
    ],
)

# -- Reproducibility -----------------------------------------------------------
#
# Property: every output is a function of its declared inputs only, so none
# holds a path of the machine or sandbox that built it, or a byte that depends
# on the host OS. The tests (see their headers for why this is the property to
# defend) look through the files of a build made in each Flutter mode, which
# `build_in_mode` makes in one plain `bazel test`.
#
# The parts of an app are built separately, so a failure names the one that
# leaks: the kernel (`:hello_world`, which a debug app ships as its code), the
# AOT snapshot (`:hello_world_aot`, and the app, which ships one in every mode
# but debug), the asset bundle, and the web bundle with both compilers.

_REPRO_PARTS = {
    "kernel": [":hello_world"],
    "aot": [
        ":hello_world_aot",
        ":hello_world_app",
    ],
    "assets": [":hello_world_assets"],
    "web": [":hello_world_web"],
}

# A debug app is a kernel, not an AOT snapshot, so it has no `aot` build.
_REPRO_BUILDS = [
    ("aot", "fastbuild"),
    ("aot", "release"),
    ("assets", "debug"),
    ("assets", "fastbuild"),
    ("assets", "release"),
    ("assets", "profile"),
    ("web", "fastbuild"),
    ("web", "release"),
]

[build_in_mode(
    name = "repro_%s_%s" % (part, mode),
    mode = mode,
    targets = _REPRO_PARTS[part] + (
        # What a debug app ships as its code: the app's own kernel.
        [":hello_world_app"] if (part, mode) == ("kernel", "debug") else []
    ),
) for part, mode in _REPRO_BUILDS]

# Windows is left out: its paths are not the forward-slash ones the markers
# look for, and it has no sandbox slot to leak.
_NOT_WINDOWS = select({
    "@platforms//os:windows": ["@platforms//:incompatible"],
    "//conditions:default": [],
})

# The paths to scan are the files of the build itself, expanded from its label.
[dart_test(
    name = "reproducible_%s_%s_test" % (part, mode),
    size = "medium",
    args = ["$(rootpaths :repro_%s_%s)" % (part, mode)],
    data = [":repro_%s_%s" % (part, mode)],
    env_inherit = [
        "HOME",
        "USER",
    ],
    main = "test/verify_reproducible_outputs_test.dart",
    target_compatible_with = _NOT_WINDOWS,
    deps = [
        "@deps//:test",
        "@rules_flutter//tools/e2e_testing",
    ],
) for part, mode in _REPRO_BUILDS if part != "assets"]

[dart_test(
    name = "reproducible_notices_%s_test" % mode,
    size = "small",
    args = ["$(rootpaths :repro_assets_%s)" % mode],
    data = [":repro_assets_%s" % mode],
    main = "test/verify_reproducible_notices_test.dart",
    deps = [
        "@deps//:test",
        "@rules_flutter//tools/e2e_testing",
    ],
) for part, mode in _REPRO_BUILDS if part == "assets"]
