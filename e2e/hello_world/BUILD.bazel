# -- iOS app, signed for a physical device ------------------------------------
#
# Hand-assembled from the Tier-2 `_gen` rules rather than built by the Tier-1
# `flutter_ios_app` above. That is deliberate on both counts, and this
# workspace is the one place both tiers stand side by side for the same
# `flutter_application`: `:hello_world_ios` shows the convenience macro
# discovering `ios/Runner/` from `flutter create`, while the targets below show
# the composable path a user takes when the macro does not fit — a
# Bazel-generated runner, no `flutter create` output needed.
#
# Note the consequence: the device bundle is *not* `:hello_world_ios` plus a
# credential — it is a different runner. Verifying a device build here does
# not exercise `ios/Runner/`.

flutter_ios_framework_gen(
    name = "hello_world_ios_framework",
    application = ":hello_world_app",
)

flutter_ios_registrant_gen(
    name = "hello_world_ios_registrant",
    application = ":hello_world_app",
)

flutter_ios_engine(name = "hello_world_ios_engine")

flutter_ios_native_frameworks_gen(
    name = "hello_world_ios_native_frameworks",
    application = ":hello_world_app",
)

flutter_ios_info_plist_gen(
    name = "hello_world_ios_runner_info_plist",
    app_name = "Hello World",
    module_name = "BazelRunner",
)

flutter_ios_runner_lib_gen(
    name = "hello_world_ios_runner_lib",
    application = ":hello_world_app",
    engine = ":hello_world_ios_engine",
    module_name = "BazelRunner",
    registrant = ":hello_world_ios_registrant",
)

apple_bundle_version(
    name = "hello_world_ios_version",
    build_version = "1.0",
    short_version_string = "1.0",
    tags = ["manual"],
)

# Signed with the developer's own profile, which is not in this repository:
# `//:device_profile` is a flag whose default fails with the setup steps (copy
# device.example/ to the git-ignored device/, then set
# `--//:device_profile=//device:profile` in .bazelrc.user). The flag keeps
# `bazel query 'deps(//...)'` from following a label into the //device package
# a fresh clone lacks. The target is `manual`, so `bazel build //...` skips it.
device_profile()

ios_application(
    name = "hello_world_ios_device",
    bundle_id = "com.example.helloworld",
    families = ["iphone"],
    infoplists = [":hello_world_ios_runner_info_plist"],
    launch_storyboard = IOS_DEFAULT_LAUNCH_STORYBOARD,
    minimum_os_version = IOS_MINIMUM_OS_VERSION,
    provisioning_profile = ":device_profile",
    tags = ["manual"],
    version = ":hello_world_ios_version",
    deps = [
        ":hello_world_ios_framework",
        # Native-asset frameworks. Declared above but easy to leave unwired:
        # the app still builds and renders, then fails every native-asset call
        # at runtime because dyld cannot resolve the framework-relative path
        # the manifest records.
        ":hello_world_ios_native_frameworks",
        ":hello_world_ios_runner_lib",
    ],
)

