load("@rules_dart//dart:defs.bzl", "dart_binary", "dart_test")

# The test VMs, on overhead's VM tooling (`@overhead//vm`): what is particular
# to rules_flutter is here, and creating, reaching and running on a VM is
# overhead's. docs/TESTING.md drives them.
#
#   bazel run //tools/vm:create_linux_vm -- <vm-name>
#   bazel run //tools/vm:create_windows_vm -- <vm-name>
#   bazel run //tools/vm:run_e2e -- <vm-name> [--windows] [--folders=a,b]
#   bazel run //tools/vm:deploy_bundle -- <vm-name> <bundle_path> [--windows]
#
# `//tools/ci_matrix:e2e_matrix.dart` is imported by relative path, as the
# workflow's plan job runs it with plain `dart run`.

_VM_DEPS = ["@overhead//vm"]

dart_binary(
    name = "create_linux_vm",
    srcs = ["hermetic_dart.dart"],
    main = "create_linux_vm.dart",
    deps = _VM_DEPS,
)

dart_binary(
    name = "create_windows_vm",
    srcs = [
        "hermetic_dart.dart",
        "vm_constants.dart",
    ],
    main = "create_windows_vm.dart",
    deps = _VM_DEPS,
)

dart_binary(
    name = "run_e2e",
    srcs = [
        "e2e_items.dart",
        "//tools/ci_matrix:e2e_matrix.dart",
    ],
    main = "run_e2e.dart",
    deps = _VM_DEPS,
)

dart_binary(
    name = "deploy_bundle",
    srcs = ["vm_constants.dart"],
    main = "deploy_bundle.dart",
    deps = _VM_DEPS,
)

dart_test(
    name = "vm_test",
    size = "small",
    srcs = [
        "create_linux_vm.dart",
        "create_windows_vm.dart",
        "e2e_items.dart",
        "hermetic_dart.dart",
        "vm_constants.dart",
        "//tools/ci_matrix:e2e_matrix.dart",
    ],
    main = "test/vm_test.dart",
    deps = _VM_DEPS + ["@dev_tool_deps//:test"],
)
