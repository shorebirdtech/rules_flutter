load("@rules_dart//dart:defs.bzl", "dart_binary", "dart_test")

# Checks that every e2e workspace's MODULE.bazel.lock is complete, running
# `bazel mod deps` and `bazel build --nobuild //...` in each with
# `--lockfile_mode=error` and without its gitignored `.bazelrc.user`.
#   bazel run //tools/lockfile_check                          every workspace
#   bazel run //tools/lockfile_check -- --refresh e2e/smoke   regenerate one lock
dart_binary(
    name = "lockfile_check",
    srcs = [
        "lockfile_check.dart",
        "//tools/e2e_workspaces:e2e_workspaces.dart",
    ],
    main = "check_lockfiles.dart",
)

dart_test(
    name = "lockfile_check_test",
    size = "small",
    srcs = ["lockfile_check.dart"],
    main = "test/lockfile_check_test.dart",
    deps = ["@dev_tool_deps//:test"],
)

# The root Maven lock, which every consumer of rules_flutter gets, keeps
# androidx.lifecycle at one version. See root_lock_test.dart.
dart_test(
    name = "root_lock_test",
    size = "small",
    data = ["//:rules_android_maven_install.json"],
    env = {
        "ROOT_LOCK": "$(rlocationpath //:rules_android_maven_install.json)",
        "RUNFILES_SOURCE_REPO": "",
    },
    main = "test/root_lock_test.dart",
    deps = [
        "@dev_tool_deps//:test",
        "@rules_dart//dart/runfiles",
    ],
)
