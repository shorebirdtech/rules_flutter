"""Regenerates the bazelrc preset the root `.bazelrc` imports.

A workspace of its own, not a package of rules_flutter: `bazelrc_preset` needs
a repo only development has, and REPO.bazel keeps this directory out of the
packages a consumer of rules_flutter sees.

    cd tools/preset && bazel run //:preset.update
"""

module(name = "rules_flutter_preset")

bazel_dep(name = "bazelrc-preset.bzl", version = "1.9.2")
