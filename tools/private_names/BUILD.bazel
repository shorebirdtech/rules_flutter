load("@rules_dart//dart:defs.bzl", "dart_binary", "dart_test")

# Keeps the names of private projects out of this public repository. The names
# are read from the file `git config rulesflutter.privateNamesFile` points at,
# so they are not published here. Without that config it checks nothing and
# says so.
#   -- --message <file>   from the commit-msg hook
#   -- --staged           from the pre-commit hook
#   -- --tree             whole tracked tree, for release readiness
dart_binary(
    name = "check",
    srcs = ["private_names.dart"],
    main = "check_private_names.dart",
)

dart_test(
    name = "private_names_test",
    size = "small",
    srcs = ["private_names.dart"],
    main = "test/private_names_test.dart",
    deps = ["@dev_tool_deps//:test"],
)
