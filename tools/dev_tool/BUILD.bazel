dart_binary(
    name = "flutter_bazel",
    srcs = glob(["lib/**/*.dart"]),
    compile_mode = "exe",
    # The desktop screen-capture helpers are local to their OS.
    data = select({
        # Every `bazel` command starts through it, off Windows. See its target.
        "@platforms//os:windows": [],
        "//conditions:default": [":process_group_exec"],
    }) + select({
        "@platforms//os:macos": [
            "//tools/macos_screenshot:screenshot",
        ],
        "@platforms//os:windows": [
            "//tools/windows_screenshot:screenshot",
        ],
        "//conditions:default": [],
    }),
    defines = ["RUNFILES_SOURCE_REPO=" + SOURCE_REPO],
    main = "bin/flutter_bazel.dart",
    visibility = ["//visibility:public"],
    deps = _LIB_DEPS,
)

# The host side of the integration test rules (`flutter/integration_test.bzl`):
# the executable of each `flutter_*_integration_test`. It lives in the dev tool
# because it launches apps on devices with the dev tool's `Device` layer. A
# separate program from `flutter_bazel` because it starts as a test, with
# nothing to parse and no Bazel to drive.
dart_binary(
    name = "integration_test_runner",
    srcs = glob(["lib/**/*.dart"]),
    compile_mode = "exe",
    defines = ["RUNFILES_SOURCE_REPO=" + SOURCE_REPO],
    main = "bin/integration_test_runner.dart",
    visibility = ["//visibility:public"],
    deps = _LIB_DEPS,
)

# Starts a program as the leader of a new process group, so that stopping a
# `bazel` command the dev tool started reaches the real Bazel client and not
# only the bazelisk in front of it. The why is in the source.
#
# Its own binary rather than a mode of `flutter_bazel`: it is exec'd once per
# bazel command, and the whole of it is two system calls — it has no use for
# the dev tool's library, its runfiles or its startup.
#
# Not on Windows, which has no process group a console process can be moved
# into; the dev tool starts `bazel` directly there.
dart_binary(
    name = "process_group_exec",
    compile_mode = "exe",
    main = "bin/process_group_exec.dart",
    target_compatible_with = select({
        "@platforms//os:windows": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
)

# Stand-in for `adb` in `dev_tool_e2e_harness_test`. A compiled executable, since
