load("@rules_dart//dart:defs.bzl", "dart_library", "dart_package_metadata")

dart_package_metadata(
    name = "pubspec-metadata",
    package_name = "rules_flutter_macos_gui_session",
)

# Whether a macOS desktop session can show a window, kept awake for a run, and
# why not when it cannot. A shipped library: the integration test runner checks
# it before launching an app, and `//tools/e2e_testing` re-exports it for the e2e
# workspaces' tests, which are not shipped.
dart_library(
    name = "macos_gui_session",
    srcs = glob(["lib/**/*.dart"]),
    package = ":pubspec-metadata",
    # Public because `flutter_pub.from_lock(resolve = ...)` in MODULE.bazel maps
    # the dev tool's lock entry for this package to it, and the hub's repository
    # aliases it from outside this repository's packages.
    visibility = ["//visibility:public"],
)
